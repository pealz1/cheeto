{
  "name": "cheeto-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation site for Cheeto",
  "scripts": {
    "prebuild": "node scripts/check-reference.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "pagefind --site .next/server/app --output-path out/_pagefind && node scripts/check-links.mjs",
    "start": "npx serve out",
    "postinstall": "patch-package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pealz1/cheeto.git",
    "directory": "docs"
  },
  "license": "MIT",
  "dependencies": {
    "next": "^16.4.6",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.1",
    "pagefind": "^1.6.0",
    "typescript": "^6.0.3",
    "patch-package": "^8.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "zod": "^4.6.7",
    "katex": "^0.19.1",
    "@ts-morph/common": {
      "minimatch": "^11.0.9"
    }
  }
}
