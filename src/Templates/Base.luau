local function RunStateFlushers()
    for _, Callback in RuntimeState.StateFlushers do
        local Success, Error = pcall(Callback)
        if not Success then
            MetricAdd("HookErrors", "StateFlusher")
            warn(`[Cheeto]: State channel flusher failed: {Error}`)
        end
    end
end

