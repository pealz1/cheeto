local function CloneBuffer(Source: buffer?, Start: number?, Size: number?): buffer?
    if Source == nil then
        return nil
    end

    local Offset = Start or 0
    local Length = Size or (buffer.len(Source) - Offset)
    local Target = buffer.create(Length)
    buffer.copy(Target, 0, Source, Offset, Length)
    return Target
end

local function CloneArray(Source: {any}?): {any}?
    if Source == nil then
        return nil
    end

    -- selene: allow(manual_table_clone)
    --> NOT table.clone: it carries the source's metatable over to the copy and
    --> this loop does not. The suite was too flaky to prove behaviour either way
    --> (see the intermittent hang below), so the safe semantics stay.
    local Result = {}
    for Index, Value in Source do
        Result[Index] = Value
    end
    return Result
end

function RuntimeSupport.SetCaptureRedactions(Redactions: any)
    table.clear(RuntimeState.Capture.Redactions)

    if Redactions == nil or Redactions == "" then
        return
    end

    if type(Redactions) == "string" then
        for _, Field in string.split(Redactions, ",") do
            Field = string.gsub(Field, "^%s+", "")
            Field = string.gsub(Field, "%s+$", "")
            if Field ~= "" then
                RuntimeState.Capture.Redactions[Field] = true
            end
        end
        return
    end

    for _, Field in Redactions do
        RuntimeState.Capture.Redactions[tostring(Field)] = true
    end
end

RuntimeSupport.SetCaptureRedactions(RuntimeConfig.CaptureRedactions)

local function MetricAdd(BucketName: string, Key: string, Amount: number?)
    local Bucket = Metrics[BucketName]
    Bucket[Key] = (Bucket[Key] or 0) + (Amount or 1)
end

function RuntimeSupport.PeerKey(Source: any): any
    --> Client code historically used both nil and the descriptive "Server"
    --> sentinel for its one remote peer. Normalize them here so queueing,
    --> flushing, fragmentation, handshakes, and diagnostics all share state.
    if Source == nil or Source == "Server" then
        return SERVER_PEER_KEY
    end

    return Source
end

function RuntimeSupport.SummarizeValue(Value: any, Depth: number?): string
    local Depth = Depth or 0
    local Kind = typeof(Value)
    if Kind == "buffer" then
        return `buffer({buffer.len(Value)})`
    elseif Kind == "Instance" then
        return tostring(Value)
    elseif Kind ~= "table" then
        return tostring(Value)
    end

    if Depth >= 2 then
        return "{...}"
    end

    local Parts = {}
    local Count = 0
    for Key, Child in Value do
        if Key == "n" then
            continue
        end

        Count += 1
        if Count > 8 then
            table.insert(Parts, "...")
            break
        end

        local KeyText = tostring(Key)
        local ChildText = if RuntimeState.Capture.Redactions[KeyText] then "[redacted]" else RuntimeSupport.SummarizeValue(Child, Depth + 1)
        table.insert(Parts, `{KeyText}={ChildText}`)
    end

    table.sort(Parts)
    return `{Kind}({table.concat(Parts, ",")})`
end

function RuntimeSupport.RecordCapture(Entry: {[string]: any})
    if not RuntimeState.Capture.Enabled and not RuntimeConfig.EnablePacketCapture and not RuntimeState.Inspector.Enabled and not RuntimeConfig.EnableInspector then
        return
    end

    local KeepRaw = not (RuntimeConfig.NoRawCaptureInProduction and RuntimeConfig.SecurityProfile ~= "Development")
    if KeepRaw and Entry.RawBuffer ~= nil then
        Entry.Buffer = CloneBuffer(Entry.RawBuffer, Entry.RawBufferStart, Entry.RawBufferSize)
        Entry.RawBuffer = nil
        Entry.RawBufferStart = nil
        Entry.RawBufferSize = nil
    elseif Entry.RawBuffer ~= nil then
        Entry.RawBuffer = nil
        Entry.RawBufferStart = nil
        Entry.RawBufferSize = nil
        Entry.RawRedacted = true
    end
    if KeepRaw and Entry.RawInstances ~= nil then
        Entry.Instances = CloneArray(Entry.RawInstances)
        Entry.RawInstances = nil
    elseif Entry.RawInstances ~= nil then
        Entry.RawInstances = nil
    end

    Entry.Time = os.clock()
    Entry.ProtocolVersion = PROTOCOL_VERSION
    Entry.SchemaVersion = RuntimeConfig.SchemaVersion
    Entry.SchemaHash = RuntimeConfig.SchemaHash
    Entry.Redaction = {
        Raw = not KeepRaw,
        Fields = table.clone(RuntimeState.Capture.Redactions)
    }
    if Entry.Payload ~= nil then
        Entry.PayloadSummary = RuntimeSupport.SummarizeValue(Entry.Payload)
        Entry.Payload = nil
    end

    table.insert(RuntimeState.Capture.Entries, Entry)
    local Limit = RuntimeState.Capture.Limit or RuntimeConfig.CaptureLimit
    while #RuntimeState.Capture.Entries > Limit do
        table.remove(RuntimeState.Capture.Entries, 1)
    end
end

function RuntimeSupport.StartCapture(Options: {[string]: any}?)
    RuntimeState.Capture.Enabled = true
    if Options then
        if Options.Limit then
            RuntimeState.Capture.Limit = Options.Limit
        end
        if Options.Redactions then
            RuntimeSupport.SetCaptureRedactions(Options.Redactions)
        end
    end
end

function RuntimeSupport.StopCapture()
    RuntimeState.Capture.Enabled = false
end

function RuntimeSupport.ClearCapture()
    table.clear(RuntimeState.Capture.Entries)
end

function RuntimeSupport.CaptureEntries()
    return table.clone(RuntimeState.Capture.Entries)
end

function RuntimeSupport.ReplayCapture(Entries: {{[string]: any}}, Handlers: {[string]: (any) -> any}?)
    local Result = {
        Accepted = 0,
        Dropped = 0,
        Replayed = 0
    }

    for _, Entry in Entries do
        if Entry.Status == "dropped" then
            Result.Dropped += 1
            continue
        end

        Result.Accepted += 1
        local Handler = Handlers and Handlers[Entry.Name]
        if Handler then
            Handler(Entry)
            Result.Replayed += 1
        end
    end

    return Result
end

function RuntimeSupport.ReplayRawCapture(Entries: {{[string]: any}}, Injector: (({[string]: any}, buffer, {any}?) -> ())?)
    local Result = {
        Accepted = 0,
        Dropped = 0,
        Replayed = 0,
        MissingRaw = 0
    }

    for _, Entry in Entries do
        if Entry.Status == "dropped" then
            Result.Dropped += 1
        else
            Result.Accepted += 1
        end

        local RawBuffer = Entry.Buffer or Entry.RawBuffer
        if typeof(RawBuffer) ~= "buffer" then
            Result.MissingRaw += 1
            continue
        end

        if Injector then
            Injector(Entry, RawBuffer, Entry.Instances or Entry.RawInstances)
            Result.Replayed += 1
        end
    end

    return Result
end

local function RunHooks(Name: string, Payload: any): boolean
    if not RuntimeConfig.EnableMiddleware then
        return true
    end

    local List = Hooks[Name]
    if not List or #List == 0 then
        return true
    end

    for _, Hook in List do
        local Success, Result = pcall(Hook, Payload)
        if not Success then
            MetricAdd("HookErrors", Name)
            warn(`[Cheeto]: {Name} middleware failed: {Result}`)
        elseif Result == false then
            MetricAdd("MiddlewareRejections", Name)
            return false
        end
    end

    return true
end

local function ProfileBegin(Name: string)
    if not RuntimeConfig.EnableMicroProfiler then
        return
    end

    local Debug = debug
    if Debug and Debug.profilebegin then
        local Success = pcall(Debug.profilebegin, Name)
        if Success then
            local Thread = coroutine.running() or RuntimeState.Profile.MainThread
            RuntimeState.Profile.Depth[Thread] = (RuntimeState.Profile.Depth[Thread] or 0) + 1
        end
    end
end

local function ProfileEnd()
    if not RuntimeConfig.EnableMicroProfiler then
        return
    end

    local Thread = coroutine.running() or RuntimeState.Profile.MainThread
    local Depth = RuntimeState.Profile.Depth[Thread] or 0
    if Depth <= 0 then
        return
    end

    local Debug = debug
    if Debug and Debug.profileend and pcall(Debug.profileend) then
        if Depth == 1 then
            RuntimeState.Profile.Depth[Thread] = nil
        else
            RuntimeState.Profile.Depth[Thread] = Depth - 1
        end
    end
end

local function EmitTelemetry(Name: string, Payload: any)
    RunHooks("Telemetry", {
        Name = Name,
        Payload = Payload,
        Time = os.clock()
    })
end

local function AbuseKey(Source: any): any
    return RuntimeSupport.PeerKey(Source)
end

local function AddAbuse(Source: any, Name: string, Amount: number?): number
    local Key = AbuseKey(Source)
    local ByName = RuntimeState.Abuse[Key]
    if ByName == nil then
        ByName = {}
        RuntimeState.Abuse[Key] = ByName
    end

    local Score = (ByName[Name] or 0) + (Amount or 1)
    ByName[Name] = Score
    return Score
end

local function ReportViolation(Source: any, Name: string, Channel: string, Reason: string, Size: number?, Action: string?): number
    local Score = AddAbuse(Source, Name, 1)
    local Payload = {
        Reason = Reason,
        Player = Source,
        Event = Name,
        Channel = Channel,
        Score = Score,
        Action = Action or "drop",
        PayloadSize = Size or 0,
        Time = os.clock()
    }

    RunHooks("Violation", Payload)
    EmitTelemetry("security.violation", Payload)
    return Score
end

local function DropPacket(Source: any, Channel: string, Reason: string, Size: number?, Name: string?)
    MetricAdd("DroppedPackets", Reason)
    if Reason == "RateLimit" then
        MetricAdd("RateLimitHits", Channel)
    elseif Reason == "QueueFull" then
        MetricAdd("QueueDrops", Channel)
    elseif Reason == "ValidationFailure" or Reason == "MalformedPacket" then
        MetricAdd("ValidationFailures", Channel)
    elseif Reason == "MiddlewareRejected" then
        MetricAdd("MiddlewareRejections", Channel)
    elseif Reason == "AuthRejected" then
        MetricAdd("ValidationFailures", Channel)
    end

    RuntimeSupport.RecordCapture({
        Name = Name,
        Direction = "receive",
        Source = tostring(Source),
        Channel = Channel,
        Status = "dropped",
        Reason = Reason,
        Size = Size or 0,
        RawBuffer = if typeof(RecieveBuffer) == "buffer" then RecieveBuffer else nil,
        RawInstances = State.RecieveInstances
    })

    RunHooks("Drop", {
        Name = Name,
        Source = Source,
        Channel = Channel,
        Reason = Reason,
        Size = Size or 0
    })
    ReportViolation(Source, Name or Channel, Channel, Reason, Size, "drop")
end

function RuntimeSupport.CreateRemoteName(Prefix: string?): string
    local Token = tostring(math.random(100000000, 999999999))
    local Success, Guid = pcall(function()
        local HttpService = game:GetService("HttpService")
        return HttpService:GenerateGUID(false)
    end)

    if Success and type(Guid) == "string" then
        local Clean = string.gsub(Guid, "-", "")
        Token = string.sub(Clean, 1, 18)
    end

    local SafePrefix = string.gsub(tostring(Prefix or "R"), "[^%w_]", "")
    if SafePrefix == "" then
        SafePrefix = "R"
    end

    return `_CHEETO_{SafePrefix}_{Token}`
end

local function ShouldThrottleClientShield(Source: any, Reason: string): boolean
    local Cooldown = RuntimeConfig.ClientShieldReportCooldownSeconds
    if Cooldown <= 0 then
        return false
    end

    local Key = RuntimeSupport.PeerKey(Source)
    local ByReason = RuntimeState.ClientShield.LastReport[Key]
    if ByReason == nil then
        ByReason = {}
        RuntimeState.ClientShield.LastReport[Key] = ByReason
    end

    local Now = os.clock()
    local Last = ByReason[Reason]
    if Last ~= nil and Now - Last < Cooldown then
        return true
    end

    ByReason[Reason] = Now
    return false
end

local function KickClientShieldSource(Source: any)
    if typeof(Source) ~= "Instance" then
        return
    end

    pcall(function()
        if Source:IsA("Player") then
            Source:Kick(RuntimeConfig.ClientShieldKickMessage)
        end
    end)
end

function RuntimeSupport.ReportClientShield(
    Source: any,
    Reason: string,
    Detail: string?,
    Score: number?,
    ImmediateKick: boolean?
)
    Reason = if Reason == nil or Reason == "" then TransportError.ClientShield else Reason
    local Weight = math.max(1, math.floor(Score or 1))
    local SpecificScore = AddAbuse(Source, Reason, Weight)
    local ShouldKick = RuntimeConfig.ClientShieldKick
        and (ImmediateKick == true or RuntimeConfig.ClientShieldStrict or SpecificScore >= RuntimeConfig.ClientShieldScoreThreshold)

    if not ShouldThrottleClientShield(Source, Reason) then
        local Entry = {
            Source = Source,
            UserId = TryGetUserId(Source),
            Reason = Reason,
            Detail = Detail or "",
            Score = SpecificScore,
            Weight = Weight,
            Action = if ShouldKick then "kick" else "report",
            Time = os.clock()
        }

        table.insert(RuntimeState.ClientShield.Reports, Entry)
        while #RuntimeState.ClientShield.Reports > 256 do
            table.remove(RuntimeState.ClientShield.Reports, 1)
        end

        MetricAdd("ClientShieldReports", Reason)
        ReportViolation(Source, "$clientShield", "ClientShield", Reason, Weight, Entry.Action)
        EmitTelemetry("security.clientShield", Entry)
    end

    if ShouldKick then
        KickClientShieldSource(Source)
    end

    return SpecificScore
end

function RuntimeSupport.ClientShieldSnapshot()
    local Reports = {}
    for Index, Entry in RuntimeState.ClientShield.Reports do
        Reports[Index] = table.clone(Entry)
    end

    return {
        Reports = Reports,
        Enabled = RuntimeConfig.EnableClientShield,
        Strict = RuntimeConfig.ClientShieldStrict,
        Kick = RuntimeConfig.ClientShieldKick,
        ScoreThreshold = RuntimeConfig.ClientShieldScoreThreshold
    }
end

function RuntimeSupport.IntegrityInteger(Value: any): number
    if type(Value) ~= "number" or Value ~= Value or math.abs(Value) == math.huge then
        return 0
    end

    return math.floor(math.abs(Value)) % 2147483647
end

--> This is a completion receipt, not a secret. It makes truncated, stale and
--> accidentally malformed replies distinguishable while the one-time pending
--> challenge supplies replay protection on the server.
function RuntimeSupport.ClientIntegrityChecksum(
    ChallengeId: number,
    Nonce: number,
    Completion: number,
    Sweep: number,
    SamplerCount: number,
    Healthy: boolean
): number
    local Value = 104729
    for _, Part in {
        ChallengeId,
        Nonce,
        Completion,
        Sweep,
        SamplerCount,
        if Healthy then 1 else 0,
        PROTOCOL_VERSION,
        RuntimeConfig.SchemaVersion,
    } do
        Value = (Value * 48271 + RuntimeSupport.IntegrityInteger(Part) * 69621 + 31) % 2147483647
    end
    return math.floor(Value)
end

function RuntimeSupport.GetClientIntegrityPeer(Source: any): any
    local Key = RuntimeSupport.PeerKey(Source)
    local Peer = RuntimeState.ClientShield.Integrity.Peers[Key]
    if Peer ~= nil then
        Peer.Source = Source
        return Peer
    end

    local Now = os.clock()
    Peer = {
        Source = Source,
        NextChallengeId = 0,
        Pending = nil,
        NextChallengeAt = Now + math.max(0, RuntimeConfig.ClientIntegrityJoinGraceSeconds),
        GraceUntil = Now + math.max(0, RuntimeConfig.ClientIntegrityJoinGraceSeconds),
        LastDecayAt = Now,
        LastReceiptAt = 0,
        LastCompletion = 0,
        LastSweep = 0,
        Score = 0,
        ChallengesIssued = 0,
        ValidReceipts = 0,
        ConsecutiveFailures = 0,
        ConsecutiveMisses = 0,
        LastReason = "",
        LastAction = "none",
    }
    RuntimeState.ClientShield.Integrity.Peers[Key] = Peer
    return Peer
end

function RuntimeSupport.DecayClientIntegrityPeer(Peer: any, Now: number)
    local Delta = math.max(0, Now - (Peer.LastDecayAt or Now))
    Peer.LastDecayAt = Now
    Peer.Score = math.max(0, (Peer.Score or 0) - Delta * math.max(0, RuntimeConfig.ClientIntegrityScoreDecayPerSecond))
end

function RuntimeSupport.RecordClientIntegrityEvidence(Source: any, Peer: any, Reason: string, Detail: string, Weight: number)
    local Now = os.clock()
    RuntimeSupport.DecayClientIntegrityPeer(Peer, Now)
    Weight = math.max(1, math.floor(Weight))
    Peer.Score = math.min(1000, Peer.Score + Weight)
    Peer.LastReason = Reason

    local FailureLimit = math.max(1, math.floor(RuntimeConfig.ClientIntegrityMaxConsecutiveFailures))
    local ShouldKick = RuntimeConfig.ClientShieldKick
        and Peer.Score >= RuntimeConfig.ClientIntegrityScoreThreshold
        and Peer.ConsecutiveFailures >= FailureLimit
    Peer.LastAction = if ShouldKick then "kick" else "report"

    local Key = RuntimeSupport.PeerKey(Source)
    local ByReason = RuntimeState.ClientShield.Integrity.LastEvidence[Key]
    if ByReason == nil then
        ByReason = {}
        RuntimeState.ClientShield.Integrity.LastEvidence[Key] = ByReason
    end
    local Last = ByReason[Reason]
    local Throttled = Last ~= nil and Now - Last < math.max(0, RuntimeConfig.ClientShieldReportCooldownSeconds)
    if not Throttled or ShouldKick then
        ByReason[Reason] = Now
        local Entry = {
            Source = Source,
            UserId = TryGetUserId(Source),
            Reason = Reason,
            Detail = Detail,
            Weight = Weight,
            Score = Peer.Score,
            ConsecutiveFailures = Peer.ConsecutiveFailures,
            ConsecutiveMisses = Peer.ConsecutiveMisses,
            Action = Peer.LastAction,
            Time = Now,
        }
        table.insert(RuntimeState.ClientShield.Integrity.Evidence, Entry)
        while #RuntimeState.ClientShield.Integrity.Evidence > 256 do
            table.remove(RuntimeState.ClientShield.Integrity.Evidence, 1)
        end

        MetricAdd("ClientIntegrityFailures", Reason)
        ReportViolation(Source, "$clientIntegrity", "ClientIntegrity", Reason, Weight, Peer.LastAction)
        EmitTelemetry("security.clientIntegrity", Entry)
    end

    if ShouldKick then
        KickClientShieldSource(Source)
    end
end

function RuntimeSupport.CreateClientIntegrityChallenge(Source: any, Force: boolean?): (number?, number?)
    if not RuntimeConfig.EnableClientIntegrity or not IsPlayerActive(Source) then
        return nil, nil
    end

    local Peer = RuntimeSupport.GetClientIntegrityPeer(Source)
    local Now = os.clock()
    RuntimeSupport.DecayClientIntegrityPeer(Peer, Now)
    if Now < Peer.GraceUntil then
        return nil, nil
    end
    if Peer.Pending ~= nil and Force ~= true then
        return nil, nil
    end

    Peer.NextChallengeId = (Peer.NextChallengeId + 1) % 2147483647
    if Peer.NextChallengeId == 0 then
        Peer.NextChallengeId = 1
    end
    local Nonce = (math.random(1, 1073741823) + math.floor(Now * 1000000)) % 2147483647
    if Nonce == 0 then
        Nonce = 1
    end

    Peer.Pending = {
        Id = Peer.NextChallengeId,
        Nonce = Nonce,
        IssuedAt = Now,
        Deadline = Now + math.max(0.5, RuntimeConfig.ClientIntegrityReceiptTimeoutSeconds),
    }
    Peer.NextChallengeAt = Now + math.max(0.5, RuntimeConfig.ClientIntegrityChallengeIntervalSeconds)
    Peer.ChallengesIssued += 1
    return Peer.Pending.Id, Peer.Pending.Nonce
end

function RuntimeSupport.AcceptClientIntegrityReceipt(
    Source: any,
    ChallengeId: number,
    Nonce: number,
    Completion: number,
    Sweep: number,
    SamplerCount: number,
    Healthy: boolean,
    Checksum: number
): boolean
    if not RuntimeConfig.EnableClientIntegrity or Source == SERVER_PEER_KEY or Source == "Server" then
        return false
    end

    local Peer = RuntimeSupport.GetClientIntegrityPeer(Source)
    local Now = os.clock()
    RuntimeSupport.DecayClientIntegrityPeer(Peer, Now)
    local Pending = Peer.Pending
    local Reason = nil
    if Pending == nil then
        Reason = "unexpected-receipt"
    elseif ChallengeId ~= Pending.Id or Nonce ~= Pending.Nonce then
        Reason = "challenge-mismatch"
    elseif Now > Pending.Deadline then
        Reason = "expired-receipt"
    elseif Completion <= Peer.LastCompletion then
        Reason = "replayed-completion"
    elseif SamplerCount < 1 then
        Reason = "empty-sample"
    elseif Checksum ~= RuntimeSupport.ClientIntegrityChecksum(ChallengeId, Nonce, Completion, Sweep, SamplerCount, Healthy) then
        Reason = "checksum-mismatch"
    end

    if Reason ~= nil then
        Peer.Pending = nil
        Peer.ConsecutiveFailures += 1
        Peer.ConsecutiveMisses = 0
        RuntimeSupport.RecordClientIntegrityEvidence(
            Source,
            Peer,
            TransportError.IntegrityReceiptInvalid,
            Reason,
            RuntimeConfig.ClientIntegrityInvalidWeight
        )
        return false
    end

    Peer.Pending = nil
    Peer.LastReceiptAt = Now
    Peer.LastCompletion = Completion
    Peer.LastSweep = Sweep
    Peer.ValidReceipts += 1
    MetricAdd("ClientIntegrityReceipts", "Valid")

    if not Healthy then
        Peer.ConsecutiveFailures += 1
        Peer.ConsecutiveMisses = 0
        RuntimeSupport.RecordClientIntegrityEvidence(
            Source,
            Peer,
            TransportError.IntegrityEvaluatorFailed,
            `challenge:{ChallengeId}`,
            RuntimeConfig.ClientIntegrityInvalidWeight
        )
        return false
    end

    Peer.ConsecutiveFailures = 0
    Peer.ConsecutiveMisses = 0
    Peer.Score = math.max(0, Peer.Score - math.max(0, RuntimeConfig.ClientIntegrityCleanReceiptDecay))
    Peer.LastReason = ""
    Peer.LastAction = "accept"
    return true
end

function RuntimeSupport.GrantClientIntegrityGrace(Source: any, Seconds: number?, Reason: string?)
    local Peer = RuntimeSupport.GetClientIntegrityPeer(Source)
    local Now = os.clock()
    local Duration = math.max(0, Seconds or RuntimeConfig.ClientIntegrityJoinGraceSeconds)
    Peer.GraceUntil = math.max(Peer.GraceUntil, Now + Duration)
    Peer.NextChallengeAt = math.max(Peer.NextChallengeAt, Peer.GraceUntil)
    Peer.Pending = nil
    Peer.LastReason = Reason or "grace"
end

function RuntimeSupport.CopyClientIntegrityPeer(Peer: any): any
    if Peer == nil then
        return nil
    end

    return {
        UserId = TryGetUserId(Peer.Source),
        Score = Peer.Score,
        PendingChallenge = if Peer.Pending then Peer.Pending.Id else nil,
        PendingDeadline = if Peer.Pending then Peer.Pending.Deadline else nil,
        NextChallengeAt = Peer.NextChallengeAt,
        GraceUntil = Peer.GraceUntil,
        LastReceiptAt = Peer.LastReceiptAt,
        LastCompletion = Peer.LastCompletion,
        LastSweep = Peer.LastSweep,
        ChallengesIssued = Peer.ChallengesIssued,
        ValidReceipts = Peer.ValidReceipts,
        ConsecutiveFailures = Peer.ConsecutiveFailures,
        ConsecutiveMisses = Peer.ConsecutiveMisses,
        LastReason = Peer.LastReason,
        LastAction = Peer.LastAction,
    }
end

function RuntimeSupport.ClientIntegritySnapshot(Source: any?): any
    local Local = RuntimeState.ClientShield.Local
    if Source ~= nil then
        return RuntimeSupport.CopyClientIntegrityPeer(RuntimeState.ClientShield.Integrity.Peers[RuntimeSupport.PeerKey(Source)])
    end

    local Peers = {}
    for Key, Peer in RuntimeState.ClientShield.Integrity.Peers do
        Peers[tostring(Key)] = RuntimeSupport.CopyClientIntegrityPeer(Peer)
    end
    return {
        Enabled = RuntimeConfig.EnableClientIntegrity,
        Peers = Peers,
        Evidence = table.clone(RuntimeState.ClientShield.Integrity.Evidence),
        Local = {
            MonitorRunning = Local.MonitorRunning,
            PendingChallenge = if Local.MonitorPending then Local.MonitorPending.Id else nil,
            Completion = Local.Completion,
            LastChallenge = Local.LastChallenge,
            LastReceipt = Local.LastReceipt,
            SamplerCount = #Local.Samplers + 1,
        },
    }
end

function RuntimeSupport.StepClientIntegrity(Sources: {any}, QueueChallenge: (any, number, number) -> ())
    if not RuntimeConfig.EnableClientIntegrity then
        return
    end

    local Now = os.clock()
    for _, Source in Sources do
        if not IsPlayerActive(Source) then
            continue
        end

        local Peer = RuntimeSupport.GetClientIntegrityPeer(Source)
        RuntimeSupport.DecayClientIntegrityPeer(Peer, Now)
        if Now < Peer.GraceUntil then
            if Peer.Pending ~= nil then
                Peer.Pending = nil
            end
            continue
        end

        if Peer.Pending ~= nil and Now > Peer.Pending.Deadline then
            local MissedId = Peer.Pending.Id
            Peer.Pending = nil
            Peer.ConsecutiveMisses += 1
            Peer.ConsecutiveFailures += 1
            RuntimeSupport.RecordClientIntegrityEvidence(
                Source,
                Peer,
                TransportError.IntegrityReceiptMissing,
                `challenge:{MissedId}`,
                RuntimeConfig.ClientIntegrityMissWeight
            )
        end

        if Peer.Pending == nil and Now >= Peer.NextChallengeAt then
            local ChallengeId, Nonce = RuntimeSupport.CreateClientIntegrityChallenge(Source)
            if ChallengeId ~= nil and Nonce ~= nil then
                QueueChallenge(Source, ChallengeId, Nonce)
            end
        end
    end
end

function RuntimeSupport.FiniteNumber(Value: any): boolean
    return type(Value) == "number" and Value == Value and math.abs(Value) < math.huge
end

--> Pure movement classification used by the live server sampler and exposed for
--> deterministic tests. Client-reported position is never an input here.
function RuntimeSupport.EvaluateCharacterMovement(Sample: {[string]: any}): any
    local DeltaTime = Sample.DeltaTime
    local HorizontalDistance = Sample.HorizontalDistance
    local VerticalDistance = Sample.VerticalDistance
    local WalkSpeed = Sample.WalkSpeed or 0
    local HorizontalVelocity = Sample.HorizontalVelocity or 0
    local VerticalVelocity = Sample.VerticalVelocity or 0
    local Ping = Sample.Ping or 0

    for _, Value in { DeltaTime, HorizontalDistance, VerticalDistance, WalkSpeed, HorizontalVelocity, VerticalVelocity, Ping } do
        if not RuntimeSupport.FiniteNumber(Value) then
            return {
                Suspicious = true,
                Resync = false,
                Reasons = { "NonFiniteMovement" },
                Weight = 12,
                AllowedHorizontal = 0,
                AllowedVertical = 0,
            }
        end
    end

    if DeltaTime <= 0 or DeltaTime > math.max(0.1, RuntimeConfig.CharacterIntegrityMaxStepSeconds) then
        return {
            Suspicious = false,
            Resync = true,
            Reasons = {},
            Weight = 0,
            AllowedHorizontal = 0,
            AllowedVertical = 0,
        }
    end
    if Sample.Seated == true then
        return {
            Suspicious = false,
            Resync = false,
            Reasons = {},
            Weight = 0,
            AllowedHorizontal = math.huge,
            AllowedVertical = math.huge,
        }
    end

    local ConfiguredHorizontal = math.max(1, RuntimeConfig.CharacterIntegrityMaxHorizontalSpeed)
    local ConfiguredVertical = math.max(1, RuntimeConfig.CharacterIntegrityMaxVerticalSpeed)
    local SpeedMultiplier = math.max(1, RuntimeConfig.CharacterIntegritySpeedMultiplier)
    local Slack = math.max(0, RuntimeConfig.CharacterIntegrityDistanceSlack)
    local PingSeconds = math.clamp(Ping, 0, 2)
    local PingAllowance = math.max(0, RuntimeConfig.CharacterIntegrityPingAllowance)
    local NominalHorizontal = math.max(ConfiguredHorizontal, math.max(0, WalkSpeed) * SpeedMultiplier)
    local VelocityHorizontal = math.min(math.max(0, HorizontalVelocity), NominalHorizontal * 2)
    local VelocityVertical = math.min(math.abs(VerticalVelocity), ConfiguredVertical * 2)
    local AllowedHorizontal = NominalHorizontal * DeltaTime
        + VelocityHorizontal * DeltaTime * 0.5
        + Slack
        + PingSeconds * NominalHorizontal * PingAllowance
    local AllowedVertical = ConfiguredVertical * DeltaTime
        + VelocityVertical * DeltaTime * 0.5
        + Slack
        + PingSeconds * ConfiguredVertical * PingAllowance

    local Reasons = {}
    local Weight = 0
    if HorizontalDistance > AllowedHorizontal then
        table.insert(Reasons, "HorizontalDisplacement")
        Weight += math.clamp(math.floor(HorizontalDistance / math.max(1, AllowedHorizontal)), 2, 8)
    end
    if VerticalDistance > AllowedVertical then
        table.insert(Reasons, "VerticalDisplacement")
        Weight += math.clamp(math.floor(VerticalDistance / math.max(1, AllowedVertical)), 2, 8)
    end
    if WalkSpeed > ConfiguredHorizontal * SpeedMultiplier then
        table.insert(Reasons, "WalkSpeedMutation")
        Weight += 3
    end
    if Sample.PathBlocked == true and HorizontalDistance > math.max(4, Slack * 0.5) then
        table.insert(Reasons, "CollidableTraversal")
        Weight += 3
    end

    return {
        Suspicious = #Reasons > 0,
        Resync = false,
        Reasons = Reasons,
        Weight = math.max(0, math.min(16, Weight)),
        AllowedHorizontal = AllowedHorizontal,
        AllowedVertical = AllowedVertical,
    }
end

function RuntimeSupport.GetCharacterIntegrityPlayer(Player: any): any
    local Key = RuntimeSupport.PeerKey(Player)
    local PlayerState = RuntimeState.CharacterIntegrity.Players[Key]
    if PlayerState ~= nil then
        PlayerState.Player = Player
        return PlayerState
    end

    local Now = os.clock()
    PlayerState = {
        Player = Player,
        Character = nil,
        LastPosition = nil,
        LastSafeCFrame = nil,
        LastSampleAt = 0,
        NextSampleAt = Now,
        LastDecayAt = Now,
        GraceUntil = Now + math.max(0, RuntimeConfig.CharacterIntegrityJoinGraceSeconds),
        Score = 0,
        ConsecutiveBreaches = 0,
        LastCorrectionAt = 0,
        LastReason = "",
        LastAction = "none",
        Reasons = {} :: {[string]: number},
        History = {},
    }
    RuntimeState.CharacterIntegrity.Players[Key] = PlayerState
    return PlayerState
end

function RuntimeSupport.DecayCharacterIntegrityPlayer(PlayerState: any, Now: number)
    local Delta = math.max(0, Now - (PlayerState.LastDecayAt or Now))
    PlayerState.LastDecayAt = Now
    local Decay = Delta * math.max(0, RuntimeConfig.CharacterIntegrityScoreDecayPerSecond)
    PlayerState.Score = math.max(0, PlayerState.Score - Decay)
    if Decay > 0 then
        for Reason, Score in PlayerState.Reasons do
            local Next = math.max(0, Score - Decay)
            PlayerState.Reasons[Reason] = if Next > 0 then Next else nil
        end
    end
end

function RuntimeSupport.CharacterIntegrityAction(PlayerState: any): string
    local Mode = string.lower(tostring(RuntimeConfig.CharacterIntegrityMode))
    if
        Mode == "kick"
        and RuntimeConfig.CharacterIntegrityKick
        and PlayerState.Score >= RuntimeConfig.CharacterIntegrityKickScore
        and PlayerState.ConsecutiveBreaches >= math.max(1, RuntimeConfig.CharacterIntegrityMaxConsecutiveBreaches)
    then
        return "kick"
    end

    if
        (Mode == "correct" or Mode == "kick")
        and PlayerState.Score >= RuntimeConfig.CharacterIntegrityCorrectionScore
        and os.clock() >= PlayerState.LastCorrectionAt
    then
        return "correct"
    end
    return if Mode == "observe" then "observe" else "report"
end

function RuntimeSupport.ReportCharacterIntegrity(Player: any, Reason: string, Weight: number?, Detail: string?): (number, string)
    local PlayerState = RuntimeSupport.GetCharacterIntegrityPlayer(Player)
    local Now = os.clock()
    RuntimeSupport.DecayCharacterIntegrityPlayer(PlayerState, Now)
    local Amount = math.max(1, math.floor(Weight or 1))
    PlayerState.Score = math.min(1000, PlayerState.Score + Amount)
    PlayerState.Reasons[Reason] = math.min(1000, (PlayerState.Reasons[Reason] or 0) + Amount)
    PlayerState.LastReason = Reason
    local Action = RuntimeSupport.CharacterIntegrityAction(PlayerState)
    PlayerState.LastAction = Action

    local Key = RuntimeSupport.PeerKey(Player)
    local ByReason = RuntimeState.CharacterIntegrity.LastEvidence[Key]
    if ByReason == nil then
        ByReason = {}
        RuntimeState.CharacterIntegrity.LastEvidence[Key] = ByReason
    end
    local Last = ByReason[Reason]
    local Throttled = Last ~= nil and Now - Last < math.max(0, RuntimeConfig.CharacterIntegrityReportCooldownSeconds)
    if not Throttled or Action == "kick" then
        ByReason[Reason] = Now
        local Entry = {
            Player = Player,
            UserId = TryGetUserId(Player),
            Reason = Reason,
            Detail = Detail or "",
            Weight = Amount,
            Score = PlayerState.Score,
            ConsecutiveBreaches = PlayerState.ConsecutiveBreaches,
            Action = Action,
            Time = Now,
        }
        table.insert(RuntimeState.CharacterIntegrity.Evidence, Entry)
        while #RuntimeState.CharacterIntegrity.Evidence > math.max(1, RuntimeConfig.CharacterIntegrityHistoryLimit * 8) do
            table.remove(RuntimeState.CharacterIntegrity.Evidence, 1)
        end
        table.insert(PlayerState.History, Entry)
        while #PlayerState.History > math.max(1, RuntimeConfig.CharacterIntegrityHistoryLimit) do
            table.remove(PlayerState.History, 1)
        end

        MetricAdd("CharacterIntegrityActions", Action)
        if Action ~= "observe" then
            ReportViolation(Player, "$characterIntegrity", "CharacterIntegrity", Reason, Amount, Action)
        end
        EmitTelemetry("security.characterIntegrity", Entry)
    end

    if Action == "kick" then
        KickClientShieldSource(Player)
    end
    return PlayerState.Score, Action
end

function RuntimeSupport.GrantCharacterIntegrityGrace(Player: any, Seconds: number?, Reason: string?)
    local PlayerState = RuntimeSupport.GetCharacterIntegrityPlayer(Player)
    local Now = os.clock()
    local Duration = math.max(0, Seconds or RuntimeConfig.CharacterIntegrityTeleportGraceSeconds)
    PlayerState.GraceUntil = math.max(PlayerState.GraceUntil, Now + Duration)
    PlayerState.LastPosition = nil
    PlayerState.LastSampleAt = 0
    PlayerState.LastReason = Reason or "grace"
    PlayerState.ConsecutiveBreaches = 0
end

function RuntimeSupport.ReadCharacterSnapshot(Player: any): (any, any, any, any)
    local Success, Character, Root, Humanoid = pcall(function()
        local Character = Player.Character
        if Character == nil then
            return nil, nil, nil
        end
        return Character, Character:FindFirstChild("HumanoidRootPart"), Character:FindFirstChildOfClass("Humanoid")
    end)
    if not Success or Character == nil or Root == nil or Humanoid == nil then
        return nil, nil, nil, nil
    end
    return Character, Root, Humanoid, Root.CFrame
end

function RuntimeSupport.ReconcileCharacterIntegrity(Player: any, ResetScore: boolean?): boolean
    local PlayerState = RuntimeSupport.GetCharacterIntegrityPlayer(Player)
    local Character, Root, Humanoid, RootCFrame = RuntimeSupport.ReadCharacterSnapshot(Player)
    if Character == nil or Root == nil or Humanoid == nil then
        return false
    end

    PlayerState.Character = Character
    PlayerState.LastPosition = Root.Position
    PlayerState.LastSafeCFrame = RootCFrame
    PlayerState.LastSampleAt = os.clock()
    PlayerState.NextSampleAt = PlayerState.LastSampleAt + math.max(0.05, RuntimeConfig.CharacterIntegritySampleIntervalSeconds)
    PlayerState.ConsecutiveBreaches = 0
    if ResetScore == true then
        PlayerState.Score = 0
        table.clear(PlayerState.Reasons)
    end
    return true
end

function RuntimeSupport.TeleportCharacterIntegrity(Player: any, Target: CFrame, GraceSeconds: number?): boolean
    if typeof(Target) ~= "CFrame" then
        return false
    end

    RuntimeSupport.GrantCharacterIntegrityGrace(Player, GraceSeconds, "server-teleport")
    local Character, Root = RuntimeSupport.ReadCharacterSnapshot(Player)
    if Character == nil or Root == nil then
        return false
    end

    local Success = pcall(function()
        Character:PivotTo(Target)
        Root.AssemblyLinearVelocity = Vector3.zero
        Root.AssemblyAngularVelocity = Vector3.zero
    end)
    if Success then
        RuntimeSupport.ReconcileCharacterIntegrity(Player, false)
    end
    return Success
end

function RuntimeSupport.CharacterPathBlocked(Character: any, Origin: Vector3, Delta: Vector3): boolean
    if Delta.Magnitude <= 4 then
        return false
    end

    local Success, Blocked = pcall(function()
        local Workspace = game:GetService("Workspace")
        local Params = RaycastParams.new()
        Params.FilterType = Enum.RaycastFilterType.Exclude
        Params.FilterDescendantsInstances = { Character }
        Params.IgnoreWater = true
        local Hit = Workspace:Raycast(Origin, Delta, Params)
        return Hit ~= nil and Hit.Instance ~= nil and Hit.Instance:IsA("BasePart") and Hit.Instance.CanCollide
    end)
    return Success and Blocked == true
end

function RuntimeSupport.StepCharacterIntegrityPlayer(Player: any, Now: number)
    local PlayerState = RuntimeSupport.GetCharacterIntegrityPlayer(Player)
    RuntimeSupport.DecayCharacterIntegrityPlayer(PlayerState, Now)
    if Now < PlayerState.NextSampleAt then
        return
    end
    PlayerState.NextSampleAt = Now + math.max(0.05, RuntimeConfig.CharacterIntegritySampleIntervalSeconds)

    local Character, Root, Humanoid, RootCFrame = RuntimeSupport.ReadCharacterSnapshot(Player)
    if Character == nil or Root == nil or Humanoid == nil then
        PlayerState.Character = nil
        PlayerState.LastPosition = nil
        PlayerState.LastSampleAt = 0
        return
    end

    if PlayerState.Character ~= Character or PlayerState.LastPosition == nil or PlayerState.LastSampleAt <= 0 then
        PlayerState.Character = Character
        PlayerState.LastPosition = Root.Position
        PlayerState.LastSafeCFrame = RootCFrame
        PlayerState.LastSampleAt = Now
        PlayerState.GraceUntil = math.max(
            PlayerState.GraceUntil,
            Now + math.max(0, RuntimeConfig.CharacterIntegrityJoinGraceSeconds)
        )
        return
    end

    local Position = Root.Position
    local Delta = Position - PlayerState.LastPosition
    local DeltaTime = Now - PlayerState.LastSampleAt
    PlayerState.LastSampleAt = Now

    if Now < PlayerState.GraceUntil then
        PlayerState.LastPosition = Position
        PlayerState.LastSafeCFrame = RootCFrame
        PlayerState.ConsecutiveBreaches = 0
        return
    end

    local HumanoidState = Humanoid:GetState()
    local Ping = 0
    pcall(function()
        Ping = Player:GetNetworkPing()
    end)
    local HorizontalDelta = Vector3.new(Delta.X, 0, Delta.Z)
    local Velocity = Root.AssemblyLinearVelocity
    local HorizontalVelocity = Vector3.new(Velocity.X, 0, Velocity.Z).Magnitude
    local Evaluation = RuntimeSupport.EvaluateCharacterMovement({
        DeltaTime = DeltaTime,
        HorizontalDistance = HorizontalDelta.Magnitude,
        VerticalDistance = math.abs(Delta.Y),
        WalkSpeed = Humanoid.WalkSpeed,
        HorizontalVelocity = HorizontalVelocity,
        VerticalVelocity = Velocity.Y,
        Ping = Ping,
        Seated = Humanoid.Sit or HumanoidState == Enum.HumanoidStateType.Seated,
        Grounded = Humanoid.FloorMaterial ~= Enum.Material.Air,
        PathBlocked = RuntimeSupport.CharacterPathBlocked(Character, PlayerState.LastPosition, Delta),
    })

    if Evaluation.Resync then
        PlayerState.LastPosition = Position
        PlayerState.LastSafeCFrame = RootCFrame
        PlayerState.ConsecutiveBreaches = 0
        return
    end

    if not Evaluation.Suspicious then
        PlayerState.LastPosition = Position
        PlayerState.LastSafeCFrame = RootCFrame
        PlayerState.ConsecutiveBreaches = 0
        return
    end

    PlayerState.ConsecutiveBreaches += 1
    local Reason = table.concat(Evaluation.Reasons, "+")
    local _, Action = RuntimeSupport.ReportCharacterIntegrity(
        Player,
        Reason,
        Evaluation.Weight,
        `horizontal:{math.floor(HorizontalDelta.Magnitude * 100) / 100};vertical:{math.floor(Delta.Y * 100) / 100};dt:{math.floor(DeltaTime * 1000) / 1000}`
    )

    if Action == "correct" and PlayerState.LastSafeCFrame ~= nil then
        local Corrected = pcall(function()
            Character:PivotTo(PlayerState.LastSafeCFrame)
            Root.AssemblyLinearVelocity = Vector3.zero
            Root.AssemblyAngularVelocity = Vector3.zero
        end)
        if Corrected then
            PlayerState.LastCorrectionAt = Now + math.max(0, RuntimeConfig.CharacterIntegrityCorrectionCooldownSeconds)
            PlayerState.GraceUntil = Now + math.max(0, RuntimeConfig.CharacterIntegrityTeleportGraceSeconds)
            PlayerState.LastPosition = PlayerState.LastSafeCFrame.Position
            PlayerState.LastSampleAt = Now
            MetricAdd("CharacterIntegrityActions", "corrected")
        else
            PlayerState.LastPosition = Position
        end
    else
        PlayerState.LastPosition = Position
    end
end

function RuntimeSupport.StepCharacterIntegrity(PlayersList: {any})
    if not RuntimeConfig.EnableCharacterIntegrity then
        return
    end

    local Now = os.clock()
    for _, Player in PlayersList do
        if not IsPlayerActive(Player) then
            continue
        end
        local Success, Failure = pcall(RuntimeSupport.StepCharacterIntegrityPlayer, Player, Now)
        if not Success then
            EmitTelemetry("security.characterIntegrityError", {
                Player = Player,
                UserId = TryGetUserId(Player),
                Error = tostring(Failure),
                Time = Now,
            })
        end
    end
end

function RuntimeSupport.CopyCharacterIntegrityPlayer(PlayerState: any): any
    if PlayerState == nil then
        return nil
    end
    return {
        UserId = TryGetUserId(PlayerState.Player),
        Score = PlayerState.Score,
        ConsecutiveBreaches = PlayerState.ConsecutiveBreaches,
        GraceUntil = PlayerState.GraceUntil,
        LastSampleAt = PlayerState.LastSampleAt,
        LastReason = PlayerState.LastReason,
        LastAction = PlayerState.LastAction,
        Reasons = table.clone(PlayerState.Reasons),
        History = table.clone(PlayerState.History),
    }
end

function RuntimeSupport.CharacterIntegritySnapshot(Player: any?): any
    if Player ~= nil then
        return RuntimeSupport.CopyCharacterIntegrityPlayer(RuntimeState.CharacterIntegrity.Players[RuntimeSupport.PeerKey(Player)])
    end

    local PlayersSnapshot = {}
    for Key, PlayerState in RuntimeState.CharacterIntegrity.Players do
        PlayersSnapshot[tostring(Key)] = RuntimeSupport.CopyCharacterIntegrityPlayer(PlayerState)
    end
    return {
        Enabled = RuntimeConfig.EnableCharacterIntegrity,
        Mode = RuntimeConfig.CharacterIntegrityMode,
        Kick = RuntimeConfig.CharacterIntegrityKick,
        Players = PlayersSnapshot,
        Evidence = table.clone(RuntimeState.CharacterIntegrity.Evidence),
    }
end

function RuntimeSupport.InstallRemoteDecoys(Parent: Instance?, Count: number?): {Instance}
    if not RuntimeConfig.EnableRemoteDecoys then
        return {}
    end

    local Created = {}
    local Total = math.max(0, math.floor(Count or RuntimeConfig.RemoteDecoyCount))
    for Index = 1, Total do
        local Success, Remote = pcall(function()
            return Instance.new("RemoteEvent")
        end)

        if not Success or Remote == nil then
            break
        end

        Remote.Name = RuntimeSupport.CreateRemoteName(`D{Index}`)
        Remote.Parent = Parent
        table.insert(RuntimeState.RemoteSecurity.Decoys, Remote)
        table.insert(Created, Remote)

        local Connection = Remote.OnServerEvent
        if Connection then
            Connection:Connect(function(Player)
                RuntimeSupport.ReportClientShield(Player, TransportError.RemoteDecoy, Remote.Name, 100, true)
            end)
        end
    end

    return Created
end

local function BeforeSend(Name: string, Channel: string, Target: any?): boolean
    if RuntimeState.KilledRemotes[Name] then
        DropPacket(Target, Channel, TransportError.KillSwitch)
        return false
    end

    return RunHooks("BeforeSend", {
        Name = Name,
        Channel = Channel,
        Target = Target
    })
end

local function Use(HookName: string, Callback: (...any) -> any): () -> ()
    local List = Hooks[HookName]
    if not List then
        error(`[Cheeto]: Unknown middleware hook "{HookName}".`)
    end

    table.insert(List, Callback)
    return function()
        local Index = table.find(List, Callback)
        if Index then
            table.remove(List, Index)
        end
    end
end

local function UseAuth(RuleName: string, Callback: (any) -> boolean)
    AuthRules[RuleName] = Callback
end

local UnknownAuthWarned: {[string]: true} = {}

local function CheckAuth(RuleName: string?, Context: any): boolean
    if RuleName == nil or RuleName == "" then
        return true
    end

    local Rule = AuthRules[RuleName]
    if Rule == nil then
        --> Fail closed, do NOT raise. This runs per event inside the batched
        --> receive loop, so raising here would abort the rest of the packet and
        --> take unrelated events down with it. Matches CheckPolicy, which drops
        --> on an unregistered policy rather than erroring.
        if not UnknownAuthWarned[RuleName] then
            UnknownAuthWarned[RuleName] = true
            warn(`[Cheeto]: Unknown auth rule "{RuleName}", every packet on it is dropped. Register it with UseAuth.`)
        end
        MetricAdd("HookErrors", "Auth")
        return false
    end

    local Success, Result = pcall(Rule, Context)
    if not Success then
        MetricAdd("HookErrors", "Auth")
        warn(`[Cheeto]: Auth rule "{RuleName}" failed: {Result}`)
        return false
    end

    return Result == true
end

local function ContextUserId(Context: any): number?
    return TryGetUserId(Context.Source)
end

local function CheckCooldown(Source: any, Name: string, Seconds: number?): boolean
    if Seconds == nil or Seconds <= 0 then
        return true
    end

    local State = RuntimeState.InvokeNonces[RuntimeSupport.PeerKey(Source)]
    if State == nil then
        State = {}
        RuntimeState.InvokeNonces[RuntimeSupport.PeerKey(Source)] = State
    end

    local Now = os.clock()
    local Last = State[Name]
    if Last ~= nil and Now - Last < Seconds then
        return false
    end

    State[Name] = Now
    return true
end

local function CheckReplay(Source: any, Name: string, Sequence: number?, Size: number?): boolean
    if Sequence == nil then
        return true
    end

    local Key = RuntimeSupport.PeerKey(Source)
    local ByName = RuntimeState.Replay[Key]
    if ByName == nil then
        ByName = {}
        RuntimeState.Replay[Key] = ByName
    end

    local Window = ByName[Name]
    local Now = os.clock()
    if Window == nil then
        Window = {
            Highest = -1,
            Seen = {},
            Time = {},
            Tracked = 0
        }
        ByName[Name] = Window
    end

    --> Sweep only once the window is actually full, not on every packet. The
    --> sweep is O(tracked), and a sender controls how many distinct sequence
    --> numbers are tracked, so sweeping unconditionally let one peer make every
    --> later packet on the event more expensive -- quadratic work for a linear
    --> send rate. Deferring never weakens the check: a duplicate is still
    --> rejected by Seen while it is remembered, and the sweep only exists to let
    --> a sequence number be reused once it has gone stale.
    local Capacity = if RuntimeConfig.ReplayWindowSize > 0 then RuntimeConfig.ReplayWindowSize else 256
    if Window.Tracked > Capacity then
        local Kept = 0
        for SeenSequence, SeenAt in Window.Time do
            if Now - SeenAt >= RuntimeConfig.ReplayStaleSeconds then
                Window.Seen[SeenSequence] = nil
                Window.Time[SeenSequence] = nil
            else
                Kept += 1
            end
        end
        Window.Tracked = Kept

        --> Nothing was stale, so the peer is inside the stale window and still
        --> over capacity. Anything at or below Highest - Capacity is already
        --> rejected as stale by the check below, so remembering it buys nothing.
        if Kept > Capacity then
            local Floor = Window.Highest - Capacity
            local Remaining = 0
            for SeenSequence in Window.Time do
                if SeenSequence <= Floor then
                    Window.Seen[SeenSequence] = nil
                    Window.Time[SeenSequence] = nil
                else
                    Remaining += 1
                end
            end
            Window.Tracked = Remaining
        end
    end

    if Window.Seen[Sequence] then
        DropPacket(Source, Name, TransportError.ReplayDuplicate, Size)
        return false
    end

    if RuntimeConfig.ReplayWindowSize > 0 and Window.Highest - Sequence >= RuntimeConfig.ReplayWindowSize then
        DropPacket(Source, Name, TransportError.ReplayStale, Size)
        return false
    end

    Window.Highest = math.max(Window.Highest, Sequence)
    Window.Seen[Sequence] = true
    Window.Time[Sequence] = Now
    Window.Tracked += 1
    return true
end

function RuntimeSupport.IsFiniteNumber(Value: any): boolean
    return type(Value) == "number" and Value == Value and Value ~= math.huge and Value ~= -math.huge
end

local function ValidateCanonicalValue(Source: any, Name: string, Channel: string, Value: any, Depth: number, Budget: any): boolean
    Budget.Operations += 1
    if Budget.Operations > RuntimeConfig.MaxDecodeOperations then
        DropPacket(Source, Channel, TransportError.DecodeBudget, Budget.Bytes, Name)
        return false
    end

    local Kind = typeof(Value)
    if Kind == "number" then
        if not RuntimeSupport.IsFiniteNumber(Value) then
            DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
            return false
        end
    elseif Kind == "string" then
        Budget.Bytes += #Value
        if #Value > RuntimeConfig.MaxPayloadStringBytes then
            DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
            return false
        end
    elseif Kind == "Vector3" then
        if not RuntimeSupport.IsFiniteNumber(Value.X) or not RuntimeSupport.IsFiniteNumber(Value.Y) or not RuntimeSupport.IsFiniteNumber(Value.Z) then
            DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
            return false
        end
        if math.abs(Value.X) > 1e9 or math.abs(Value.Y) > 1e9 or math.abs(Value.Z) > 1e9 then
            DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
            return false
        end
    elseif Kind == "CFrame" then
        local Position = Value.Position
        if not RuntimeSupport.IsFiniteNumber(Position.X)
            or not RuntimeSupport.IsFiniteNumber(Position.Y)
            or not RuntimeSupport.IsFiniteNumber(Position.Z)
            or math.abs(Position.X) > 1e9
            or math.abs(Position.Y) > 1e9
            or math.abs(Position.Z) > 1e9
        then
            DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
            return false
        end
    elseif Kind == "Color3" then
        if not RuntimeSupport.IsFiniteNumber(Value.R)
            or not RuntimeSupport.IsFiniteNumber(Value.G)
            or not RuntimeSupport.IsFiniteNumber(Value.B)
            or math.abs(Value.R) > 1e6
            or math.abs(Value.G) > 1e6
            or math.abs(Value.B) > 1e6
        then
            DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
            return false
        end
    elseif Kind == "table" then
        if Depth >= RuntimeConfig.MaxPayloadDepth then
            DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
            return false
        end

        local Count = 0
        local MaxIndex = 0
        for Key, Child in Value do
            Count += 1
            if Count > RuntimeConfig.MaxTableKeys then
                DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
                return false
            end

            if type(Key) == "number" then
                MaxIndex = math.max(MaxIndex, Key)
                if Key < 1 or Key % 1 ~= 0 then
                    DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
                    return false
                end
            elseif type(Key) ~= "string" and type(Key) ~= "boolean" then
                DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
                return false
            end

            if not ValidateCanonicalValue(Source, Name, Channel, Child, Depth + 1, Budget) then
                return false
            end
        end

        if MaxIndex > Count * 2 and Count > 0 then
            DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
            return false
        end
    elseif Kind == "EnumItem" then
        return true
    elseif Kind == "Instance" then
        return true
    elseif Kind == "buffer" then
        Budget.Bytes += buffer.len(Value)
    elseif Kind == "userdata" then
        return true
    elseif Kind ~= "nil" and Kind ~= "boolean" then
        DropPacket(Source, Channel, TransportError.Canonicalization, Budget.Bytes, Name)
        return false
    end

    return true
end

function RuntimeSupport.ValidateDecodedPayload(Name: string, Source: any, Channel: string, Payload: any, Size: number?): boolean
    return ValidateCanonicalValue(Source, Name, Channel, Payload, 0, {
        Operations = 0,
        Bytes = Size or 0
    })
end

local function CheckPolicy(Source: any, Name: string, Channel: string, PolicyName: string?, PolicyGroup: string?, Constraints: any, Size: number?): boolean
    if RuntimeState.KilledRemotes[Name] then
        DropPacket(Source, Channel, TransportError.KillSwitch, Size)
        return false
    end

    if PolicyGroup and RuntimeState.KilledPolicyGroups[PolicyGroup] then
        DropPacket(Source, Channel, TransportError.KillSwitch, Size)
        return false
    end

    if not CheckCooldown(Source, Name, Constraints.CooldownSeconds) then
        DropPacket(Source, Channel, TransportError.PolicyRejected, Size)
        return false
    end

    if not CheckReplay(Source, Name, RecievePredictionId, Size) then
        return false
    end

    --> Idempotency used to be handed to policies as an advisory flag and enforced
    --> by nothing, so `Idempotency: true` on an event silently did nothing unless
    --> the game happened to write a policy that called CheckIdempotency itself.
    --> A security attribute that quietly does nothing is worse than no attribute,
    --> so the runtime enforces it here.
    -->
    --> PRECONDITION, and it is a real limit: the key is the sequence number, and a
    --> sequence only reaches the wire when the sender attached a prediction id. On
    --> an event with no prediction there is nothing that identifies one logical
    --> call, so there is nothing to deduplicate and the packet is allowed through.
    --> CheckReplay above has exactly the same precondition -- ReplayWindowSize and
    --> ReplayStaleSeconds are inert without prediction. Use CooldownSeconds to
    --> bound a one-shot action that does not carry a sequence.
    if Constraints.Idempotency == true and RecievePredictionId ~= nil then
        if not RuntimeSupport.CheckIdempotency(Source, `{Name}:{RecievePredictionId}`) then
            DropPacket(Source, Channel, TransportError.ReplayDuplicate, Size)
            return false
        end
    end

    local Context = {
        Source = Source,
        Name = Name,
        Channel = Channel,
        Policy = PolicyName,
        PolicyGroup = PolicyGroup,
        Constraints = Constraints,
        UserId = TryGetUserId(Source),
        Size = Size or 0
    }

    if PolicyName and PolicyName ~= "" then
        local Rule = RuntimeState.PolicyRules[PolicyName]
        if Rule == nil then
            DropPacket(Source, Channel, TransportError.PolicyRejected, Size)
            return false
        end

        local Success, Allowed, Reason = pcall(Rule, Context)
        if not Success or Allowed ~= true then
            DropPacket(Source, Channel, Reason or TransportError.PolicyRejected, Size)
            return false
        end
    elseif RuntimeConfig.RequirePolicies and Source ~= "Server" then
        DropPacket(Source, Channel, TransportError.PolicyRejected, Size)
        return false
    end

    if PolicyGroup and RuntimeState.PolicyGroups[PolicyGroup] then
        for _, RuleName in RuntimeState.PolicyGroups[PolicyGroup] do
            if not CheckPolicy(Source, Name, Channel, RuleName, nil, Constraints, Size) then
                return false
            end
        end
    end

    return true
end

function RuntimeSupport.RegisterPolicy(Name: string, Callback: (any) -> (boolean, string?))
    RuntimeState.PolicyRules[Name] = Callback
end

function RuntimeSupport.RegisterPolicyGroup(Name: string, Rules: {string})
    RuntimeState.PolicyGroups[Name] = table.clone(Rules)
end

function RuntimeSupport.CheckIdempotency(Source: any, Key: string, TtlSeconds: number?): boolean
    local Peer = RuntimeSupport.PeerKey(Source)
    local State = RuntimeState.Idempotency[Peer]
    if State == nil then
        State = {}
        RuntimeState.Idempotency[Peer] = State
    end

    local Now = os.clock()
    local Ttl = TtlSeconds or 120
    for Existing, ExpiresAt in State do
        if ExpiresAt <= Now then
            State[Existing] = nil
        end
    end

    if State[Key] ~= nil then
        return false
    end

    State[Key] = Now + Ttl
    return true
end

function RuntimeSupport.RegisterHandle(Object: any, Owner: Player?, ExpiresAt: number?): number
    local Existing = RuntimeState.ObjectToHandle[Object]
    if Existing then
        local Entry = RuntimeState.Handles[Existing]
        if Entry then
            Entry.Owner = Owner
            Entry.ExpiresAt = ExpiresAt
            return Existing
        end
        RuntimeState.ObjectToHandle[Object] = nil
    end

    RuntimeState.NextHandleId = (RuntimeState.NextHandleId + 1) % 2147483647
    if RuntimeState.NextHandleId == 0 then
        RuntimeState.NextHandleId = 1
    end
    RuntimeState.Handles[RuntimeState.NextHandleId] = {
        Object = Object,
        Owner = Owner,
        ExpiresAt = ExpiresAt
    }
    RuntimeState.ObjectToHandle[Object] = RuntimeState.NextHandleId
    return RuntimeState.NextHandleId
end

function RuntimeSupport.ResolveHandle(Handle: number, Player: Player?): any
    local Entry = RuntimeState.Handles[Handle]
    if Entry == nil then
        return nil
    end
    if Entry.ExpiresAt and os.clock() >= Entry.ExpiresAt then
        RuntimeState.Handles[Handle] = nil
        RuntimeState.ObjectToHandle[Entry.Object] = nil
        return nil
    end
    if Entry.Owner ~= nil and Player ~= nil and Entry.Owner ~= Player then
        return nil
    end

    return Entry.Object
end

function RuntimeSupport.RevokeHandle(Handle: number)
    local Entry = RuntimeState.Handles[Handle]
    if Entry then
        RuntimeState.ObjectToHandle[Entry.Object] = nil
        RuntimeState.Handles[Handle] = nil
    end
end

function RuntimeSupport.IssueCapability(Object: any, Owner: Player?, Permissions: {[string]: boolean}?, DurationSeconds: number?): number
    RuntimeState.NextCapabilityId = (RuntimeState.NextCapabilityId + 1) % 2147483647
    if RuntimeState.NextCapabilityId == 0 then
        RuntimeState.NextCapabilityId = 1
    end
    RuntimeState.Capabilities[RuntimeState.NextCapabilityId] = {
        Object = Object,
        Owner = Owner,
        Permissions = Permissions or {},
        ExpiresAt = os.clock() + (DurationSeconds or 30)
    }
    return RuntimeState.NextCapabilityId
end

function RuntimeSupport.ValidateCapability(Capability: number, Player: Player?, Permission: string?): any
    local Entry = RuntimeState.Capabilities[Capability]
    if Entry == nil or os.clock() >= Entry.ExpiresAt then
        RuntimeState.Capabilities[Capability] = nil
        return nil
    end
    if Entry.Owner ~= nil and Player ~= nil and Entry.Owner ~= Player then
        return nil
    end
    if Permission and Entry.Permissions[Permission] ~= true then
        return nil
    end

    return Entry.Object
end

local function RegisterPolicyPresets()
    local function Alive(Context)
        return Context.Source == "Server" or Context.Source ~= nil
    end

    local function RequireKnownPolicy(Context)
        return Alive(Context)
    end

    for _, Name in {
        "damage",
        "currency",
        "trade",
        "inventory",
        "teleport",
        "admin",
        "crafting",
        "marketplace",
        "moderation",
    } do
        RuntimeState.PolicyRules[Name] = RequireKnownPolicy
    end
end

RegisterPolicyPresets()

local function TransportKey(Target: any): any
    return RuntimeSupport.PeerKey(Target)
end

local function GetTransportState(Target: any)
    local Key = TransportKey(Target)
    local State = RuntimeState.Transport[Key]
    if State == nil then
        State = {
            QueuedBytes = 0,
            QueuedEvents = 0,
            SentBytes = 0,
            SentPackets = 0,
            DroppedLowPriority = 0,
            LastFlush = 0,
            LastQueueTime = 0,
            Rtt = 0,
            Jitter = 0,
            ClockSkew = 0,
            PacketLoss = 0,
            Priority = {
                Critical = { Bytes = 0, Events = 0 },
                Gameplay = { Bytes = 0, Events = 0 },
                Cosmetic = { Bytes = 0, Events = 0 },
                Background = { Bytes = 0, Events = 0 },
            }
        }
        RuntimeState.Transport[Key] = State
    end

    return State
end

local function PriorityValue(Priority: string?): number
    return PriorityOrder[Priority or "Gameplay"] or PriorityOrder.Gameplay
end

function RuntimeSupport.RecordQueuedEvent(Target: any, Channel: string, Size: number, Priority: string?)
    local State = GetTransportState(Target)
    local Lane = Priority or "Gameplay"
    State.QueuedBytes += Size
    State.QueuedEvents += 1
    State.LastQueueTime = os.clock()
    State.Priority[Lane] = State.Priority[Lane] or { Bytes = 0, Events = 0 }
    State.Priority[Lane].Bytes += Size
    State.Priority[Lane].Events += 1

    if RuntimeConfig.MaxQueuedBytes > 0 and State.QueuedBytes > RuntimeConfig.MaxQueuedBytes then
        if RuntimeConfig.LowPriorityShedding and PriorityValue(Priority) >= PriorityOrder.Cosmetic then
            State.DroppedLowPriority += 1
            DropPacket(Target, Channel, TransportError.Backpressure, Size)
            return false
        end
    end

    return true
end

function RuntimeSupport.RecordFlush(Target: any, Channel: string, Size: number)
    local State = GetTransportState(Target)
    State.QueuedBytes = math.max(0, State.QueuedBytes - Size)
    State.QueuedEvents = math.max(0, State.QueuedEvents - 1)
    State.SentBytes += Size
    State.SentPackets += 1
    State.LastFlush = os.clock()
    EmitTelemetry("transport.flush", {
        Target = Target,
        Channel = Channel,
        Size = Size,
        QueuedBytes = State.QueuedBytes,
        QueuedEvents = State.QueuedEvents,
    })
end

function RuntimeSupport.ShouldFlush(Target: any, Channel: string, Size: number, Priority: string?): boolean
    if Size <= 0 then
        return false
    end

    local State = GetTransportState(Target)
    local Now = os.clock()
    local Elapsed = Now - State.LastFlush
    local Pressure = RuntimeConfig.MaxQueuedBytes > 0 and State.QueuedBytes / RuntimeConfig.MaxQueuedBytes or 0
    local Budget = RuntimeConfig.MaxBurstBytes
    if State.Rtt > 0.25 or State.Jitter > 0.1 then
        Budget = math.max(1024, math.floor(Budget * 0.75))
    end
    if PriorityValue(Priority) == PriorityOrder.Critical then
        return true
    end
    if Size >= Budget or Pressure >= 0.5 then
        return true
    end

    return Elapsed >= 1 / 60
end

function RuntimeSupport.UpdateNetworkStats(Target: any, Rtt: number?, Jitter: number?, ClockSkew: number?, PacketLoss: number?)
    local State = GetTransportState(Target)
    if Rtt ~= nil then
        State.Rtt = Rtt
    end
    if Jitter ~= nil then
        State.Jitter = Jitter
    end
    if ClockSkew ~= nil then
        State.ClockSkew = ClockSkew
    end
    if PacketLoss ~= nil then
        State.PacketLoss = PacketLoss
    end
end

function RuntimeSupport.TransportSnapshot(Target: any?)
    if Target ~= nil then
        return table.clone(GetTransportState(Target))
    end

    local Snapshot = {}
    for Key, State in RuntimeState.Transport do
        Snapshot[tostring(Key)] = table.clone(State)
    end
    return Snapshot
end

function RuntimeSupport.Coalesce(Target: any, Key: string, Priority: string, Payload: any)
    local BucketKey = RuntimeSupport.PeerKey(Target)
    local Bucket = RuntimeState.Coalesce[BucketKey]
    if Bucket == nil then
        Bucket = {}
        RuntimeState.Coalesce[BucketKey] = Bucket
    end

    Bucket[Key] = {
        Priority = Priority,
        Payload = Payload,
        Time = os.clock()
    }
end

function RuntimeSupport.FlushCoalesced(Target: any): {[string]: any}
    local BucketKey = RuntimeSupport.PeerKey(Target)
    local Bucket = RuntimeState.Coalesce[BucketKey] or {}
    RuntimeState.Coalesce[BucketKey] = {}
    return Bucket
end

local function SetScopedMembership(Store: {[any]: {[Player]: true}}, ScopeName: any, Player: Player, Enabled: boolean?)
    local Bucket = Store[ScopeName]
    if Bucket == nil then
        Bucket = {}
        Store[ScopeName] = Bucket
    end
    if Enabled == false then
        Bucket[Player] = nil
    else
        Bucket[Player] = true
    end
end

local function GetScopedPlayers(Store: {[any]: {[Player]: true}}, ScopeName: any): {Player}
    local Bucket = Store[ScopeName]
    if Bucket == nil then
        return {}
    end

    local Players = {}
    for Player in Bucket do
        if IsPlayerActive(Player) then
            table.insert(Players, Player)
        end
    end
    return Players
end

function RuntimeSupport.SetParty(PartyName: string, Player: Player, Enabled: boolean?)
    SetScopedMembership(RuntimeState.Parties, PartyName, Player, Enabled)
    RuntimeState.PlayerInterest.Party[Player] = if Enabled == false then nil else PartyName
end

function RuntimeSupport.SetMatch(MatchName: string, Player: Player, Enabled: boolean?)
    SetScopedMembership(RuntimeState.Matches, MatchName, Player, Enabled)
    RuntimeState.PlayerInterest.Match[Player] = if Enabled == false then nil else MatchName
end

function RuntimeSupport.SetTeam(TeamName: string, Player: Player, Enabled: boolean?)
    SetScopedMembership(RuntimeState.Teams, TeamName, Player, Enabled)
    RuntimeState.PlayerInterest.Team[Player] = if Enabled == false then nil else TeamName
end

function RuntimeSupport.SetStreamedCell(CellName: string, Player: Player, Enabled: boolean?)
    SetScopedMembership(RuntimeState.StreamedCells, CellName, Player, Enabled)
    RuntimeState.PlayerInterest.Cell[Player] = if Enabled == false then nil else CellName
end

function RuntimeSupport.SetObjectOwner(Object: any, Player: Player, Enabled: boolean?)
    local Owners = RuntimeState.ObjectOwners[Object]
    if Owners == nil then
        Owners = {}
        RuntimeState.ObjectOwners[Object] = Owners
    end
    if Enabled == false then
        Owners[Player] = nil
    else
        Owners[Player] = true
    end
end

function RuntimeSupport.GetInterestPlayers(Scope: string, Key: any): {Player}
    if Scope == "Group" then
        return GetGroupPlayers(Key)
    elseif Scope == "Party" then
        return GetScopedPlayers(RuntimeState.Parties, Key)
    elseif Scope == "Match" then
        return GetScopedPlayers(RuntimeState.Matches, Key)
    elseif Scope == "Team" then
        return GetScopedPlayers(RuntimeState.Teams, Key)
    elseif Scope == "Cell" then
        return GetScopedPlayers(RuntimeState.StreamedCells, Key)
    elseif Scope == "Owner" then
        return GetScopedPlayers(RuntimeState.ObjectOwners, Key)
    elseif Scope == "Zone" then
        return GetInterestZonePlayers("*", Key)
    end

    return {}
end

function RuntimeSupport.CreateReplicationGraph()
    local Graph = {
        Routes = {}
    }

    function Graph:Observe(Scope: string, Key: any, Player: Player)
        self.Routes[Scope] = self.Routes[Scope] or {}
        self.Routes[Scope][Key] = self.Routes[Scope][Key] or {}
        self.Routes[Scope][Key][Player] = true
    end

    function Graph:Unobserve(Scope: string, Key: any, Player: Player)
        if self.Routes[Scope] and self.Routes[Scope][Key] then
            self.Routes[Scope][Key][Player] = nil
        end
    end

    function Graph:Players(Scope: string, Key: any): {Player}
        local Bucket = self.Routes[Scope] and self.Routes[Scope][Key]
        if Bucket == nil then
            return RuntimeSupport.GetInterestPlayers(Scope, Key)
        end

        local Players = {}
        for Player in Bucket do
            if IsPlayerActive(Player) then
                table.insert(Players, Player)
            end
        end
        return Players
    end

    function Graph:Route(Scope: string, Key: any, Sender: (Player) -> ())
        for _, Player in self:Players(Scope, Key) do
            Sender(Player)
        end
    end

    return Graph
end

function RuntimeSupport.MakePatch(Previous: any, Next: any): any
    if type(Previous) ~= "table" or type(Next) ~= "table" then
        return {
            op = "replace",
            value = Next
        }
    end

    local Patch = {}
    for Key, Value in Next do
        if type(Value) == "table" and type(Previous[Key]) == "table" then
            Patch[Key] = RuntimeSupport.MakePatch(Previous[Key], Value)
        elseif Previous[Key] ~= Value then
            Patch[Key] = {
                op = "set",
                value = Value
            }
        end
    end
    for Key in Previous do
        if Next[Key] == nil then
            Patch[Key] = {
                op = "delete",
                tombstone = Tombstone
            }
        end
    end
    return Patch
end

function RuntimeSupport.ApplyPatch(Base: any, Patch: any): any
    if type(Patch) ~= "table" then
        return Base
    end
    if Patch.op == "replace" then
        return Patch.value
    end

    local Result = if type(Base) == "table" then table.clone(Base) else {}
    for Key, Operation in Patch do
        if type(Operation) == "table" and Operation.op == "delete" then
            Result[Key] = nil
        elseif type(Operation) == "table" and Operation.op == "set" then
            Result[Key] = Operation.value
        else
            Result[Key] = RuntimeSupport.ApplyPatch(Result[Key], Operation)
        end
    end
    return Result
end

function RuntimeSupport.Interpolator(Initial: any)
    local Interpolator = {
        Current = Initial,
        Target = Initial,
        Alpha = 0
    }

    function Interpolator:SetTarget(Target: any)
        self.Target = Target
        self.Alpha = 0
    end

    function Interpolator:Step(DeltaTime: number, Speed: number?)
        self.Alpha = math.min(1, self.Alpha + DeltaTime * (Speed or 12))
        if typeof(self.Current) == "Vector3" and typeof(self.Target) == "Vector3" then
            self.Current = self.Current:Lerp(self.Target, self.Alpha)
        else
            self.Current = self.Target
        end
        return self.Current
    end

    return Interpolator
end

function RuntimeSupport.CreateConnection(Config: {[string]: any}?)
    local Config = Config or {}
    local Connection = {
        Routes = table.clone(Config.Routes or {}),
        State = table.clone(Config.State or Config.States or {}),
        Target = Config.Target,
        Connected = true,
        _disconnectors = {}
    }

    local function AssertConnected()
        if not Connection.Connected then
            error("[Cheeto]: Connection is disconnected.", 3)
        end
    end

    local function ResolveRoute(Name: string): any
        local Route = Connection.Routes[Name]
        if Route == nil then
            error(`[Cheeto]: Connection route "{Name}" is not bound.`, 3)
        end

        return Route
    end

    local function ResolveState(Name: string): any
        local Channel = Connection.State[Name]
        if Channel == nil then
            error(`[Cheeto]: Connection state "{Name}" is not bound.`, 3)
        end

        return Channel
    end

    local function TrackDisconnect(Disconnect: any): () -> ()
        if type(Disconnect) ~= "function" then
            return function() end
        end

        local Active = true
        local function TrackedDisconnect()
            if not Active then
                return
            end

            Active = false
            local Index = table.find(Connection._disconnectors, TrackedDisconnect)
            if Index then
                table.remove(Connection._disconnectors, Index)
            end
            Disconnect()
        end

        table.insert(Connection._disconnectors, TrackedDisconnect)
        return TrackedDisconnect
    end

    function Connection:Bind(Name: string, Route: any)
        AssertConnected()
        if type(Name) ~= "string" or Name == "" then
            error("[Cheeto]: Connection route names must be non-empty strings.", 2)
        end
        if type(Route) ~= "table" and type(Route) ~= "function" then
            error(`[Cheeto]: Connection route "{Name}" must be a generated endpoint or function.`, 2)
        end

        self.Routes[Name] = Route
        return self
    end

    function Connection:BindState(Name: string, Channel: any)
        AssertConnected()
        if type(Name) ~= "string" or Name == "" then
            error("[Cheeto]: Connection state names must be non-empty strings.", 2)
        end
        if type(Channel) ~= "table" then
            error(`[Cheeto]: Connection state "{Name}" must be a generated state channel.`, 2)
        end

        self.State[Name] = Channel
        return self
    end

    function Connection:SetTarget(Target: any)
        AssertConnected()
        self.Target = Target
        return self
    end

    function Connection:Send(Name: string, ...: any): ...any
        AssertConnected()
        local Route = ResolveRoute(Name)
        local Sender = if type(Route) == "function" then Route else Route.Fire or Route.Invoke or Route.Send
        if type(Sender) ~= "function" then
            error(`[Cheeto]: Connection route "{Name}" cannot send on this side.`, 2)
        end

        if self.Target ~= nil then
            return Sender(self.Target, ...)
        end
        return Sender(...)
    end

    function Connection:On(Name: string, Listener: (...any) -> ()): () -> ()
        AssertConnected()
        if type(Listener) ~= "function" then
            error("[Cheeto]: Connection listeners must be functions.", 2)
        end

        local Route = ResolveRoute(Name)
        if type(Route) ~= "table" then
            error(`[Cheeto]: Connection route "{Name}" cannot receive on this side.`, 2)
        end

        local Subscribe = Route.On or Route.Connect or Route.Subscribe
        if type(Subscribe) ~= "function" then
            error(`[Cheeto]: Connection route "{Name}" cannot receive on this side.`, 2)
        end

        return TrackDisconnect(Subscribe(Listener))
    end

    function Connection:Once(Name: string, Listener: ((...any) -> ())?): () -> ()
        AssertConnected()
        local Disconnect: () -> ()
        Disconnect = self:On(Name, function(...: any)
            Disconnect()
            if Listener then
                Listener(...)
            end
        end)
        return Disconnect
    end

    function Connection:GetState(Name: string): any
        AssertConnected()
        local Channel = ResolveState(Name)
        if type(Channel.Get) ~= "function" then
            error(`[Cheeto]: Connection state "{Name}" cannot be read on this side.`, 2)
        end

        if self.Target ~= nil then
            return Channel.Get(self.Target)
        end
        return Channel.Get()
    end

    function Connection:OnState(Name: string, Listener: (...any) -> (), FireImmediately: boolean?): () -> ()
        AssertConnected()
        if type(Listener) ~= "function" then
            error("[Cheeto]: Connection state listeners must be functions.", 2)
        end

        local Channel = ResolveState(Name)
        if type(Channel.On) ~= "function" then
            error(`[Cheeto]: Connection state "{Name}" cannot be observed on this side.`, 2)
        end

        local Disconnect = TrackDisconnect(Channel.On(Listener))
        if FireImmediately then
            local Value = self:GetState(Name)
            local Version = if type(Channel.Version) == "function" then Channel.Version() else nil
            Listener(Value, Version, nil)
        end
        return Disconnect
    end

    --> State writers mirror `Send`: with a Target the player is prefixed for you,
    --> without one you pass it yourself. `Flush` is the exception -- its plain name
    --> is the broadcast form, so the targeted variant has to be named explicitly.
    local StateWriters = {
        SetState = { Targeted = { "Set" }, Broadcast = { "Set" }, Verb = "written" },
        PatchState = { Targeted = { "Patch" }, Broadcast = { "Patch" }, Verb = "patched" },
        ClearState = { Targeted = { "Clear" }, Broadcast = { "Clear" }, Verb = "cleared" },
        FlushState = { Targeted = { "FlushPlayer", "Flush" }, Broadcast = { "FlushAll", "Flush" }, Verb = "flushed" },
    }

    for MethodName, Spec in StateWriters do
        Connection[MethodName] = function(self, Name: string, ...: any): ...any
            AssertConnected()
            local Channel = ResolveState(Name)
            local Candidates = if self.Target ~= nil then Spec.Targeted else Spec.Broadcast

            local Writer
            for _, Candidate in Candidates do
                if type(Channel[Candidate]) == "function" then
                    Writer = Channel[Candidate]
                    break
                end
            end

            if Writer == nil then
                error(`[Cheeto]: Connection state "{Name}" cannot be {Spec.Verb} on this side.`, 2)
            end

            if self.Target ~= nil then
                return Writer(self.Target, ...)
            end
            return Writer(...)
        end
    end

    function Connection:IsConnected(): boolean
        return self.Connected
    end

    function Connection:Disconnect()
        if not self.Connected then
            return
        end

        self.Connected = false
        local Disconnectors = table.clone(self._disconnectors)
        table.clear(self._disconnectors)
        for _, Disconnect in Disconnectors do
            Disconnect()
        end
    end

    Connection.Destroy = Connection.Disconnect
    return Connection
end

function RuntimeSupport.QuantizeNumber(Value: number, Scale: number, Min: number?, Max: number?): number
    local Clamped = math.clamp(Value, Min or -math.huge, Max or math.huge)
    return math.floor((Clamped * Scale) + 0.5)
end

function RuntimeSupport.DequantizeNumber(Value: number, Scale: number): number
    return Value / Scale
end

function RuntimeSupport.QuantizeVector3(Value: Vector3, Scale: number): {number}
    return {
        RuntimeSupport.QuantizeNumber(Value.X, Scale),
        RuntimeSupport.QuantizeNumber(Value.Y, Scale),
        RuntimeSupport.QuantizeNumber(Value.Z, Scale),
    }
end

function RuntimeSupport.DequantizeVector3(Value: {number}, Scale: number): Vector3
    return Vector3.new(Value[1] / Scale, Value[2] / Scale, Value[3] / Scale)
end

function RuntimeSupport.QuantizeAngle(Radians: number, Steps: number?): number
    local StepCount = Steps or 65535
    local Wrapped = (Radians % (math.pi * 2)) / (math.pi * 2)
    return math.floor(Wrapped * StepCount + 0.5)
end

function RuntimeSupport.DequantizeAngle(Value: number, Steps: number?): number
    return (Value / (Steps or 65535)) * math.pi * 2
end

function RuntimeSupport.SetKillSwitch(Name: string, Reason: string?)
    RuntimeState.KilledRemotes[Name] = Reason or "manual"
end

function RuntimeSupport.ClearKillSwitch(Name: string)
    RuntimeState.KilledRemotes[Name] = nil
end

function RuntimeSupport.SetPolicyGroupKillSwitch(Name: string, Reason: string?)
    RuntimeState.KilledPolicyGroups[Name] = Reason or "manual"
end

function RuntimeSupport.ClearPolicyGroupKillSwitch(Name: string)
    RuntimeState.KilledPolicyGroups[Name] = nil
end

function RuntimeSupport.AbuseScores(Source: any?)
    if Source ~= nil then
        return table.clone(RuntimeState.Abuse[RuntimeSupport.PeerKey(Source)] or {})
    end

    local Copy = {}
    for Key, Value in RuntimeState.Abuse do
        Copy[tostring(Key)] = table.clone(Value)
    end
    return Copy
end

function RuntimeSupport.RegisterListener(Name: string, Listener: any): () -> ()
    local List = RuntimeState.Listeners[Name]
    if List == nil then
        List = {}
        RuntimeState.Listeners[Name] = List
    end

    local Duplicate = List[Listener] == true
    List[Listener] = true
    local Count = 0
    for _ in List do
        Count += 1
    end

    RunHooks("Listener", {
        Name = Name,
        Listener = Listener,
        Count = Count,
        Duplicate = Duplicate,
        Action = "connect"
    })

    return function()
        if List[Listener] then
            List[Listener] = nil
            RunHooks("Listener", {
                Name = Name,
                Listener = Listener,
                Count = math.max(0, Count - 1),
                Duplicate = false,
                Action = "disconnect"
            })
        end
    end
end

function RuntimeSupport.ListenerSnapshot()
    local Snapshot = {}
    for Name, List in RuntimeState.Listeners do
        local Count = 0
        for _ in List do
            Count += 1
        end
        Snapshot[Name] = Count
    end
    return Snapshot
end

local function Configure(Options: {[string]: any})
    for Key, Value in Options do
        if RuntimeConfig[Key] == nil then
            error(`[Cheeto]: Unknown runtime option "{Key}".`)
        end

        if Key == "ProtocolVersion" and Value ~= PROTOCOL_VERSION then
            error("[Cheeto]: This fork is v2-only; RuntimeConfig.ProtocolVersion must be 2.")
        elseif Key == "ProtocolMode" then
            error("[Cheeto]: ProtocolMode is retired in this v2-only fork.")
        elseif Key == "AcceptProtocolVersion1" then
            error("[Cheeto]: AcceptProtocolVersion1 is retired in this v2-only fork.")
        elseif Key == "CharacterIntegrityMode" then
            local Mode = string.lower(tostring(Value))
            if Mode ~= "observe" and Mode ~= "report" and Mode ~= "correct" and Mode ~= "kick" then
                error('[Cheeto]: CharacterIntegrityMode must be "Observe", "Report", "Correct", or "Kick".')
            end
        end

        RuntimeConfig[Key] = Value
    end

    RuntimeState.Capture.Limit = RuntimeConfig.CaptureLimit
    RuntimeSupport.SetCaptureRedactions(RuntimeConfig.CaptureRedactions)
end

local function GetMetrics()
    if not RuntimeConfig.ExposeMetrics then
        error("[Cheeto]: Metrics are disabled by RuntimeConfig.ExposeMetrics.")
    end

    local Copy = {}
    for BucketName, Bucket in Metrics do
        -- selene: allow(manual_table_clone)
        --> see CloneArray: table.clone would carry metatables over
        local BucketCopy = {}
        for Key, Value in Bucket do
            BucketCopy[Key] = Value
        end
        Copy[BucketName] = BucketCopy
    end

    Copy.PendingInvokes = PendingInvokes
    Copy.PendingInvokesByName = table.clone(PendingInvokesByName)
    Copy.CapturedPackets = #RuntimeState.Capture.Entries
    return Copy
end

local function FormatMetricLine(BucketName: string, Bucket: MetricBucket): string
    local Parts = {}
    for Key, Value in Bucket do
        table.insert(Parts, `{Key}={Value}`)
    end

    table.sort(Parts)
    return `{BucketName}: {table.concat(Parts, ", ")}`
end

local function ReportMetrics()
    local Snapshot = GetMetrics()
    local Lines = { "[Cheeto]: Metrics" }
    for BucketName, Bucket in Snapshot do
        if type(Bucket) == "table" then
            table.insert(Lines, FormatMetricLine(BucketName, Bucket :: MetricBucket))
        else
            table.insert(Lines, `{BucketName}: {Bucket}`)
        end
    end

    print(table.concat(Lines, "\n"))
    return Snapshot
end

local function StartMetricsReporter(IntervalSeconds: number?): () -> ()
    local Running = true
    task.spawn(function()
        while Running do
            task.wait(IntervalSeconds or 5)
            if Running then
                ReportMetrics()
            end
        end
    end)

    return function()
        Running = false
    end
end

local function InstancePayload(Instances: {Instance})
    if not RuntimeConfig.UseEmptyInstanceOptimization then
        return Instances
    end

    if next(Instances) == nil then
        return nil
    end

    return Instances
end

function RuntimeSupport.CurrentProtocolVersion(): number
    return PROTOCOL_VERSION
end

function RuntimeSupport.ResolveReceiveProtocolVersion(Source: any): number
    return PROTOCOL_VERSION
end

function RuntimeSupport.IsPeerCompatible(ProtocolVersion: number, SchemaVersion: number, SchemaHash: string?): boolean
    return ProtocolVersion == PROTOCOL_VERSION
        and SchemaVersion >= RuntimeConfig.MinimumSchemaVersion
        and SchemaHash == RuntimeConfig.SchemaHash
end

function RuntimeSupport.WriteCapabilityHandshake()
    if not RuntimeConfig.EnableProtocolHandshake then
        return
    end

    local Frame = BeginMessage(CAPABILITY_HANDSHAKE_INDEX)
    local IndexOffset = Allocate(1)
    buffer.writeu8(SendBuffer, IndexOffset, PROTOCOL_VERSION)
    local ProtocolOffset = Allocate(1)
    buffer.writeu8(SendBuffer, ProtocolOffset, PROTOCOL_VERSION)
    local SchemaOffset = Allocate(2)
    buffer.writeu16(SendBuffer, SchemaOffset, RuntimeConfig.SchemaVersion)
    local MinimumSchemaOffset = Allocate(2)
    buffer.writeu16(SendBuffer, MinimumSchemaOffset, RuntimeConfig.MinimumSchemaVersion)
    local Hash = RuntimeConfig.SchemaHash
    local HashLength = math.min(#Hash, 255)
    local HashLengthOffset = Allocate(1)
    buffer.writeu8(SendBuffer, HashLengthOffset, HashLength)
    local HashOffset = Allocate(HashLength)
    buffer.writestring(SendBuffer, HashOffset, Hash, HashLength)
    EndMessage(Frame)
end

function RuntimeSupport.QueueCapabilityHandshake(Target: any?)
    if not RuntimeConfig.EnableProtocolHandshake then
        return
    end

    local Key = RuntimeSupport.PeerKey(Target)
    if RuntimeState.PeerHandshakesSent[Key] then
        return
    end

    RuntimeSupport.WriteCapabilityHandshake()
    RuntimeState.PeerHandshakesSent[Key] = true
end

function RuntimeSupport.ReadCapabilityHandshake(Source: any, Channel: string, PacketSize: number): boolean
    local Success, ProtocolVersion, SchemaVersion, MinimumSchemaVersion, SchemaHash = pcall(function()
        local Marker = buffer.readu8(RecieveBuffer, Read(1))
        if Marker ~= PROTOCOL_VERSION then
            error("[Cheeto]: Invalid v2 handshake marker.")
        end
        local ProtocolVersion = buffer.readu8(RecieveBuffer, Read(1))
        local SchemaVersion = buffer.readu16(RecieveBuffer, Read(2))
        local MinimumSchemaVersion = buffer.readu16(RecieveBuffer, Read(2))
        local HashLength = buffer.readu8(RecieveBuffer, Read(1))
        local SchemaHash = buffer.readstring(RecieveBuffer, Read(HashLength), HashLength)
        return ProtocolVersion, SchemaVersion, MinimumSchemaVersion, SchemaHash
    end)

    if not Success then
        DropPacket(Source, Channel, "MalformedHandshake", PacketSize)
        return false
    end

    local Compatible = RuntimeSupport.IsPeerCompatible(ProtocolVersion, SchemaVersion, SchemaHash)
    RuntimeState.PeerCapabilities[RuntimeSupport.PeerKey(Source)] = {
        ProtocolVersion = ProtocolVersion,
        SchemaVersion = SchemaVersion,
        MinimumSchemaVersion = MinimumSchemaVersion,
        SchemaHash = SchemaHash,
        Compatible = Compatible,
        LastSeen = os.clock()
    }

    RuntimeSupport.RecordCapture({
        Name = "$handshake",
        Direction = "receive",
        Source = tostring(Source),
        Channel = Channel,
        Status = if Compatible then "accepted" else "dropped",
        Reason = if Compatible then nil else "IncompatibleProtocol",
        Size = PacketSize,
        Payload = {
            ProtocolVersion = ProtocolVersion,
            SchemaVersion = SchemaVersion,
            MinimumSchemaVersion = MinimumSchemaVersion,
            SchemaHash = SchemaHash
        }
    })

    if not Compatible then
        DropPacket(Source, Channel, "IncompatibleProtocol", PacketSize)
        return false
    end

    return true
end

function RuntimeSupport.ProtocolInfo(Source: any?)
    local Capability = RuntimeState.PeerCapabilities[RuntimeSupport.PeerKey(Source)]
    return {
        LocalProtocolVersion = PROTOCOL_VERSION,
        LocalSchemaVersion = RuntimeConfig.SchemaVersion,
        MinimumSchemaVersion = RuntimeConfig.MinimumSchemaVersion,
        ProtocolMode = "StrictV2Only",
        Peer = Capability
    }
end

local function UseVarints(): boolean
    return RuntimeConfig.UseVarints
end

local function UseBitPacking(): boolean
    return RuntimeConfig.UseBitPacking
end

local function PoolSize(Size: number): number
    local Bucket = 64
    while Bucket < Size do
        Bucket *= 2
    end
    return Bucket
end

local function AcquireBuffer(Size: number): buffer
    if not RuntimeConfig.UseBufferPooling then
        return buffer.create(Size)
    end

    local Bucket = PoolSize(Size)
    local Pool = BufferPool[Bucket]
    if Pool and #Pool > 0 then
        local Buffer = Pool[#Pool]
        Pool[#Pool] = nil
        return Buffer
    end

    return buffer.create(Bucket)
end

local function ReleaseBuffer(Buffer: buffer?)
    if not RuntimeConfig.UseBufferPooling or Buffer == nil then
        return
    end

    local Size = buffer.len(Buffer)
    local Pool = BufferPool[Size]
    if Pool == nil then
        Pool = {}
        BufferPool[Size] = Pool
    end

    if #Pool < RuntimeConfig.BufferPoolLimit then
        table.insert(Pool, Buffer)
    end
end

local function RawAllocate(Bytes: number)
    local InUse = (SendCursor + Bytes)
    local Capacity = buffer.len(SendBuffer)
    if InUse > Capacity then
        local NewSize = math.max(SendSize, Capacity)
        while InUse > NewSize do
            NewSize = math.max(InUse, math.ceil(NewSize * 1.5))
        end

        local Buffer = AcquireBuffer(NewSize)
        if buffer.len(Buffer) < InUse then
            ReleaseBuffer(Buffer)
            Buffer = buffer.create(InUse)
        end
        buffer.copy(Buffer, 0, SendBuffer, 0, SendCursor)
        ReleaseBuffer(SendBuffer)
        SendBuffer = Buffer
        State.SendBuffer = Buffer
    end
    SendSize = buffer.len(SendBuffer)

    if InUse > SendSize then
        local Buffer = buffer.create(InUse)
        buffer.copy(Buffer, 0, SendBuffer, 0, math.min(SendCursor, buffer.len(SendBuffer)))
        ReleaseBuffer(SendBuffer)
        SendBuffer = Buffer
        State.SendBuffer = Buffer
        SendSize = buffer.len(SendBuffer)
    end

    if SendCursor + Bytes > buffer.len(SendBuffer) then
        error(`[Cheeto]: Allocate out of bounds: cursor={SendCursor}, bytes={Bytes}, capacity={buffer.len(SendBuffer)}, logical={SendSize}.`)
    end

    SendOffset = SendCursor
    SendCursor += Bytes

    return SendOffset
end

local function FlushBits()
    if SendBitCount <= 0 then
        return
    end

    local Offset = RawAllocate(1)
    buffer.writeu8(SendBuffer, Offset, SendBitByte)
    SendBitByte = 0
    SendBitCount = 0
end

function Allocate(Bytes: number)
    FlushBits()
    return RawAllocate(Bytes)
end

--> Per-event accessors for the generated event wrappers: they read the cursor to
--> size an event and rewind it when the queue rejects one. Deliberately not
--> mirrored into State -- the cursor moves on every allocation, and a table
--> write per field would cost more than these calls do per event.
--> One local instead of eight: Luau caps a scope at 200 locals and the
--> generated module sits just under it.
local Frame = {}

function Frame.Cursor(): number
    return SendCursor
end

function Frame.Rewind(To: number)
    SendCursor = To
end

--> Receive-side boundary. Generated code drives the receive cursor at packet
--> and frame boundaries while the runtime's Read() advances it per field, so
--> the two sides have to agree on one owner. The runtime keeps the locals;
--> these are the only entry points generated code needs, and every one is per
--> packet, per frame or per event -- never per field.
--> Line comments, not a block comment: this whole template is emitted from
--> inside a Luau long string, so a nested closing long-bracket ends it early.
function Frame.At(): number
    return RecieveCursor
end

function Frame.HasPredictionId(): boolean
    return RecievePredictionId ~= nil
end

--> Exactly the per-packet reset the generator used to emit inline. Size and
--> instances are deliberately NOT touched here: the caller sets those only on
--> the reassembly path, and folding them in would clobber the normal path.
function Frame.BeginMessages(Buffer: buffer)
    RecieveCursor = 0
    RecieveBuffer = Buffer
    State.RecieveBuffer = Buffer
    State.RecieveInstanceCursor = 0
    RecieveBitByte = 0
    RecieveBitCount = 0
    RecieveStrings = {}
    NextRecieveStringId = 1
end

--> Nested frames (an invocation read inside another read) save the whole
--> receive context, run, then put it back.
function Frame.SaveFrame(): any
    return {
        Cursor = RecieveCursor,
        Buffer = RecieveBuffer,
        Size = State.RecieveSize,
        FrameEnd = RecieveFrameEnd,
        FrameInstanceEnd = RecieveFrameInstanceEnd,
        BitByte = RecieveBitByte,
        BitCount = RecieveBitCount,
        Strings = RecieveStrings,
        NextStringId = NextRecieveStringId,
        Instances = State.RecieveInstances,
        InstanceCursor = State.RecieveInstanceCursor,
        PredictionId = RecievePredictionId,
    }
end

function Frame.EnterFrame(Buffer: buffer)
    Frame.BeginMessages(Buffer)
    State.RecieveSize = buffer.len(Buffer)
    RecieveFrameEnd = 0
    RecieveFrameInstanceEnd = 0
    State.RecieveInstances = {}
    RecievePredictionId = nil
end

function Frame.RestoreFrame(Frame: any)
    RecieveCursor = Frame.Cursor
    RecieveBuffer = Frame.Buffer
    State.RecieveBuffer = Frame.Buffer
    State.RecieveSize = Frame.Size
    RecieveFrameEnd = Frame.FrameEnd
    RecieveFrameInstanceEnd = Frame.FrameInstanceEnd
    RecieveBitByte = Frame.BitByte
    RecieveBitCount = Frame.BitCount
    RecieveStrings = Frame.Strings
    NextRecieveStringId = Frame.NextStringId
    State.RecieveInstances = Frame.Instances
    State.RecieveInstanceCursor = Frame.InstanceCursor
    RecievePredictionId = Frame.PredictionId
end

local function WriteBit(Value: boolean)
    if not UseBitPacking() then
        local Offset = RawAllocate(1)
        buffer.writeu8(SendBuffer, Offset, Value and 1 or 0)
        return
    end

    if Value then
        SendBitByte += bit32.lshift(1, SendBitCount)
    end

    SendBitCount += 1
    if SendBitCount == 8 then
        FlushBits()
    end
end

local function RawRead(Bytes: number)
    if RecieveCursor + Bytes > State.RecieveSize then
        DropPacket(RecieveSource, RecieveChannel, "MalformedPacket", State.RecieveSize)
        error(`[Cheeto]: Malformed {RecieveChannel} packet tried to read past the packet boundary.`)
    end

    if RecieveFrameEnd > 0 and RecieveCursor + Bytes > RecieveFrameEnd then
        DropPacket(RecieveSource, RecieveChannel, "MalformedPacket", State.RecieveSize)
        error(`[Cheeto]: Malformed {RecieveChannel} frame tried to read past the frame boundary.`)
    end

    local Offset = RecieveCursor
    RecieveCursor += Bytes
    return Offset
end

local function AlignReadBits()
    RecieveBitByte = 0
    RecieveBitCount = 0
end

local function TrackSend(Channel: string, Size: number, Target: any?)
    MetricAdd("BytesSent", Channel, Size)
    MetricAdd("PacketsSent", Channel)
    RunHooks("AfterSend", {
        Channel = Channel,
        Size = Size,
        Target = Target
    })
end

local function TrackEventSend(Name: string, Channel: string, Size: number, Target: any?, Payload: any?)
    MetricAdd("EventBytesSent", Name, Size)
    RuntimeSupport.RecordCapture({
        Name = Name,
        Direction = "send",
        Target = tostring(Target),
        Channel = Channel,
        Status = "accepted",
        Size = Size,
        Payload = Payload,
        RawBuffer = SendBuffer,
        RawBufferStart = SendCursor - Size,
        RawBufferSize = Size,
        RawInstances = SendInstances
    })
    RunHooks("AfterSend", {
        Name = Name,
        Channel = Channel,
        Size = Size,
        Target = Target
    })
end

local function TrackEventReceive(Name: string, Channel: string, Size: number, Source: any?, Payload: any?)
    MetricAdd("EventBytesReceived", Name, Size)
    RuntimeSupport.RecordCapture({
        Name = Name,
        Direction = "receive",
        Source = tostring(Source),
        UserId = TryGetUserId(Source),
        Channel = Channel,
        Status = "accepted",
        Size = Size,
        Payload = Payload,
        RawBuffer = RecieveBuffer,
        RawBufferStart = RecieveMessageStart,
        RawBufferSize = RecieveCursor - RecieveMessageStart,
        RawInstances = State.RecieveInstances
    })
    RunHooks("AfterReceive", {
        Name = Name,
        Source = Source,
        Channel = Channel,
        Size = Size
    })
end

local function CheckRateLimit(Source: any, Key: string, Rate: number?, Burst: number?): boolean
    local Rate = Rate or RuntimeConfig.RateLimitPerSecond
    if Rate <= 0 then
        return true
    end

    local Burst = Burst or RuntimeConfig.RateLimitBurst
    if Burst <= 0 then
        Burst = Rate
    end

    local SourceState = RuntimeState.RateLimit[Source]
    if SourceState == nil then
        SourceState = {}
        RuntimeState.RateLimit[Source] = SourceState
    end

    local Now = os.clock()
    local State = SourceState[Key]
    if State == nil then
        State = {
            Tokens = Burst,
            Updated = Now
        }
        SourceState[Key] = State
    end

    State.Tokens = math.min(Burst, State.Tokens + ((Now - State.Updated) * Rate))
    State.Updated = Now

    if State.Tokens < 1 then
        DropPacket(Source, Key, "RateLimit")
        return false
    end

    State.Tokens -= 1
    return true
end

local function ValidateIncoming(Source: any, Channel: string, IncomingBuffer: any, Instances: {Instance}?)
    if typeof(IncomingBuffer) ~= "buffer" then
        DropPacket(Source, Channel, "InvalidBuffer")
        return nil
    end

    local Size = buffer.len(IncomingBuffer)
    local Limit = if Channel == "Reliable" then RuntimeConfig.MaxReliablePacketBytes else RuntimeConfig.MaxUnreliablePacketBytes
    if Limit > 0 and Size > Limit then
        DropPacket(Source, Channel, "MaxPacketBytes", Size)
        return nil
    end

    if not CheckRateLimit(Source, Channel, RuntimeConfig.RateLimitPerSecond, RuntimeConfig.RateLimitBurst) then
        return nil
    end

    if Instances ~= nil then
        if typeof(Instances) ~= "table" then
            DropPacket(Source, Channel, "InvalidInstances", Size)
            return nil
        end
    end

    RecieveSource = Source
    RecieveChannel = Channel
    State.RecieveSize = Size
    State.RecieveInstances = Instances or {}

    MetricAdd("BytesReceived", Channel, Size)
    MetricAdd("PacketsReceived", Channel)
    if not RunHooks("BeforeReceive", {
        Source = Source,
        Channel = Channel,
        Size = Size
    }) then
        DropPacket(Source, Channel, "MiddlewareRejected", Size)
        return nil
    end

    return Size
end

function Read(Bytes: number)
    AlignReadBits()
    return RawRead(Bytes)
end

local function ReadBit(): boolean
    if not UseBitPacking() then
        return buffer.readu8(RecieveBuffer, RawRead(1)) == 1
    end

    if RecieveBitCount <= 0 then
        RecieveBitByte = buffer.readu8(RecieveBuffer, RawRead(1))
        RecieveBitCount = 8
    end

    local BitIndex = 8 - RecieveBitCount
    RecieveBitCount -= 1
    return bit32.btest(RecieveBitByte, bit32.lshift(1, BitIndex))
end

local function WriteVarint(Value: number)
    --> NaN and +inf never satisfy `Remaining <= 0`, so the loop below spins
    --> forever on them. A crafted packet can steer a decoded f64 into a varint
    --> write, which makes that an unauthenticated server hang. Reject instead of
    --> clamping: a non-finite or negative length is corruption, not something
    --> that can be meaningfully encoded.
    if Value ~= Value or Value == math.huge or Value == -math.huge or Value < 0 then
        error(`[Cheeto]: varint value must be a finite non-negative number, got {Value}.`)
    end

    local Remaining = Value
    repeat
        local Byte = Remaining % 128
        Remaining = math.floor(Remaining / 128)
        if Remaining > 0 then
            Byte += 128
        end
        local Offset = Allocate(1)
        buffer.writeu8(SendBuffer, Offset, Byte)
    until Remaining <= 0
end

local function ReadVarint(): number
    local Result = 0
    local Shift = 0
    for _ = 1, 5 do
        local Byte = buffer.readu8(RecieveBuffer, Read(1))
        Result += bit32.lshift(bit32.band(Byte, 0x7F), Shift)
        if bit32.band(Byte, 0x80) == 0 then
            return Result
        end
        Shift += 7
    end

    error("[Cheeto]: Malformed varint.")
end

local function WriteSignedVarint(Value: number)
    local Encoded = if Value < 0 then ((-Value) * 2) - 1 else Value * 2
    WriteVarint(Encoded)
end

local function ReadSignedVarint(): number
    local Encoded = ReadVarint()
    if Encoded % 2 == 1 then
        return -((Encoded + 1) / 2)
    end

    return Encoded / 2
end

local function WriteLength(Value: number, Bytes: number)
    if UseVarints() then
        WriteVarint(Value)
    elseif Bytes == 1 then
        local Offset = Allocate(1)
        buffer.writeu8(SendBuffer, Offset, Value)
    elseif Bytes == 2 then
        local Offset = Allocate(2)
        buffer.writeu16(SendBuffer, Offset, Value)
    else
        local Offset = Allocate(4)
        buffer.writeu32(SendBuffer, Offset, Value)
    end
end

local function ReadLength(Bytes: number): number
    if UseVarints() then
        return ReadVarint()
    elseif Bytes == 1 then
        return buffer.readu8(RecieveBuffer, Read(1))
    elseif Bytes == 2 then
        return buffer.readu16(RecieveBuffer, Read(2))
    end

    return buffer.readu32(RecieveBuffer, Read(4))
end

local function EncodeVarint(Value: number): {number}
    --> NaN and +inf never satisfy `Remaining <= 0`, so the loop below spins
    --> forever on them. A crafted packet can steer a decoded f64 into a varint
    --> write, which makes that an unauthenticated server hang. Reject instead of
    --> clamping: a non-finite or negative length is corruption, not something
    --> that can be meaningfully encoded.
    if Value ~= Value or Value == math.huge or Value == -math.huge or Value < 0 then
        error(`[Cheeto]: varint value must be a finite non-negative number, got {Value}.`)
    end

    local Bytes = {}
    local Remaining = Value
    repeat
        local Byte = Remaining % 128
        Remaining = math.floor(Remaining / 128)
        if Remaining > 0 then
            Byte += 128
        end
        table.insert(Bytes, Byte)
    until Remaining <= 0
    return Bytes
end

local function WriteEncodedVarint(Offset: number, Bytes: {number})
    for Index, Byte in Bytes do
        buffer.writeu8(SendBuffer, Offset + Index - 1, Byte)
    end
end

local function ReadVarintFrom(Buffer: buffer, Cursor: number, Limit: number): (number?, number)
    local Result = 0
    local Shift = 0
    for _ = 1, 5 do
        if Cursor >= Limit then
            return nil, Cursor
        end

        local Byte = buffer.readu8(Buffer, Cursor)
        Cursor += 1
        Result += bit32.lshift(bit32.band(Byte, 0x7F), Shift)
        if bit32.band(Byte, 0x80) == 0 then
            return Result, Cursor
        end
        Shift += 7
    end

    return nil, Cursor
end

local function WriteVarintTo(Bytes: {number}, Value: number)
    for _, Byte in EncodeVarint(Value) do
        table.insert(Bytes, Byte)
    end
end

local function BuildControlFrame(Index: number, Payload: {number}, Source: buffer?, SourceStart: number?, SourceLength: number?): buffer
    local Header = { Index, 0 }
    WriteVarintTo(Header, #Payload + (SourceLength or 0))
    WriteVarintTo(Header, 0)

    local Packet = buffer.create(#Header + #Payload + (SourceLength or 0))
    for Offset, Byte in Header do
        buffer.writeu8(Packet, Offset - 1, Byte)
    end
    for Offset, Byte in Payload do
        buffer.writeu8(Packet, #Header + Offset - 1, Byte)
    end
    if Source and SourceLength and SourceLength > 0 then
        buffer.copy(Packet, #Header + #Payload, Source, SourceStart or 0, SourceLength)
    end

    return Packet
end

function RuntimeSupport.FragmentReliablePacket(Target: any, Packet: buffer, Instances: {Instance}?): {any}
    local Size = buffer.len(Packet)
    local FragmentBytes = RuntimeConfig.ReliableFragmentBytes
    if FragmentBytes <= 0 or Size <= FragmentBytes then
        return {
            {
                Buffer = Packet,
                Instances = Instances
            }
        }
    end

    RuntimeState.NextFragmentId = (RuntimeState.NextFragmentId + 1) % 2147483647
    local FragmentId = RuntimeState.NextFragmentId
    local Count = math.ceil(Size / FragmentBytes)
    local Fragments = table.create(Count)

    for Index = 1, Count do
        local Start = (Index - 1) * FragmentBytes
        local Length = math.min(FragmentBytes, Size - Start)
        local Payload = {}
        WriteVarintTo(Payload, FragmentId)
        WriteVarintTo(Payload, Index)
        WriteVarintTo(Payload, Count)
        WriteVarintTo(Payload, Size)
        Fragments[Index] = {
            Buffer = BuildControlFrame(FRAGMENT_INDEX, Payload, Packet, Start, Length),
            Instances = Instances
        }
    end

    EmitTelemetry("transport.fragment", {
        Target = Target,
        FragmentId = FragmentId,
        Count = Count,
        Size = Size
    })
    return Fragments
end

local function CleanupFragments(Source: any)
    local Key = RuntimeSupport.PeerKey(Source)
    local ById = RuntimeState.Fragments[Key]
    if ById == nil then
        return
    end

    local Now = os.clock()
    for FragmentId, Assembly in ById do
        if Now - Assembly.Started >= RuntimeConfig.FragmentTimeoutSeconds then
            ById[FragmentId] = nil
            DropPacket(Source, "Reliable", TransportError.FragmentTimeout, Assembly.ReceivedBytes or 0)
        end
    end
end

function RuntimeSupport.TryReassembleReliableFragment(Source: any, Packet: buffer, Instances: {Instance}?): (buffer?, {Instance}?, boolean)
    local Size = buffer.len(Packet)
    if Size <= 0 or buffer.readu8(Packet, 0) ~= FRAGMENT_INDEX then
        return Packet, Instances, true
    end

    local Cursor = 2
    local PayloadLength
    PayloadLength, Cursor = ReadVarintFrom(Packet, Cursor, Size)
    local InstanceCount
    InstanceCount, Cursor = ReadVarintFrom(Packet, Cursor, Size)
    if PayloadLength == nil or InstanceCount == nil or Cursor + PayloadLength > Size then
        DropPacket(Source, "Reliable", TransportError.MalformedPacket, Size)
        return nil, nil, false
    end

    local PayloadEnd = Cursor + PayloadLength
    local FragmentId
    FragmentId, Cursor = ReadVarintFrom(Packet, Cursor, PayloadEnd)
    local FragmentIndex
    FragmentIndex, Cursor = ReadVarintFrom(Packet, Cursor, PayloadEnd)
    local FragmentCount
    FragmentCount, Cursor = ReadVarintFrom(Packet, Cursor, PayloadEnd)
    local OriginalSize
    OriginalSize, Cursor = ReadVarintFrom(Packet, Cursor, PayloadEnd)

    if FragmentId == nil
        or FragmentIndex == nil
        or FragmentCount == nil
        or OriginalSize == nil
        or FragmentIndex < 1
        or FragmentIndex > FragmentCount
        or FragmentCount <= 1
        or OriginalSize <= 0
    then
        DropPacket(Source, "Reliable", TransportError.MalformedPacket, Size)
        return nil, nil, false
    end

    CleanupFragments(Source)
    local Key = RuntimeSupport.PeerKey(Source)
    local ById = RuntimeState.Fragments[Key]
    if ById == nil then
        ById = {}
        RuntimeState.Fragments[Key] = ById
    end

    local InFlight = 0
    for _ in ById do
        InFlight += 1
    end
    if ById[FragmentId] == nil and RuntimeConfig.MaxInFlightFragments > 0 and InFlight >= RuntimeConfig.MaxInFlightFragments then
        DropPacket(Source, "Reliable", TransportError.FragmentOverflow, Size)
        return nil, nil, false
    end

    local Assembly = ById[FragmentId]
    if Assembly == nil then
        Assembly = {
            Started = os.clock(),
            Count = FragmentCount,
            OriginalSize = OriginalSize,
            Parts = {},
            Instances = Instances,
            Received = 0,
            ReceivedBytes = 0
        }
        ById[FragmentId] = Assembly
    end

    if Assembly.Count ~= FragmentCount or Assembly.OriginalSize ~= OriginalSize then
        ById[FragmentId] = nil
        DropPacket(Source, "Reliable", TransportError.MalformedPacket, Size)
        return nil, nil, false
    end

    if Assembly.Parts[FragmentIndex] == nil then
        local ChunkLength = PayloadEnd - Cursor
        local Chunk = buffer.create(ChunkLength)
        buffer.copy(Chunk, 0, Packet, Cursor, ChunkLength)
        Assembly.Parts[FragmentIndex] = Chunk
        Assembly.Received += 1
        Assembly.ReceivedBytes += ChunkLength
        if Instances ~= nil then
            Assembly.Instances = Instances
        end
    end

    if Assembly.Received < Assembly.Count then
        return nil, nil, false
    end

    local Reassembled = buffer.create(Assembly.OriginalSize)
    local Offset = 0
    for Index = 1, Assembly.Count do
        local Chunk = Assembly.Parts[Index]
        if Chunk == nil then
            return nil, nil, false
        end
        local ChunkLength = buffer.len(Chunk)
        if Offset + ChunkLength > Assembly.OriginalSize then
            ById[FragmentId] = nil
            DropPacket(Source, "Reliable", TransportError.MalformedPacket, Size)
            return nil, nil, false
        end
        buffer.copy(Reassembled, Offset, Chunk, 0, ChunkLength)
        Offset += ChunkLength
    end

    ById[FragmentId] = nil
    EmitTelemetry("transport.reassembled", {
        Source = Source,
        FragmentId = FragmentId,
        Count = Assembly.Count,
        Size = Assembly.OriginalSize
    })
    return Reassembled, Assembly.Instances, true
end

function BeginMessage(Index: number)
    FlushBits()
    local Flags = if State.SendPredictionId ~= nil then 1 else 0
    local IndexOffset = RawAllocate(1)
    buffer.writeu8(SendBuffer, IndexOffset, Index)
    local FlagsOffset = RawAllocate(1)
    buffer.writeu8(SendBuffer, FlagsOffset, Flags)

    local LengthOffset = RawAllocate(5)
    local InstanceOffset = RawAllocate(5)
    local HeaderDataStart = SendCursor
    if State.SendPredictionId ~= nil then
        WriteVarint(State.SendPredictionId)
    end

    return {
        LengthOffset = LengthOffset,
        InstanceOffset = InstanceOffset,
        HeaderDataStart = HeaderDataStart,
        PayloadStart = SendCursor,
        InstanceStart = #SendInstances
    }
end

function EndMessage(Frame: any?)
    if Frame == nil then
        return
    end

    FlushBits()
    local PayloadLength = SendCursor - Frame.PayloadStart
    local InstanceCount = #SendInstances - Frame.InstanceStart
    local LengthBytes = EncodeVarint(PayloadLength)
    local InstanceBytes = EncodeVarint(InstanceCount)
    local ActualHeader = #LengthBytes + #InstanceBytes
    local ReservedHeader = 10
    local Shift = ReservedHeader - ActualHeader

    if Shift > 0 then
        local MoveLength = SendCursor - Frame.HeaderDataStart
        if MoveLength > 0 then
            buffer.copy(SendBuffer, Frame.HeaderDataStart - Shift, SendBuffer, Frame.HeaderDataStart, MoveLength)
        end
        SendCursor -= Shift
    end

    WriteEncodedVarint(Frame.LengthOffset, LengthBytes)
    WriteEncodedVarint(Frame.LengthOffset + #LengthBytes, InstanceBytes)
end

local function BeginReadMessage(PacketSize: number): number?
    AlignReadBits()
    RecieveMessageStart = RecieveCursor
    RecieveFrameEnd = 0
    RecieveFrameInstanceEnd = State.RecieveInstanceCursor
    RecievePredictionId = nil

    local Index = buffer.readu8(RecieveBuffer, Read(1))
    local Flags = buffer.readu8(RecieveBuffer, Read(1))
    local PayloadLength = ReadVarint()
    local InstanceCount = ReadVarint()
    if bit32.btest(Flags, 1) then
        RecievePredictionId = ReadVarint()
    end

    local FrameEnd = RecieveCursor + PayloadLength
    if FrameEnd > PacketSize then
        DropPacket(RecieveSource, RecieveChannel, "MalformedPacket", PacketSize)
        RecieveCursor = PacketSize
        return nil
    end

    RecieveFrameEnd = FrameEnd
    RecieveFrameInstanceEnd = State.RecieveInstanceCursor + InstanceCount
    return Index
end

local function EndReadMessage()
    if RecieveFrameEnd <= 0 then
        RecieveMessageStart = 0
        return
    end

    AlignReadBits()

    --> Forward progress is not optional: the read loop is `while RecieveCursor <
    --> Size`, so a frame whose declared end is at or behind its own start makes
    --> it re-read the same bytes forever. A crafted packet can produce exactly
    --> that, which is a free server hang, so abandon the rest of the packet
    --> instead of trusting the frame length.
    local Start = RecieveMessageStart
    if RecieveFrameEnd <= Start then
        DropPacket(RecieveSource, RecieveChannel, "MalformedPacket", State.RecieveSize)
        RecieveCursor = State.RecieveSize
        RecieveFrameEnd = 0
        RecieveFrameInstanceEnd = State.RecieveInstanceCursor
        RecievePredictionId = nil
        RecieveMessageStart = 0
        return
    end

    RecieveCursor = RecieveFrameEnd
    State.RecieveInstanceCursor = RecieveFrameInstanceEnd
    RecieveFrameEnd = 0
    RecieveFrameInstanceEnd = State.RecieveInstanceCursor
    RecievePredictionId = nil
    RecieveMessageStart = 0
end

local function RecoverMessage()
    if RecieveFrameEnd > 0 then
        EndReadMessage()
        return
    end

    AlignReadBits()
    RecieveCursor = State.RecieveSize
    RecieveFrameEnd = 0
    RecieveFrameInstanceEnd = State.RecieveInstanceCursor
    RecievePredictionId = nil
    RecieveMessageStart = 0
end

local function WriteStringValue(Value: string, LengthBytes: number)
    if RuntimeConfig.UseStringDictionaries then
        local Existing = SendStringIds[Value]
        if Existing then
            WriteVarint(Existing)
            return
        end

        WriteVarint(0)
        SendStringIds[Value] = NextSendStringId
        NextSendStringId += 1
    end

    local Length = #Value
    WriteLength(Length, LengthBytes)
    local Offset = Allocate(Length)
    buffer.writestring(SendBuffer, Offset, Value, Length)
end

local function ReadStringValue(LengthBytes: number): string
    if RuntimeConfig.UseStringDictionaries then
        local Identifier = ReadVarint()
        if Identifier > 0 then
            local Value = RecieveStrings[Identifier]
            if Value == nil then
                error(`[Cheeto]: Unknown interned string id {Identifier}.`)
            end

            return Value
        end
    end

    local Length = ReadLength(LengthBytes)
    local Value = buffer.readstring(RecieveBuffer, Read(Length), Length)
    if RuntimeConfig.UseStringDictionaries then
        RecieveStrings[NextRecieveStringId] = Value
        NextRecieveStringId += 1
    end

    return Value
end

function RuntimeSupport.SendClientShieldReport(Reason: string, Detail: string?, Score: number?, ImmediateKick: boolean?)
    if not RuntimeConfig.EnableClientShield then
        return
    end

    local Now = os.clock()
    local Last = RuntimeState.ClientShield.Local.Reported[Reason]
    if Last ~= nil and Now - Last < RuntimeConfig.ClientShieldReportCooldownSeconds then
        return
    end
    RuntimeState.ClientShield.Local.Reported[Reason] = Now

    local Frame = BeginMessage(CLIENT_SHIELD_INDEX)
    local KindOffset = Allocate(1)
    buffer.writeu8(SendBuffer, KindOffset, 0) --> client shield report
    WriteStringValue(Reason, 2)
    WriteStringValue(Detail or "", 2)
    WriteVarint(math.max(1, math.floor(Score or 1)))
    WriteBit(ImmediateKick == true)
    EndMessage(Frame)
end

function RuntimeSupport.WriteClientIntegrityChallenge(ChallengeId: number, Nonce: number)
    local Frame = BeginMessage(CLIENT_SHIELD_INDEX)
    local KindOffset = Allocate(1)
    buffer.writeu8(SendBuffer, KindOffset, 1) --> server integrity challenge
    WriteVarint(ChallengeId)
    WriteVarint(Nonce)
    EndMessage(Frame)
end

function RuntimeSupport.SendClientIntegrityReceipt(
    ChallengeId: number,
    Nonce: number,
    Completion: number,
    Sweep: number,
    SamplerCount: number,
    Healthy: boolean
)
    local Frame = BeginMessage(CLIENT_SHIELD_INDEX)
    local KindOffset = Allocate(1)
    buffer.writeu8(SendBuffer, KindOffset, 2) --> client integrity receipt
    WriteVarint(ChallengeId)
    WriteVarint(Nonce)
    WriteVarint(Completion)
    WriteVarint(Sweep)
    WriteVarint(SamplerCount)
    WriteBit(Healthy)
    WriteVarint(RuntimeSupport.ClientIntegrityChecksum(ChallengeId, Nonce, Completion, Sweep, SamplerCount, Healthy))
    EndMessage(Frame)
end

function RuntimeSupport.RegisterClientIntegritySampler(Callback: (any) -> any): () -> ()
    if type(Callback) ~= "function" then
        error("[Cheeto]: integrity sampler must be a function.")
    end

    table.insert(RuntimeState.ClientShield.Local.Samplers, Callback)
    local Connected = true
    return function()
        if not Connected then
            return
        end
        Connected = false
        local Index = table.find(RuntimeState.ClientShield.Local.Samplers, Callback)
        if Index ~= nil then
            table.remove(RuntimeState.ClientShield.Local.Samplers, Index)
        end
    end
end

function RuntimeSupport.RunClientIntegrityChallenge(ChallengeId: number, Nonce: number)
    if not RuntimeConfig.EnableClientIntegrity then
        return
    end

    local Local = RuntimeState.ClientShield.Local
    if ChallengeId <= Local.LastChallenge then
        return
    end
    Local.LastChallenge = ChallengeId
    Local.MonitorPending = {
        Id = ChallengeId,
        Nonce = Nonce,
        ReceivedAt = os.clock(),
    }
    if Local.MonitorRunning then
        return
    end

    Local.MonitorRunning = true
    task.defer(function()
        while Local.MonitorPending ~= nil do
            local Challenge = Local.MonitorPending
            Local.MonitorPending = nil
            Local.Completion += 1

            local Healthy = true
            local SamplerCount = 1 --> the built-in runtime invariant sample
            local Context = {
                ChallengeId = Challenge.Id,
                Nonce = Challenge.Nonce,
                Completion = Local.Completion,
                Sweep = Local.Sweep,
                ProtocolVersion = PROTOCOL_VERSION,
                SchemaVersion = RuntimeConfig.SchemaVersion,
                ReceivedAt = Challenge.ReceivedAt,
            }
            if
                RuntimeSupport.CurrentProtocolVersion() ~= PROTOCOL_VERSION
                or type(BeginMessage) ~= "function"
                or type(EndMessage) ~= "function"
                or type(Read) ~= "function"
            then
                Healthy = false
            end

            for _, Sampler in table.clone(Local.Samplers) do
                SamplerCount += 1
                local Success, Result = pcall(Sampler, Context)
                if not Success or Result == false then
                    Healthy = false
                elseif Result ~= nil and Result ~= true then
                    if type(Result) ~= "table" or Result.Healthy ~= true then
                        Healthy = false
                    end
                end
            end

            RuntimeSupport.SendClientIntegrityReceipt(
                Challenge.Id,
                Challenge.Nonce,
                Local.Completion,
                Local.Sweep,
                SamplerCount,
                Healthy
            )
            Local.LastReceipt = Challenge.Id
        end
        Local.MonitorRunning = false
    end)
end

local function ReadClientShieldPayload()
    local Kind = buffer.readu8(RecieveBuffer, Read(1))
    if Kind == 0 then --> client shield report
        if RecieveSource == SERVER_PEER_KEY or RecieveSource == "Server" then
            error("[Cheeto]: server sent a client-shield report frame.")
        end
        local Reason = ReadStringValue(2)
        local Detail = ReadStringValue(2)
        local Score = ReadVarint()
        local ImmediateKick = ReadBit()
        RuntimeSupport.ReportClientShield(RecieveSource, Reason, Detail, Score, ImmediateKick)
    elseif Kind == 1 then --> server integrity challenge
        if RecieveSource ~= SERVER_PEER_KEY and RecieveSource ~= "Server" then
            error("[Cheeto]: client sent an integrity challenge frame.")
        end
        RuntimeSupport.RunClientIntegrityChallenge(ReadVarint(), ReadVarint())
    elseif Kind == 2 then --> client integrity receipt
        if RecieveSource == SERVER_PEER_KEY or RecieveSource == "Server" then
            error("[Cheeto]: server sent an integrity receipt frame.")
        end
        local ChallengeId = ReadVarint()
        local Nonce = ReadVarint()
        local Completion = ReadVarint()
        local Sweep = ReadVarint()
        local SamplerCount = ReadVarint()
        local Healthy = ReadBit()
        local Checksum = ReadVarint()
        RuntimeSupport.AcceptClientIntegrityReceipt(
            RecieveSource,
            ChallengeId,
            Nonce,
            Completion,
            Sweep,
            SamplerCount,
            Healthy,
            Checksum
        )
    else
        error(`[Cheeto]: unknown client-shield frame kind {Kind}.`)
    end
end

function RuntimeSupport.StartClientShield()
    if not RuntimeConfig.EnableClientShield or RuntimeState.ClientShield.Local.Started then
        return
    end

    RuntimeState.ClientShield.Local.Started = true
    task.spawn(function()
        local EnvironmentKeys = {
            "IY_LOADED",
            "hookmetamethod",
            "getrawmetatable",
            "getgenv",
            "getgc",
            "getconnections",
            "gethui",
            "syn",
            "fluxus",
            "is_sirhurt_closure",
            "SimpleSpy",
            "saveinstance",
            "synsaveinstance",
            "gethiddenproperty",
            "get_hidden_property",
            "getnilinstances",
            "getscriptbytecode",
            "decompile",
            "writefile",
            "appendfile",
            "protectgui",
        }
        local GuiTerms = {
            "infinite yield",
            "infiniteyield",
            "simple spy",
            "simplespy",
            "remote spy",
            "dex explorer",
            "saveinstance",
            "synsaveinstance",
        }
        local WeakServices = {
            { Name = "WebSocketService", Reason = TransportError.DexExplorer, Weight = 8 },
            { Name = "InsertService", Reason = TransportError.InfiniteYield, Weight = 4 },
            { Name = "UGCValidationService", Reason = TransportError.SaveInstance, Weight = 4 },
            { Name = "ScriptContext", Reason = TransportError.SaveInstance, Weight = 4 },
        }

        local RunServiceSuccess, RunService = pcall(function()
            return game:GetService("RunService")
        end)
        if not RunServiceSuccess or not RunService:IsClient() then
            RuntimeState.ClientShield.Local.Started = false
            return
        end
        if RunService:IsStudio() and game:GetAttribute("CheetoClientShieldInStudio") ~= true then
            RuntimeState.ClientShield.Local.Started = false
            return
        end

        local function KickLocal()
            pcall(function()
                local Players = game:GetService("Players")
                local LocalPlayer = Players.LocalPlayer
                if LocalPlayer then
                    LocalPlayer:Kick(RuntimeConfig.ClientShieldKickMessage)
                end
            end)
        end

        local function ReportLocal(Reason: string, Detail: string?, Weight: number?, ImmediateKick: boolean?)
            RuntimeSupport.SendClientShieldReport(Reason, Detail, Weight, ImmediateKick)
            if RuntimeConfig.ClientShieldKick and (ImmediateKick == true or RuntimeConfig.ClientShieldStrict) then
                KickLocal()
            end
        end

        local function ScanEnvironment(Reason: string): boolean
            local GetEnv = getfenv
            if type(GetEnv) ~= "function" then
                return false
            end

            for Level = 0, 24 do
                local Success, Environment = pcall(GetEnv, Level)
                if Success and type(Environment) == "table" then
                    for _, Key in EnvironmentKeys do
                        if rawget(Environment, Key) ~= nil then
                            ReportLocal(Reason, `env:{Key}:level:{Level}`, 10, true)
                            return true
                        end
                    end
                end
            end

            return false
        end

        local function StackTrap(Reason: string, Callback: () -> any)
            xpcall(Callback, function()
                ScanEnvironment(Reason)
            end)
        end

        local function ProbeStackHooks()
            local Proxy = newproxy(true)
            local Meta = getmetatable(Proxy)
            if type(Meta) == "table" then
                Meta.__index = function()
                    error("cheeto-client-shield-index", 0)
                end
                Meta.__newindex = function()
                    error("cheeto-client-shield-newindex", 0)
                end
                Meta.__add = function()
                    error("cheeto-client-shield-add", 0)
                end
                Meta.__tostring = function()
                    error("cheeto-client-shield-tostring", 0)
                end

                local ProxyAny: any = Proxy
                StackTrap(TransportError.MetamethodHook, function()
                    return ProxyAny.__cheeto
                end)
                StackTrap(TransportError.MetamethodHook, function()
                    ProxyAny.__cheeto = true
                end)
                StackTrap(TransportError.MetamethodHook, function()
                    return ProxyAny + ProxyAny
                end)
                StackTrap(TransportError.MetamethodHook, function()
                    return tostring(ProxyAny)
                end)
            end

            local TableRemove: any = table.remove
            local MathSqrt: any = math.sqrt
            local MathAbs: any = math.abs
            StackTrap(TransportError.MetamethodHook, function()
                TableRemove("not a table")
            end)
            StackTrap(TransportError.MetamethodHook, function()
                MathSqrt("not a number")
            end)
            StackTrap(TransportError.MetamethodHook, function()
                MathAbs(nil)
            end)

            local Success, Workspace = pcall(function()
                return game:GetService("Workspace")
            end)
            if Success then
                local WorkspaceAny: any = Workspace
                StackTrap(TransportError.MetamethodHook, function()
                    return WorkspaceAny.__cheeto_missing
                end)
                StackTrap(TransportError.MetamethodHook, function()
                    return WorkspaceAny:__cheeto_missing()
                end)
            end
        end

        local function ProbeGlobals()
            local Environments = { _G }
            if type(shared) == "table" then
                table.insert(Environments, shared)
            end

            for _, Environment in Environments do
                for _, Key in EnvironmentKeys do
                    if rawget(Environment, Key) ~= nil then
                        local Reason = TransportError.ExploitEnvironment
                        if Key == "IY_LOADED" then
                            Reason = TransportError.InfiniteYield
                        elseif Key == "saveinstance" or Key == "synsaveinstance" or Key == "getscriptbytecode" then
                            Reason = TransportError.SaveInstance
                        elseif Key == "SimpleSpy" then
                            Reason = TransportError.RemoteSpy
                        end
                        ReportLocal(Reason, `global:{Key}`, 10, true)
                        return
                    end
                end
            end
        end

        local function ProbeGuiTree()
            local Roots = {}
            local CoreGuiSuccess, CoreGui = pcall(function()
                return game:GetService("CoreGui")
            end)
            if CoreGuiSuccess and CoreGui ~= nil then
                table.insert(Roots, CoreGui)
            end

            local PlayerGuiSuccess, PlayerGui = pcall(function()
                local Players = game:GetService("Players")
                local LocalPlayer = Players.LocalPlayer
                return LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
            end)
            if PlayerGuiSuccess and PlayerGui ~= nil then
                table.insert(Roots, PlayerGui)
            end

            local Checked = 0
            for _, Root in Roots do
                local Success, Descendants = pcall(function()
                    return Root:GetDescendants()
                end)
                if not Success then
                    continue
                end

                for _, Descendant in Descendants do
                    Checked += 1
                    if Checked > 900 then
                        return
                    end

                    local Text = ""
                    pcall(function()
                        Text = tostring(Descendant.Name)
                        local TextValue = (Descendant :: any).Text
                        if TextValue ~= nil then
                            Text ..= " " .. tostring(TextValue)
                        end
                    end)

                    local Lower = string.lower(Text)
                    for _, Term in GuiTerms do
                        if string.find(Lower, Term, 1, true) then
                            local Reason = if string.find(Term, "save", 1, true) then TransportError.SaveInstance else TransportError.InfiniteYield
                            if string.find(Term, "spy", 1, true) then
                                Reason = TransportError.RemoteSpy
                            elseif string.find(Term, "dex", 1, true) then
                                Reason = TransportError.DexExplorer
                            end
                            ReportLocal(Reason, `gui:{Term}`, 8, true)
                            return
                        end
                    end
                end
            end
        end

        local function ProbeWeakService(ServiceName: string, Reason: string, Weight: number)
            local Success, Service = pcall(function()
                return game:GetService(ServiceName)
            end)
            if not Success or Service == nil then
                return
            end

            local Weak = setmetatable({ Service }, { __mode = "v" })
            Service = nil
            pcall(collectgarbage, "collect")
            task.wait(0.15)
            pcall(collectgarbage, "collect")
            task.wait(0.15)

            if Weak[1] ~= nil then
                ReportLocal(Reason, `weak-service:{ServiceName}`, Weight, RuntimeConfig.ClientShieldStrict)
            end
        end

        local function ProbeTextChatTripwire()
            local Success, TextChatService = pcall(function()
                return game:GetService("TextChatService")
            end)
            if not Success or TextChatService == nil then
                return
            end

            local Channels = TextChatService:FindFirstChild("TextChannels")
            if Channels == nil then
                return
            end

            local Before = game.CreatorId
            local Sentinel = 900000000 + math.random(10000, 99999)
            local ChannelSuccess, Channel = pcall(function()
                local TextChannel = Instance.new("TextChannel")
                TextChannel.Name = RuntimeSupport.CreateRemoteName("TC")
                TextChannel.Parent = Channels
                return TextChannel
            end)

            if not ChannelSuccess or Channel == nil then
                return
            end

            pcall(function()
                Channel:DisplaySystemMessage(`;setcreatorid {Sentinel}`)
            end)
            task.wait(0.35)

            if game.CreatorId == Sentinel and Before ~= Sentinel then
                ReportLocal(TransportError.InfiniteYield, "textchat:setcreatorid", 12, true)
            end

            pcall(function()
                Channel:Destroy()
            end)
        end

        local function ProbeSaveInstance()
            local GuiSuccess, GuiService = pcall(function()
                return game:GetService("GuiService")
            end)
            if GuiSuccess and GuiService ~= nil then
                local MessageSuccess, Message = pcall(function()
                    local ServiceAny: any = GuiService
                    if type(ServiceAny.GetErrorMessage) == "function" then
                        return ServiceAny:GetErrorMessage()
                    end
                    return ServiceAny.ErrorMessage
                end)
                if MessageSuccess and type(Message) == "string" and string.find(Message, "SAVEINSTANCE SAFEMODE", 1, true) then
                    ReportLocal(TransportError.SaveInstance, "safemode-error", 12, true)
                end
            end

            ScanEnvironment(TransportError.SaveInstance)
        end

        local function RunSweep()
            RuntimeState.ClientShield.Local.Sweep += 1
            ProbeGlobals()
            ProbeStackHooks()
            ProbeGuiTree()
            ProbeSaveInstance()

            local WeakIndex = ((RuntimeState.ClientShield.Local.Sweep - 1) % #WeakServices) + 1
            local WeakProbe = WeakServices[WeakIndex]
            ProbeWeakService(WeakProbe.Name, WeakProbe.Reason, WeakProbe.Weight)

            if RuntimeState.ClientShield.Local.Sweep % 8 == 1 then
                ProbeTextChatTripwire()
            end
        end

        while RuntimeState.ClientShield.Local.Started do
            pcall(RunSweep)
            task.wait(math.max(0.5, RuntimeConfig.ClientShieldProbeIntervalSeconds))
        end
    end)
end

local function Save(): BufferSave
    return {
        Size = SendSize,
        Cursor = SendCursor,
        Buffer = SendBuffer,
        Instances = SendInstances,
        BitByte = SendBitByte,
        BitCount = SendBitCount,
        StringIds = SendStringIds,
        NextStringId = NextSendStringId
    }
end

local function Load(Save: BufferSave?)
    if Save then
        if SendBuffer ~= Save.Buffer then
            ReleaseBuffer(SendBuffer)
        end
        SendSize = Save.Size
        SendCursor = Save.Cursor
        SendOffset = Save.Cursor
        SendBuffer = Save.Buffer
        State.SendBuffer = Save.Buffer
        SendInstances = Save.Instances
        State.SendInstances = Save.Instances
        SendBitByte = Save.BitByte
        SendBitCount = Save.BitCount
        SendStringIds = Save.StringIds
        NextSendStringId = Save.NextStringId
        return
    end

    SendSize = 64
    SendCursor = 0
    SendOffset = 0
    SendBuffer = AcquireBuffer(64)
    State.SendBuffer = SendBuffer
    SendInstances = {}
    State.SendInstances = SendInstances
    SendBitByte = 0
    SendBitCount = 0
    SendStringIds = {}
    NextSendStringId = 1
end

local function Invoke()
    if Invocations == 255 then
        Invocations = 0
    end

    local Invocation = Invocations
    Invocations += 1
    return Invocation
end

--> Resuming an invocation is the ONE resume an attacker can aim: the identifier
--> that selects which invocation to resolve is a u8 read straight off the wire.
-->
--> "The entry is in Calls" is not proof that its thread is waiting for it. If
--> anything throws between taking an identifier and reaching the yield --
--> serialization of an out-of-range value, a pending-invoke limit, a dead
--> Instance -- the thread unwinds while the entry survives. Resuming that stale
--> entry later delivers a resume to a thread that has since parked on something
--> completely unrelated, consuming the resume its real awaiter needed. The thread
--> is left dead or hung and the fault surfaces nowhere near the cause.
-->
--> So a resume requires positive proof of parking: AwaitInvocation records the
--> thread on the entry immediately before yielding, and only that recorded thread
--> is ever resumed, exactly once.
local function AwaitInvocation(Identifier: number)
    local Invocation = Calls[Identifier]
    if Invocation ~= nil then
        Invocation.Parked = coroutine.running()
    end

    return coroutine.yield()
end

local function ResumeInvocation(Invocation: Invocation, Success: boolean, ...)
    local Parked = Invocation.Parked
    if Parked == nil or Parked ~= Invocation.Thread then
        --> Never parked (threw before the yield) or already resumed.
        MetricAdd("HookErrors", "InvocationNotParked")
        return
    end

    if coroutine.status(Parked) ~= "suspended" then
        MetricAdd("HookErrors", "InvocationNotSuspended")
        return
    end

    Invocation.Parked = nil
    task.spawn(Parked, Success, ...)
end

local function ExpireInvocations()
    local Now = os.clock()
    for Identifier, Invocation in Calls do
        local Timeout = Invocation.Timeout
        if Timeout <= 0 then
            continue
        end

        if Now - Invocation.Started >= Timeout then
            Calls[Identifier] = nil
            PendingInvokes = math.max(0, PendingInvokes - 1)
            PendingInvokesByName[Invocation.Name] = math.max(0, (PendingInvokesByName[Invocation.Name] or 1) - 1)
            MetricAdd("InvokeTimeouts", Invocation.Name)
            ResumeInvocation(Invocation, false, `[Cheeto]: Invoke timed out after {Timeout} seconds.`)
        end
    end
end

local function RegisterInvocation(Identifier: number, Thread: thread, Name: string?, MaxPending: number?, Timeout: number?)
    ExpireInvocations()
    local InvocationName = Name or "Client"
    local GlobalLimit = RuntimeConfig.MaxPendingInvokes
    local NameLimit = MaxPending or GlobalLimit

    if GlobalLimit > 0 and PendingInvokes >= GlobalLimit then
        error(`[Cheeto]: More than {GlobalLimit} calls are awaiting a response, this packet has been dropped.`)
    end

    if NameLimit > 0 and (PendingInvokesByName[InvocationName] or 0) >= NameLimit then
        error(`[Cheeto]: More than {NameLimit} calls for "{InvocationName}" are awaiting a response, this packet has been dropped.`)
    end

    if Calls[Identifier] ~= nil then
        error("[Cheeto]: Invocation id is already awaiting a response, this packet has been dropped.")
    end

    Calls[Identifier] = {
        Thread = Thread,
        Started = os.clock(),
        Name = InvocationName,
        Timeout = Timeout or RuntimeConfig.InvokeTimeoutSeconds
    }
    PendingInvokes += 1
    PendingInvokesByName[InvocationName] = (PendingInvokesByName[InvocationName] or 0) + 1
end

local function ClearInvocation(Identifier: number): Invocation?
    local Invocation = Calls[Identifier]
    if Invocation ~= nil then
        Calls[Identifier] = nil
        PendingInvokes = math.max(0, PendingInvokes - 1)
        PendingInvokesByName[Invocation.Name] = math.max(0, (PendingInvokesByName[Invocation.Name] or 1) - 1)
    end

    return Invocation
end

local function CancelInvocations(Reason: string?)
    for Identifier, Invocation in Calls do
        Calls[Identifier] = nil
        ResumeInvocation(Invocation, false, Reason or "[Cheeto]: Invoke was cancelled.")
    end

    table.clear(PendingInvokesByName)
    PendingInvokes = 0
end

local function InvocationErrorMessage(Default: string, ...: any): string
