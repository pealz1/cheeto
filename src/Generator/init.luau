	Target.Push(`}),`, 0, Indent)
	Target.Push(`Codecs = table.freeze(\{`, 0, Indent)
	Target.Push(`QuantizeNumber = RuntimeSupport.QuantizeNumber,`, 0, Indent + 1)
	Target.Push(`DequantizeNumber = RuntimeSupport.DequantizeNumber,`, 0, Indent + 1)
	Target.Push(`QuantizeVector3 = RuntimeSupport.QuantizeVector3,`, 0, Indent + 1)
	Target.Push(`DequantizeVector3 = RuntimeSupport.DequantizeVector3,`, 0, Indent + 1)
	Target.Push(`QuantizeAngle = RuntimeSupport.QuantizeAngle,`, 0, Indent + 1)
	Target.Push(`DequantizeAngle = RuntimeSupport.DequantizeAngle,`, 0, Indent + 1)
	Target.Push(`}),`, 0, Indent)
end

local function GetStructFields(Data: Type): { Parser.TypeNode }?
	if Data.Type == "Struct" then
		return (Data :: Parser.Struct).Value.Values
	end

	return nil
end

local function GenerateChannelSerializers(
	Identifier: string,
	Data: Type,
	Index: number,
	CanDelta: boolean
): ({ string }, { string }, { string }?, { string }?)
	local Type, Values = Generators.LuauType(Data, true)
	local ReadFull = Blocks.Function(Util.GetPath(Identifier, false, Scope), "", `({Type})`)
	local WriteFull = Blocks.Function(Util.GetPath(Identifier, true, Scope), Values, "()")
	ReadFull:DisableOperationOptimisations()
	WriteFull:DisableOperationOptimisations()

	WriteFull:Line(`local Frame = BeginMessage({Index})`)
	Types.u8.Write(0, WriteFull)
	Generators.UserType(Data, ReadFull, WriteFull, "Value")
	ReadFull:Return("Value"):End()
	WriteFull:Line("EndMessage(Frame)")
	WriteFull:End()

	local Fields = GetStructFields(Data)
	if not CanDelta or not Fields then
		return ReadFull.Content, WriteFull.Content, nil, nil
	end

	local ReadDelta = Blocks.Function(Util.GetPath(`{Identifier}_DELTA`, false, Scope), "", "({[string]: any})")
	local WriteDelta = Blocks.Function(Util.GetPath(`{Identifier}_DELTA`, true, Scope), "Patch: {[string]: any}", "()")
	ReadDelta:DisableOperationOptimisations()
	WriteDelta:DisableOperationOptimisations()
	local BitsType = Prefabs.GetTypeToUseByBits(#Fields)

	WriteDelta:Line(`local Frame = BeginMessage({Index})`)
	Types.u8.Write(1, WriteDelta)
	WriteDelta:Line("local CHANNEL_BITS = 0")
	ReadDelta:Line("local Patch = {}")
	BitsType.Read("CHANNEL_BITS", ReadDelta)

	for Index, Field in Fields do
		local FieldName = Field.Name
		local FieldAccess = FormatIndex(FieldName)
		local Bit = BitIndexToHex(Index - 1)
		WriteDelta:Line(`if Patch{FieldAccess} ~= nil then CHANNEL_BITS += {Bit} end`)

		local ReadBranch = ReadDelta:Compare(`bit32.btest(CHANNEL_BITS, {Bit})`, "true", "Equals")
		Generators.UserType(Field, ReadBranch, Blocks.Block(), `Patch{FieldAccess}`)
		if Field.Type == "Optional" then
			ReadBranch:Line(`if Patch{FieldAccess} == nil then Patch{FieldAccess} = Tombstone end`)
		end
		ReadBranch:End()
	end

	BitsType.Write("CHANNEL_BITS", WriteDelta)
	for _, Field in Fields do
		local FieldName = Field.Name
		local FieldAccess = FormatIndex(FieldName)
		local WriteBranch = WriteDelta:Compare(`Patch{FieldAccess}`, "nil", "Not")
		Generators.UserType(Field, Blocks.Block(), WriteBranch, `Patch{FieldAccess}`)
		WriteBranch:End()
	end

	ReadDelta:Return("Patch"):End()
	WriteDelta:Line("EndMessage(Frame)")
	WriteDelta:End()

	return ReadFull.Content, WriteFull.Content, ReadDelta.Content, WriteDelta.Content
end

--> Declaration functions

function Declarations.Primitive(
	Declaration: Parser.Primitive,
	Read: Blocks.Block,
	Write: Blocks.Block,
	Variable: string
)
	local Tokens = Declaration.Tokens
	local Primitive = Tokens.Primitive.Value
	local Generator = Primitives[Primitive]
	Generator.Generate(Declaration, Variable, Read, Write, Options.WriteValidations)
end

function Declarations.Set(Declaration: Parser.Set, Read: Blocks.Block, Write: Blocks.Block, Variable: string)
	local Value = Declaration.Value
	local Flags = Value.Values

	if Options.WriteValidations then
		Write:Compare(`typeof({Variable})`, `"table"`, "Not")
			:Line(`error(\`Expected {Variable} to be of type table, got \{typeof({Variable})} instead.\`)`)
			:End()
	end

	do
		--> Read Flags

		Read:Line(`{Read:Declare(Variable)} = \{\}`)

		local Remaining = #Flags
		local FlagIndex = 1

		while Remaining > 0 do
			local Partition = math.min(Remaining, 32)
			Prefabs.GetTypeToUseByBits(Partition).Read("SET_BITS", Read)

			for Index = 1, Partition do
				local Flag = Flags[FlagIndex]

				Read:EmptyDeclare(Flag)
				Read:Line(`{Variable}{FormatIndex(Flag)} = bit32.btest(SET_BITS, {BitIndexToHex(Index - 1)});`)

				FlagIndex += 1
			end

			Remaining -= Partition
		end
	end

	do
		--> Write body

		local Remaining = #Flags
		local FlagIndex = 1

		while Remaining > 0 do
			local Partition = math.min(Remaining, 32)
			Write:Line(`{Write:Declare("SET_BITS")} = 0`)

			for Index = 1, Partition do
				local Flag = Flags[FlagIndex]
				Write:Line(`if {Variable}{FormatIndex(Flag)} == true then SET_BITS += {BitIndexToHex(Index - 1)} end`)
				FlagIndex += 1
			end

			Prefabs.GetTypeToUseByBits(Partition).Write("SET_BITS", Write)

			Remaining -= Partition
		end
	end
end

function Declarations.Enum(Declaration: Parser.Enum, Read: Blocks.Block, Write: Blocks.Block, Variable: string)
	local Value = Declaration.Value
	local Enums = Value.Values
	local Literal = Util.GenerateEnumLiterals(Enums)
	Literal = string.gsub(Literal, "|", "or")

	--> Read body
	Read:Line(`{Read:Declare(Variable)} = true :: any`)
	Types.u8.Read(`Index`, Read)
	Read = Read:Compare("Index", "0", "Equals")
	for Index, EnumItem in Enums do
		if Index > 1 then
			Read = Read:Branch("Conditional", "Index", `{Index - 1}`, "Equals")
		end

		Read:Line(`{Variable} = "{EnumItem}"`)
	end
	Read:Branch("Default"):Line(`error(\`Unexpected enum: \{Index\}\`)`):End()

	--> Write body
	local Allocation = Write:Allocate(1)
	for Index, EnumItem in Enums do
		if Index == 1 then
			Write = Write:Compare(Variable, `"{EnumItem}"`, "Equals")
		else
			Write = Write:Branch("Conditional", Variable, `"{EnumItem}"`, "Equals")
		end

		Write:Line(`buffer.writeu8(SendBuffer, {Allocation}, {Index - 1})`)
	end
	Write:Branch("Default"):Line(`error(\`Unexpected enum: \{{Variable}\}, expected one of {Literal}.\`)`):End()
end

function Declarations.Map(Declaration: Parser.Map, Read: Blocks.Block, Write: Blocks.Block, Variable: string)
	local MapValue = Declaration.Value
	local Key = MapValue.Values[1]
	local Value = MapValue.Values[2]

	local KeyVariable = `Key_{Read.Indent}`
	local ElementVariable = `Element_{Write.Indent}`
	local ElementsVariable = `Elements_{Write.Indent}`

	if Options.WriteValidations then
		Write:Compare(`typeof({Variable})`, `"table"`, "Not")
			:Line(`error(\`Expected {Variable} to be of type table, got \{typeof({Variable})} instead.\`)`)
			:End()
	end

	Read:Line(`{Read:Declare(Variable)} = \{\}`)
	Write:Line(`local {ElementsVariable} = 0`)
	Read:Line(`local {ElementsVariable} = ReadLength(2)`)
	Write:Iterator("_", "_", Variable):Line(`{ElementsVariable} += 1`):End()
	Write:Line(`WriteLength({ElementsVariable}, 2)`)

	local ReadLoop = Read:Loop("_ = 1", ElementsVariable)
	local WriteLoop = Write:Iterator(KeyVariable, ElementVariable, Variable)

	--> Maps are unsafe
	ReadLoop:DisableOperationOptimisations()
	WriteLoop:DisableOperationOptimisations()

	--ReadLoop:Line(`local Key: {KeyType}, Element: {ValueType};`)
	Generators.UserType(Key :: Type, ReadLoop, WriteLoop, KeyVariable)
	Generators.UserType(Value :: Type, ReadLoop, WriteLoop, ElementVariable)
	ReadLoop:Line(`{Variable}[{KeyVariable}] = {ElementVariable}`)

	WriteLoop:End()
	ReadLoop:End()
end

function Declarations.Struct(Declaration: Parser.Struct, Read: Blocks.Block, Write: Blocks.Block, Variable: string)
	local Value = Declaration.Value
	Read:Line(`{Read:Declare(Variable)} = \{\} :: any`)

	if Options.WriteValidations then
		Write:Compare(`typeof({Variable})`, `"table"`, "Not")
			:Line(`error(\`Expected {Variable} to be of type table, got \{typeof({Variable})} instead.\`)`)
			:End()
	end

	for _, Field in Value.Values do
		local Name = Field.Name
		local FieldVariable = `{Variable}{FormatIndex(Name)}`
		Generators.UserType(Field :: Type, Read, Write, FieldVariable)
	end
end

function Declarations.Tuple(Declaration: Parser.Tuple, Read: Blocks.Block, Write: Blocks.Block)
	for Index, Value in Declaration.Value.Values do
		local Variable = `Value{Index}`
		Generators.UserType(Value :: Type, Read, Write, Variable)
	end
end

function Declarations.TagEnum(Declaration: Parser.TagEnum, Read: Blocks.Block, Write: Blocks.Block, Variable: string)
	local Value = Declaration.Value
	local Values = Value.Values

	--> Body
	local Tag = Value.Tag
	local Header = `"{Values[1].Name}"`
	local TagIndex = `{Variable}{FormatIndex(Tag)}`

	Types.u8.Read(`Tag`, Read)
	Read:Line(`{Read:Declare(Variable)} = true :: any`)

	local Allocation = Write:Allocate(1)

	Read = Read:Compare("Tag", "0", "Equals")
	Write = Write:Compare(TagIndex, Header, "Equals")

	for Index, Variant in Values do
		local Name = `"{Variant.Name}"`
		if Index > 1 then
			Read = Read:Branch("Conditional", "Tag", tostring(Index - 1), "Equals")
			Write = Write:Branch("Conditional", TagIndex, Name, "Equals")
		end

		Write:_lineFront(`buffer.writeu8(SendBuffer, {Allocation}, {Index - 1})`)
		Write:Advance(1)

		Generators.UserType(Variant, Read, Write, Variable)
		Read:Line(`{TagIndex} = {Name}`)
	end

	Read:Branch("Default"):Line(`error(\`Unexpected variant: \{Tag\}\`)`):End()

	Write:Branch("Default"):Line(`error(\`Unexpected variant: \{{TagIndex}\}\`)`):End()
end

function Declarations.Event(Declaration: Parser.Event)
	local Value = Declaration.Value

	local Identifier = `EVENT_{Declaration.Name}`
	local Reliability = Value.Type

	local IsReliable = (Reliability == "Reliable")
	local IsUnreliable = (Reliability == "Unreliable")
	local IsPolling = (Value.Call == "Polling" or Options.UsePolling)
	local IsSameContext = Value.From == Context

	local Block = IsUnreliable and Unreliables or Reliables
	local Channel = IsUnreliable and Channels.Unreliable or Channels.Reliable

	local Index = Channel.Count
	local Queue = `Queue.{Reliability}[{Index}]`
	local Connection = `Events.{Reliability}[{Index}]`

	--> Data body
	local Types, Values, Arguments, _ = "nil", "Value: nil", "Value", nil
	local Read, Write = Generators.Event(Value.Data, Index, Identifier)

	if Value.Data then
		Types, Values, _, Arguments = Generators.LuauType(Value.Data :: Type, true)
	end
	local DecodeError = string.split(Arguments, ",")[1] or "Value"

	if IsSameContext then
		UserTypes.PushLines(Write, 1, 0)
	else
		UserTypes.PushLines(Read, 1, 0)
	end

	--> Return body
	local Body = Builder.new()
	local Indent = Util.GetScopeIndent(Scope)
	local WriteEvent = `{Util.GetPath(Identifier, true, Scope)}({Arguments})`

	Body.Push(`{Declaration.Name} = \{`, 0, Indent)
	Noop.Push(`{Declaration.Name} = \{`, 0, Indent)

	if Value.From ~= Context and IsPolling ~= true then
		local IsSync = (Value.Call == "SingleSync" or Value.Call == "ManySync")
		local IsSingle = (Value.Call == "SingleSync" or Value.Call == "SingleAsync")

		--> Create queue and event branch
		if not IsSingle then
			Events.Push(`{Connection} = \{}`)
		end

		Events.Push(`{Queue} = table.create(256)`)
		Block = (Channel.Listening == false) and Block:Compare("Index", Index, "Equals")
			or Block:Branch("Conditional", "Index", Index, "Equals")

		--> Update event block to branch block
		if IsUnreliable then
			Unreliables = Block
		else
			Reliables = Block
		end

		--> Update channel status
		Channel.Listening = true

		--> Event recieve body
		local Listener: Blocks.Block
		local ContextArguments = `Listener: ({Context == "Server" and "Player: Player, " or ""}{Values}) -> ()`
		local ListenerArguments = `{Context == "Server" and "Player, " or ""}{Arguments}`

		local CallListener = Blocks.Block()
		do
			if IsSync and Options.SyncValidation then
				CallListener = CallListener:Line(`SerdesEvent = "{Declaration.Name}"`)
			end

			local PathExpr = IsSingle and Connection or "Listener"
			local CallExpr = IsSync and `{PathExpr}({ListenerArguments})`
				or `task.spawn({PathExpr}, {ListenerArguments})`
			CallListener = CallListener:Line(CallExpr)
		end

		AddReceiveGuards(Block, Declaration.Name, Reliability, Value)
		Block:Line(`local Success, {Arguments} = pcall({Util.GetPath(Identifier, false, Scope)})`)
		AddDecodeFailureGuard(Block, Declaration.Name, Reliability, DecodeError)
		AddAfterReceive(Block, Declaration.Name, Reliability, `table.pack({Arguments})`)

		local Disconnect = Blocks.Function("", "", "()")
		if IsSingle then
			Disconnect = Disconnect:Compare(Connection, "Listener", "Equals"):Line(`{Connection} = nil`):End()
		else
			Disconnect = Disconnect:Line(`local Index = table.find({Connection}, Listener)`)
			Disconnect = Disconnect:Compare("Index", "nil", "Not"):Line(`table.remove({Connection}, Index)`):End()
		end
		Disconnect = Disconnect:Line("ReleaseListener()")

		Disconnect = Disconnect:End():Wrap("return ", "")

		if IsReliable then
			local ListenerBound: Blocks.Block
			if IsSingle then
				ListenerBound = Block:Compare(Connection, "nil", "Not"):Lines(CallListener.Content, Block.Indent)
			else
				ListenerBound = Block:Compare(`#{Connection}`, "0", "Greater")
					:Iterator("_", "Listener", Connection)
					:Lines(CallListener.Content, Block.Indent + 1)
					:End()
			end

			local QueueFallback = ListenerBound:Branch("Default")
			local QueueFull = QueueFallback:Compare(`#{Queue}`, QueueLimit(Value), "GreaterOrEquals")
			QueueFull:Line(`DropPacket({SourceExpression()}, "{Reliability}", "QueueFull", Size)`)
				:Line(AbortReadLine())
				:Branch("Default")
				:Line(`table.insert({Queue}, \{{ListenerArguments}\} :: \{any\})`)
				:End()
				:End()

			Listener = Blocks.Function(Casing.On, ContextArguments, `() -> ()`, true)
				:Line(`local ReleaseListener = RuntimeSupport.RegisterListener("{Declaration.Name}", Listener)`)
				:Line(IsSingle and `{Connection} = Listener` or `table.insert({Connection}, Listener)`)
				:Iterator("Index", "Arguments", Queue)
				:Line(IsSync and `Listener(table.unpack(Arguments))` or `task.spawn(Listener, table.unpack(Arguments))`)
				:End()
				:Line(`{Queue} = \{}`)
				:Lines(Disconnect.Content, 1)
				:End()
		else
			if IsSingle then
				Block:Compare(Connection, "nil", "Not"):Lines(CallListener.Content, Block.Indent):End()
			else
				Block:Iterator("_", "Listener", Connection):Lines(CallListener.Content, Block.Indent):End()
			end

			Listener = Blocks.Function(Casing.On, ContextArguments, `() -> ()`, true)
				:Line(`local ReleaseListener = RuntimeSupport.RegisterListener("{Declaration.Name}", Listener)`)
				:Line(IsSingle and `{Connection} = Listener` or `table.insert({Connection}, Listener)`)
				:Lines(Disconnect.Content, 1)
				:End()
		end

		Noop.Push(`{Casing.On} = NOOP`, 0, Indent + 1)
		Body.PushLines(Listener.Content, 0, Indent + 1)
	elseif Value.From ~= Context and IsPolling then
		Events.Push(`{Queue} = CreateQueue()`)
		Block = (Channel.Listening == false) and Block:Compare("Index", Index, "Equals")
			or Block:Branch("Conditional", "Index", Index, "Equals")

		if IsUnreliable then
			Unreliables = Block
		else
			Reliables = Block
		end

		Channel.Listening = true
		AddReceiveGuards(Block, Declaration.Name, Reliability, Value)
		Block:Compare(`{Queue}.size`, QueueLimit(Value), "GreaterOrEquals")
			:Line(`DropPacket({SourceExpression()}, "{Reliability}", "QueueFull", Size)`)
			:Line(AbortReadLine())
			:Branch("Default")
			:Line(`local Success, {Arguments} = pcall({Util.GetPath(Identifier, false, Scope)})`)
			:Lines(
				Blocks.Block()
					:Compare("Success", "true", "Not")
					:Line(`DropPacket({SourceExpression()}, "{Reliability}", "MalformedPacket", Size)`)
					:Line(
						`RunHooks("Error", \{ Name = "{Declaration.Name}", Source = {SourceExpression()}, Channel = "{Reliability}", Error = {DecodeError} \})`
					)
					:Line(AbortReadLine())
					:End().Content,
				0
			)
			:Line(`Push({Queue}, table.pack({Context == "Server" and "Player, " or ""}{Arguments}))`)
			:End()
		AddAfterReceive(Block, Declaration.Name, Reliability, `table.pack({Arguments})`)

		local IterTypes = `number, {Context == "Server" and "Player, " or ""}{Types}`

		local Next = Blocks.Function("", "", `({IterTypes})`)
			:Line("index += 1")
			:Line("local arguments = Pop(queue)")
			:Compare("arguments", "nil", "Not")
			:Return("index, unpack(arguments, 1, arguments.n)")
			:End()
			:Return("")
			:End()
			:Wrap("return ", "")

		local Deprecated = Blocks.Function(Casing.Next, "", `() -> ({IterTypes})`, true)
			:Line(`local index = 0`)
			:Line(`local queue = {Queue}`)
			:Lines(Next.Content, 1)
			:End()

		local Iter = Blocks.Function(Casing.Iter, "", `() -> ({IterTypes})`, true)
			:Line(`local index = 0`)
			:Line(`local queue = {Queue}`)
			:Lines(Next.Content, 1)
			:End()
			:Wrap("", ",")

		Noop.Push(`{Casing.Iter} = NOOP,`, 0, Indent + 1)
		Noop.Push(`{Casing.Next} = NOOP`, 0, Indent + 1)

		Body.PushLines(Iter.Content, 0, Indent + 1)
		Body.Push("--- @deprecated v0.14.1 -- Use `Iter` instead.", 0, Indent + 1)
		Body.PushLines(Deprecated.Content, 0, Indent + 1)
	elseif Context == "Client" then
		local Fire = Blocks.Function(Casing.Fire, Values, "()", true)
		if IsReliable then
			AddTrackedWrite(
				Fire,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
		else
			Fire:Line(`local Previous = Save()`)
			Fire:Line(`Load()`)
			AddTrackedWrite(
				Fire,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			Fire:Line("local Buffer = buffer.create(SendCursor)")
			Fire:Line("buffer.copy(Buffer, 0, SendBuffer, 0, SendCursor)")
			Fire:Compare(
				"RuntimeConfig.MaxUnreliablePacketBytes > 0 and SendCursor",
				"RuntimeConfig.MaxUnreliablePacketBytes",
				"Greater"
			)
				:Line(`DropPacket("Client", "Unreliable", "MaxPacketBytes", SendCursor)`)
				:Branch("Default")
				:Line("Unreliable:FireServer(Buffer, InstancePayload(SendInstances))")
				:Line(`TrackSend("Unreliable", SendCursor, nil)`)
				:End()
			Fire:Line("Load(Previous)")
		end
		Fire:End()

		local ShouldGeneratePrediction = Options.EnablePrediction ~= false or Value.Predict
		Noop.Push(`{Casing.Fire} = NOOP{ShouldGeneratePrediction and "," or ""}`, 0, Indent + 1)
		Body.PushLines((if ShouldGeneratePrediction then Fire:Wrap("", ",").Content else Fire.Content), 0, Indent + 1)

		if ShouldGeneratePrediction then
			local Predict = Blocks.Function(Casing.Predict, Values, "number", true)
			Predict:Line(`local PredictionId = BeginPrediction("{Declaration.Name}", table.pack({Arguments}))`)
			if IsReliable then
				AddTrackedWrite(
					Predict,
					Declaration.Name,
					Reliability,
					WriteEvent,
					nil,
					"PredictionId",
					`table.pack({Arguments})`,
					Value.Priority,
					Value.CoalesceKey
				)
			else
				Predict:Line(`local Previous = Save()`)
				Predict:Line(`Load()`)
				AddTrackedWrite(
					Predict,
					Declaration.Name,
					Reliability,
					WriteEvent,
					nil,
					"PredictionId",
					`table.pack({Arguments})`,
					Value.Priority,
					Value.CoalesceKey
				)
				Predict:Line("local Buffer = buffer.create(SendCursor)")
				Predict:Line("buffer.copy(Buffer, 0, SendBuffer, 0, SendCursor)")
				Predict:Compare(
					"RuntimeConfig.MaxUnreliablePacketBytes > 0 and SendCursor",
					"RuntimeConfig.MaxUnreliablePacketBytes",
					"Greater"
				)
					:Line(`DropPacket("Client", "Unreliable", "MaxPacketBytes", SendCursor)`)
					:Branch("Default")
					:Line("Unreliable:FireServer(Buffer, InstancePayload(SendInstances))")
					:Line(`TrackSend("Unreliable", SendCursor, nil)`)
					:End()
				Predict:Line("Load(Previous)")
			end
			Predict:Return("PredictionId"):End()

			Noop.Push(`{Casing.Predict} = NOOP`, 0, Indent + 1)
			Body.PushLines(Predict.Content, 0, Indent + 1)
		end
	else
		local Fire = Blocks.Function(Casing.Fire, `Player: Player, {Values}`, "()", true)
		if IsReliable then
			Fire:Line("Load(PlayersMap[Player])")
			AddTrackedWrite(
				Fire,
				Declaration.Name,
				Reliability,
				WriteEvent,
				"Player",
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			Fire:Line("PlayersMap[Player] = Save()")
		else
			Fire:Line("Load()")
			AddTrackedWrite(
				Fire,
				Declaration.Name,
				Reliability,
				WriteEvent,
				"Player",
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			Fire:Lines(UNRELIABLE_BODY, 1)
			Fire:Compare(
				"RuntimeConfig.MaxUnreliablePacketBytes > 0 and SendCursor",
				"RuntimeConfig.MaxUnreliablePacketBytes",
				"Greater"
			)
				:Line(`DropPacket(Player, "Unreliable", "MaxPacketBytes", SendCursor)`)
				:Branch("Default")
				:Line("Unreliable:FireClient(Player, Buffer, InstancePayload(SendInstances))")
				:Line(`TrackSend("Unreliable", SendCursor, Player)`)
				:End()
		end
		Fire:End()

		local FireAll = Blocks.Function(Casing.FireAll, Values, "()", true)
		if IsReliable then
			FireAll:Line("Load()")
			AddTrackedWrite(
				FireAll,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			FireAll:Line(RELIABLE_BODY.Header)
			FireAll:Iterator("_", "Player", "Players:GetPlayers()"):Lines(RELIABLE_BODY.Body, 2):End()
		else
			FireAll:Line("Load()")
			AddTrackedWrite(
				FireAll,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			FireAll:Lines(UNRELIABLE_BODY, 1)
			FireAll:Compare(
				"RuntimeConfig.MaxUnreliablePacketBytes > 0 and SendCursor",
				"RuntimeConfig.MaxUnreliablePacketBytes",
				"Greater"
			)
				:Line(`DropPacket(nil, "Unreliable", "MaxPacketBytes", SendCursor)`)
				:Branch("Default")
				:Line("Unreliable:FireAllClients(Buffer, InstancePayload(SendInstances))")
				:Line(`TrackSend("Unreliable", SendCursor, nil)`)
				:End()
		end
		FireAll:End()

		local FireList = Blocks.Function(Casing.FireList, `List: \{Player\}, {Values}`, "()", true)
		if IsReliable then
			FireList:Line("Load()")
			AddTrackedWrite(
				FireList,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			FireList:Line(RELIABLE_BODY.Header)
			FireList:Iterator("_", "Player", "List"):Lines(RELIABLE_BODY.Body, 2):End()
		else
			FireList:Line("Load()")
			AddTrackedWrite(
				FireList,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			FireList:Lines(UNRELIABLE_BODY, 1)
			FireList:Compare(
				"RuntimeConfig.MaxUnreliablePacketBytes > 0 and SendCursor",
				"RuntimeConfig.MaxUnreliablePacketBytes",
				"Greater"
			)
				:Line(`DropPacket(nil, "Unreliable", "MaxPacketBytes", SendCursor)`)
				:Branch("Default")
				:Iterator("_", "Player", "List")
				:Line("Unreliable:FireClient(Player, Buffer, InstancePayload(SendInstances))")
				:Line(`TrackSend("Unreliable", SendCursor, Player)`)
				:End()
				:End()
		end
		FireList:End()

		local FireExcept = Blocks.Function(Casing.FireExcept, `Except: Player, {Values}`, "()", true)
		if IsReliable then
			FireExcept:Line("Load()")
			AddTrackedWrite(
				FireExcept,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			FireExcept:Line(RELIABLE_BODY.Header)
			FireExcept:Iterator("_", "Player", "Players:GetPlayers()")
				:Compare("Player", "Except", "Equals")
				:Line("continue")
				:End()
				:Lines(RELIABLE_BODY.Body, 2)
				:End()
		else
			FireExcept:Line("Load()")
			AddTrackedWrite(
				FireExcept,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			FireExcept:Lines(UNRELIABLE_BODY, 1)
			FireExcept:Compare(
				"RuntimeConfig.MaxUnreliablePacketBytes > 0 and SendCursor",
				"RuntimeConfig.MaxUnreliablePacketBytes",
				"Greater"
			)
				:Line(`DropPacket(nil, "Unreliable", "MaxPacketBytes", SendCursor)`)
				:Branch("Default")
				:Iterator("_", "Player", "Players:GetPlayers()")
				:Compare("Player", "Except", "Equals")
				:Line("continue")
				:End()
				:Line("Unreliable:FireClient(Player, Buffer, InstancePayload(SendInstances))")
				:Line(`TrackSend("Unreliable", SendCursor, Player)`)
				:End()
				:End()
		end
		FireExcept:End()

		local FireGroup = Blocks.Function(Casing.FireGroup, `GroupName: string, {Values}`, "()", true)
		if IsReliable then
			FireGroup:Line("Load()")
			AddTrackedWrite(
				FireGroup,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			FireGroup:Line(RELIABLE_BODY.Header)
			FireGroup:Iterator("_", "Player", "GetGroupPlayers(GroupName)"):Lines(RELIABLE_BODY.Body, 2):End()
		else
			FireGroup:Line("Load()")
			AddTrackedWrite(
				FireGroup,
				Declaration.Name,
				Reliability,
				WriteEvent,
				nil,
				nil,
				`table.pack({Arguments})`,
				Value.Priority,
				Value.CoalesceKey
			)
			FireGroup:Lines(UNRELIABLE_BODY, 1)
			FireGroup:Compare(
				"RuntimeConfig.MaxUnreliablePacketBytes > 0 and SendCursor",
				"RuntimeConfig.MaxUnreliablePacketBytes",
				"Greater"
			)
				:Line(`DropPacket(GroupName, "Unreliable", "MaxPacketBytes", SendCursor)`)
				:Branch("Default")
				:Iterator("_", "Player", "GetGroupPlayers(GroupName)")
				:Line("Unreliable:FireClient(Player, Buffer, InstancePayload(SendInstances))")
				:Line(`TrackSend("Unreliable", SendCursor, Player)`)
				:End()
				:End()
		end
		FireGroup:End()

		Noop.PushLines({
			`{Casing.Fire} = NOOP,\n`,
			`{Casing.FireAll} = NOOP,\n`,
			`{Casing.FireList} = NOOP,\n`,
			`{Casing.FireExcept} = NOOP,\n`,
			`{Casing.FireGroup} = NOOP\n`,
		}, 0, Indent + 1)

		Body.PushLines(Fire:Wrap("", ",").Content, 0, Indent + 1)
		Body.PushLines(FireAll:Wrap("", ",").Content, 0, Indent + 1)
		Body.PushLines(FireList:Wrap("", ",").Content, 0, Indent + 1)
		Body.PushLines(FireExcept:Wrap("", ",").Content, 0, Indent + 1)
		Body.PushLines(FireGroup:Wrap("", ",").Content, 0, Indent + 1)
	end

	Channel.Count += 1

	Body.Push(`\},`, 0, Indent)
	Noop.Push(`\},`, 0, Indent)
	Return.PushLines(Body.DumpLines(), 0)
end

function Declarations.Function(Declaration: Parser.Function)
	local Name = Declaration.Name
	local Value = Declaration.Value

	local DataIdentifier = `FUNCTION_DATA_{Name}`
	local ReturnIdentifier = `FUNCTION_RETURN_{Name}`

	local Yield = Value.Yield
	local IsFuture = (Yield == "Future")
	local IsPromise = (Yield == "Promise")

	if IsFuture and not Options.FutureLibrary then
		error(`Cannot use yield type: "Future", without providing a path to the future library.`)
	end

	if IsPromise and not Options.PromiseLibrary then
		error(`Cannot use yield type: "Promise", without providing a path to the promise library.`)
	end

	local Block = Reliables
	local Channel = Channels.Reliable

	local Index = Channel.Count
	local Queue = `Queue.Reliable[{Index}]`
	local Connection = `Events.Reliable[{Index}]`

	--> Data and return body
	local DataTypes, DataValues, _, DataArguments = "nil", "Value: nil", nil, "Value"
	local ReturnTypes, ReturnValues, _, ReturnArguments = "nil", "ReturnValue: nil", nil, "ReturnValue"

	if Value.Data then
		DataTypes, DataValues, _, DataArguments = Generators.LuauType(Value.Data :: Type, true)
	end

	if Value.Return then
		ReturnTypes, ReturnValues, _, ReturnArguments = Generators.LuauType(Value.Return :: Type, true, "Return")
	end

	do
		local DataRead, DataWrite = Generators.Event(Value.Data :: Type, Index, DataIdentifier, "Data")
		local ReturnRead, ReturnWrite = Generators.Event(Value.Return :: Type, Index, ReturnIdentifier, "Return")

		if Context == "Client" then
			UserTypes.PushLines(DataWrite, 1, 0)
			UserTypes.PushLines(ReturnRead, 1, 0)
		elseif Context == "Server" then
			UserTypes.PushLines(DataRead, 1, 0)
			UserTypes.PushLines(ReturnWrite, 1, 0)
		end
	end

	--> Main
	local Body = Builder.new()
	local Indent = Util.GetScopeIndent(Scope)

	Noop.Push(`{Name} = \{`, 0, Indent)
	Body.Push(`{Name} = \{`, 0, Indent)

	--> Create queue and event branch
	Events.Push(`{Queue} = table.create(256)`)
	Block = (Channel.Listening == false) and Block:Compare("Index", Index, "Equals")
		or Block:Branch("Conditional", "Index", Index, "Equals")

	--> Update event block to branch block
	Reliables = Block

	if Context == "Server" then
		--> Data recieve body
		AddReceiveGuards(Block, Name, "Reliable", Value)
		Block:Line("local InvocationIdentifier = buffer.readu8(RecieveBuffer, Read(1))")
		local DecodeError = string.split(DataArguments, ",")[1] or "Value"
		Block:Line(`local Success, {DataArguments} = pcall({Util.GetPath(DataIdentifier, false, Scope)})`)
		AddDecodeFailureGuard(Block, Name, "Reliable", DecodeError)
		AddAfterReceive(Block, Name, "Reliable", `table.pack({DataArguments})`)
		Block:Compare(Connection, "nil", "Not")
			:Line(`task.spawn({Connection}, Player, {DataArguments}, InvocationIdentifier)`)
			:Branch("Default")
			:Compare(`#{Queue}`, QueueLimit(Value), "GreaterOrEquals")
			:Line(`DropPacket(Player, "Reliable", "QueueFull", Size)`)
			:Line(AbortReadLine())
			:Branch("Default")
			:Line(`table.insert({Queue}, \{Player, {DataArguments}, InvocationIdentifier\} :: \{any\})`)
			:End()
			:End()

		--> Data listener body
		local FlushQueue = Blocks.Function("", "", "()")
			:Line(`local EventQueue = {Queue} or \{\}`)
			:Line(`{Queue} = nil`)
			:Iterator("Index", "Arguments", "EventQueue")
			:Line(`{Connection}(table.unpack(Arguments))`)
			:End()
			:End()
			:Wrap("task.spawn(", ")")

		local Serialize = Blocks.Function("", "")
			:Line(`{ReturnArguments} = Listener(Player, {DataArguments})`)
			:End()
			:Wrap("local Success, Error = pcall(", ")")

		local TrueListener =
			Blocks.Function(Connection, `Player: Player, {DataValues}, InvocationIdentifier: number`, "()", true)
				:Line(`local {ReturnValues};`)
				:Lines(Serialize.Content, 1)
				:Line("if not IsPlayerActive(Player) then return end")
				:Line("Load(PlayersMap[Player])")
				:Compare("Success", "true", "Not")
				:Line(`local Frame = BeginMessage({Index})`)
				:Line("local InvocationOffset = Allocate(1)")
				:Line("buffer.writeu8(SendBuffer, InvocationOffset, InvocationIdentifier)")
				:Line("local SuccessOffset = Allocate(1)")
				:Line("buffer.writeu8(SendBuffer, SuccessOffset, 0)")
				:Line("EndMessage(Frame)")
				:Line(`warn(\`"{Name}" encountered an error, \{Error\}\`)`)
				:Branch("Default")
				:Line(`{Util.GetPath(ReturnIdentifier, true, Scope)}({ReturnArguments}, InvocationIdentifier)`)
				:End()
				:Line("PlayersMap[Player] = Save()")
				:End()

		local Listener = Blocks.Function(Casing.On, `Listener: (Player, {DataTypes}) -> ({ReturnTypes})`, "()", true)
			:Lines(TrueListener.Content, 1)
			:Lines(FlushQueue.Content, 1)
			:End()

		Noop.Push(`{Casing.On} = NOOP`, 0, Indent + 1)
		Body.PushLines(Listener.Content, 0, 2)
	else
		--> Return recieve body
		local Deserialize = Blocks.Function("", "")
			:Return(`{Util.GetPath(ReturnIdentifier, false, Scope)}()`)
			:End()
			:Wrap(`local Success, {ReturnArguments} = pcall(`, ")")

		AddReceiveGuards(Block, Name, "Reliable", Value)
		Block:Line("local InvocationIdentifier = buffer.readu8(RecieveBuffer, Read(1))")
		Block:Lines(Deserialize.Content, Block.Indent + 1)
		AddAfterReceive(Block, Name, "Reliable", `table.pack({ReturnArguments})`)
		Block:Line("local Invocation = ClearInvocation(InvocationIdentifier)")
		Block:Compare("Invocation", "nil", "Not")
			:Line(`task.spawn(Invocation.Thread, Success, {ReturnArguments})`)
			:End()

		local Error = `"There was an exception while processing \\"{Name}\\"."`
		local InvokeMaxPending = NumberLiteral(Value.MaxPendingInvokes, Options.MaxPendingInvokes or 256)
		local InvokeTimeout = NumberLiteral(Value.InvokeTimeoutSeconds, Options.InvokeTimeoutSeconds or 0)
		local Contents = Blocks.Block()
			:Line("local InvocationIdentifier = Invoke()")
			:Line(
				`RegisterInvocation(InvocationIdentifier, coroutine.running(), "{Name}", {InvokeMaxPending}, {InvokeTimeout})`
			)
			:Line("local PreviousCursor = SendCursor")
			:Line(`{Util.GetPath(DataIdentifier, true, Scope)}({DataArguments}, InvocationIdentifier)`)
			:Line(`TrackEventSend("{Name}", "Reliable", SendCursor - PreviousCursor, nil, table.pack({DataArguments}))`)
			:Line(`local Success, {ReturnValues} = coroutine.yield()`)
			:Compare("Success", "true", "Not")
			:Line(`error(InvocationErrorMessage({Error}, {ReturnArguments}))`)
			:End()
			:Return(ReturnArguments).Content

		local Invoke
		if IsFuture then
			local Wrapper = Blocks.Function("", ""):Lines(Contents):End():Wrap("return Future.Try(", ")")

			Invoke = Blocks.Function(Casing.Invoke, DataValues, `Future.Future<boolean, {ReturnTypes}>`, true)
			Invoke:Lines(Wrapper.Content, 1)
		elseif IsPromise then
			local OnCancel =
				Blocks.Function("", ""):Line("ClearInvocation(InvocationIdentifier)"):End():Wrap("OnCancel(", ")")

			local Promise = Blocks.Function("", "Resolve, Reject, OnCancel")
				:Line("local InvocationIdentifier = Invoke()")
				:Line(
					`RegisterInvocation(InvocationIdentifier, coroutine.running(), "{Name}", {InvokeMaxPending}, {InvokeTimeout})`
				)
				:Line(`{Util.GetPath(DataIdentifier, true, Scope)}({DataArguments}, InvocationIdentifier)`)
				:Lines(OnCancel.Content, 1)
				:Line(`local Success, {ReturnValues} = coroutine.yield()`)
				:Compare("Success", "true", "Not")
				:Line(`Reject(InvocationErrorMessage({Error}, {ReturnArguments}))`)
				:Return("")
				:End()
				:Line(`Resolve({ReturnArguments})`)
				:End()
				:Wrap(`return Promise.new(`, ")")

			Invoke = Blocks.Function(Casing.Invoke, DataValues, nil, true)
			Invoke:Lines(Promise.Content, 1)
		else
			Invoke = Blocks.Function(Casing.Invoke, DataValues, `({ReturnTypes})`, true)
			Invoke:Lines(Contents, 0)
		end

		Invoke:End()
		Noop.Push(`{Casing.Invoke} = NOOP`, 0, Indent + 1)
		Body.PushLines(Invoke.Content, 0, Indent + 1)
	end

	Channel.Count += 1
	Channel.Listening = true

	Noop.Push(`\},`, 0, Indent)
	Body.Push(`\},`, 0, Indent)
	Return.PushLines(Body.DumpLines(), 0)
end

function Declarations.Channel(Declaration: Parser.Channel)
	local Value = Declaration.Value
	local Data = Value.Data
	local Identifier = `CHANNEL_{Declaration.Name}`
	local Reliability = Value.Type
	local IsReliable = Reliability == "Reliable"
	local IsUnreliable = Reliability == "Unreliable"
	local Channel = IsUnreliable and Channels.Unreliable or Channels.Reliable
	local Block = IsUnreliable and Unreliables or Reliables
	local Index = Channel.Count
	local Indent = Util.GetScopeIndent(Scope)
	local Type = Generators.LuauType(Data, true)
	local CanDelta = Value.Delta ~= false and GetStructFields(Data) ~= nil
	local ReadFull, WriteFull, ReadDelta, WriteDelta = GenerateChannelSerializers(Identifier, Data, Index, CanDelta)
	local LocalPrefix = `{Util.GetScopePrefix(nil, false, Scope)}CHANNEL_{Declaration.Name}`
	local StateName = `{LocalPrefix}_STATE`
	local ConnectionsName = `{LocalPrefix}_CONNECTIONS`
	local SnapshotName = `{LocalPrefix}_SNAPSHOT`
	local VersionName = `{LocalPrefix}_VERSION`
	local WriteFullPath = Util.GetPath(Identifier, true, Scope)
	local ReadFullPath = Util.GetPath(Identifier, false, Scope)
	local WriteDeltaPath = Util.GetPath(`{Identifier}_DELTA`, true, Scope)
	local ReadDeltaPath = Util.GetPath(`{Identifier}_DELTA`, false, Scope)

	local Body = Builder.new()
	Body.Push(`{Declaration.Name} = \{`, 0, Indent)
	Noop.Push(`{Declaration.Name} = \{`, 0, Indent)

	if Context == "Client" then
		UserTypes.PushLines(ReadFull, 1, 0)
		if ReadDelta then
			UserTypes.PushLines(ReadDelta, 1, 0)
		end

		Events.Push(
			`local {ConnectionsName}: \{(Value: {Type}, Version: number, Patch: \{[string]: any}?) -> ()\} = \{}`
		)
		Events.Push(`local {SnapshotName}: {Type}? = nil`)
		Events.Push(`local {VersionName} = 0`)

		Block = (Channel.Listening == false) and Block:Compare("Index", Index, "Equals")
			or Block:Branch("Conditional", "Index", Index, "Equals")

		if IsUnreliable then
			Unreliables = Block
		else
			Reliables = Block
		end

		AddReceiveGuards(Block, Declaration.Name, Reliability, Value)
		Block:Line("local CHANNEL_MODE = buffer.readu8(RecieveBuffer, Read(1))")
		local ModeBranch = Block:Compare("CHANNEL_MODE", "0", "Equals")
		ModeBranch:Line(`local Success, Value = pcall({ReadFullPath})`)
		AddDecodeFailureGuard(ModeBranch, Declaration.Name, Reliability, "Value")
		ModeBranch:Line(`{SnapshotName} = Value`)
		ModeBranch:Line(`{VersionName} += 1`)
		ModeBranch:Iterator("_", "Listener", ConnectionsName)
			:Line(`task.spawn(Listener, {SnapshotName}, {VersionName}, nil)`)
			:End()

		if ReadDelta then
			ModeBranch = ModeBranch:Branch("Conditional", "CHANNEL_MODE", "1", "Equals")
			ModeBranch:Line(`local Success, Patch = pcall({ReadDeltaPath})`)
			AddDecodeFailureGuard(ModeBranch, Declaration.Name, Reliability, "Patch")
			ModeBranch:Line(`local Value = table.clone({SnapshotName} or \{})`)
			ModeBranch:Iterator("Key", "PatchValue", "Patch")
				:Line("Value[Key] = if PatchValue == Tombstone then nil else PatchValue")
				:End()
			ModeBranch:Line(`{SnapshotName} = Value :: any`)
			ModeBranch:Line(`{VersionName} += 1`)
			ModeBranch:Iterator("_", "Listener", ConnectionsName)
				:Line(`task.spawn(Listener, {SnapshotName}, {VersionName}, Patch)`)
				:End()
		end

		ModeBranch:Branch("Default")
			:Line(`DropPacket({SourceExpression()}, "{Reliability}", "MalformedPacket", Size)`)
			:End()
		AddAfterReceive(Block, Declaration.Name, Reliability)

		local On = Blocks.Function(
			"On",
			`Listener: (Value: {Type}, Version: number, Patch: \{[string]: any}?) -> ()`,
			"() -> ()",
			true
		)
			:Line(`table.insert({ConnectionsName}, Listener)`)
			:Line("return function()")
			:Line(`local Index = table.find({ConnectionsName}, Listener)`, 2)
			:Line("if Index then", 2)
			:Line(`table.remove({ConnectionsName}, Index)`, 3)
			:Line("end", 2)
			:Line("end")
			:End()
		local Get = Blocks.Function("Get", "", `({Type}?)`, true):Return(SnapshotName):End()
		local Version = Blocks.Function("Version", "", "number", true):Return(VersionName):End()

		Noop.PushLines({
			"On = NOOP,\n",
			"Get = NOOP,\n",
			"Version = NOOP\n",
		}, 0, Indent + 1)
		Body.PushLines(On:Wrap("", ",").Content, 0, Indent + 1)
		Body.PushLines(Get:Wrap("", ",").Content, 0, Indent + 1)
		Body.PushLines(Version.Content, 0, Indent + 1)
	else
		UserTypes.PushLines(WriteFull, 1, 0)
		if WriteDelta then
			UserTypes.PushLines(WriteDelta, 1, 0)
		end

		Events.Push(`local {StateName}: \{[any]: any\} = \{}`)
		local DirtyName = `{LocalPrefix}_DIRTY`
		local KeyframeName = `{LocalPrefix}_KEYFRAMES`
		local LastFlushName = `{LocalPrefix}_LAST_FLUSH`
		local LastKeyframeName = `{LocalPrefix}_LAST_KEYFRAME`
		local MarkDirtyName = `{LocalPrefix}_MARK_DIRTY`
		local MarkFullName = `{LocalPrefix}_MARK_FULL`
		local FlushPlayerName = `{LocalPrefix}_FLUSH_PLAYER`
		local FlushAllName = `{LocalPrefix}_FLUSH_ALL`
		local FlushListName = `{LocalPrefix}_FLUSH_LIST`
		local FlushGroupName = `{LocalPrefix}_FLUSH_GROUP`
		local FlushZoneName = `{LocalPrefix}_FLUSH_ZONE`
		local FlushDistanceName = `{LocalPrefix}_FLUSH_DISTANCE`
		local SetZoneName = `{LocalPrefix}_SET_ZONE`
		local SetDistanceName = `{LocalPrefix}_SET_DISTANCE`
		local PatchZoneName = `{LocalPrefix}_PATCH_ZONE`
		local PatchDistanceName = `{LocalPrefix}_PATCH_DISTANCE`
		local SetInterestZoneName = `{LocalPrefix}_SET_INTEREST_ZONE`
		local SetInterestPositionName = `{LocalPrefix}_SET_INTEREST_POSITION`
		local AutoFlushName = `{LocalPrefix}_AUTO_FLUSH`
		local TickRate = Value.TickRate or 0
		local TickInterval = if TickRate > 0 then 1 / TickRate else 0
		local KeyframeRate = Value.KeyframeRate or 0
		local KeyframeInterval = if KeyframeRate > 0 then 1 / KeyframeRate else 0
		local DefaultInterestRadius = Value.InterestRadius or 0
		Events.Push(`local {DirtyName}: \{[Player]: \{[string]: any\}\} = \{}`)
		Events.Push(`local {KeyframeName}: \{[Player]: boolean\} = \{}`)
		Events.Push(`local {LastFlushName} = 0`)
		Events.Push(`local {LastKeyframeName} = 0`)

		local function AddSendBody(Target: string, FunctionBlock: Blocks.Block, Writer: string, Argument: string)
			FunctionBlock:Line(`if not IsPlayerActive({Target}) then return end`)
			if IsReliable then
				FunctionBlock:Line(`Load(PlayersMap[{Target}])`)
				AddTrackedWrite(
					FunctionBlock,
					Declaration.Name,
					Reliability,
					`{Writer}({Argument})`,
					Target,
					nil,
					`table.pack({Argument})`,
					Value.Priority,
					nil
				)
				FunctionBlock:Line(`PlayersMap[{Target}] = Save()`)
			else
				FunctionBlock:Line("Load()")
				AddTrackedWrite(
					FunctionBlock,
					Declaration.Name,
					Reliability,
					`{Writer}({Argument})`,
					Target,
					nil,
					`table.pack({Argument})`,
					Value.Priority,
					nil
				)
				FunctionBlock:Lines(UNRELIABLE_BODY, 1)
				FunctionBlock:Compare(
					"RuntimeConfig.MaxUnreliablePacketBytes > 0 and SendCursor",
					"RuntimeConfig.MaxUnreliablePacketBytes",
					"Greater"
				)
					:Line(`DropPacket({Target}, "Unreliable", "MaxPacketBytes", SendCursor)`)
					:Branch("Default")
					:Line(`Unreliable:FireClient({Target}, Buffer, InstancePayload(SendInstances))`)
					:Line(`TrackSend("Unreliable", SendCursor, {Target})`)
					:End()
			end
		end

		local SetPlayerName = `{LocalPrefix}_SET_PLAYER`
		local SetAllName = `{LocalPrefix}_SET_ALL`
		local SetListName = `{LocalPrefix}_SET_LIST`
		local SetGroupName = `{LocalPrefix}_SET_GROUP`
		local GetName = `{LocalPrefix}_GET`
		local ClearName = `{LocalPrefix}_CLEAR`

		local MarkDirty = Blocks.Function(MarkDirtyName, "Player: Player, Patch: {[string]: any}", "()", false, true)
			:Line(`local Dirty = {DirtyName}[Player]`)
		MarkDirty:Compare("Dirty", "nil", "Equals"):Line("Dirty = {}"):Line(`{DirtyName}[Player] = Dirty`):End()
		MarkDirty:Iterator("Key", "PatchValue", "Patch")
			:Line("Dirty[Key] = if PatchValue == nil then Tombstone else PatchValue")
			:End()
		MarkDirty:End()

		local MarkFull = Blocks.Function(MarkFullName, "Player: Player", "()", false, true)
			:Line(`{KeyframeName}[Player] = true`)
			:Line(`{DirtyName}[Player] = nil`)
			:End()

		local SetPlayer = Blocks.Function(SetPlayerName, `Player: Player, Value: {Type}`, "()", false, true)
			:Line("if not IsPlayerActive(Player) then return end")
			:Line(`{StateName}[Player] = Value`)
			:Line(`{MarkFullName}(Player)`)
			:End()

		local SetAll = Blocks.Function(SetAllName, `Value: {Type}`, "()", false, true)
			:Line(`{StateName}.__global = Value`)
			:Iterator("_", "Player", "Players:GetPlayers()")
			:Line(`{SetPlayerName}(Player, Value)`)
			:End()
			:End()

		local SetList = Blocks.Function(SetListName, `List: \{Player\}, Value: {Type}`, "()", false, true)
			:Iterator("_", "Player", "List")
			:Line(`{SetPlayerName}(Player, Value)`)
			:End()
			:End()

		local SetGroup = Blocks.Function(SetGroupName, `GroupName: string, Value: {Type}`, "()", false, true)
			:Iterator("_", "Player", "GetGroupPlayers(GroupName)")
			:Line(`{SetPlayerName}(Player, Value)`)
			:End()
			:End()

		local SetZone = Blocks.Function(SetZoneName, `ZoneName: string, Value: {Type}`, "()", false, true)
			:Iterator("_", "Player", `GetInterestZonePlayers("{Declaration.Name}", ZoneName)`)
			:Line(`{SetPlayerName}(Player, Value)`)
			:End()
			:End()

		local SetDistance =
			Blocks.Function(SetDistanceName, `Origin: Vector3, Value: {Type}, Radius: number?`, "()", false, true)
				:Line(`local EffectiveRadius = Radius or {NumberLiteral(DefaultInterestRadius, 0)}`)
				:Iterator("_", "Player", `GetInterestDistancePlayers("{Declaration.Name}", Origin, EffectiveRadius)`)
				:Line(`{SetPlayerName}(Player, Value)`)
				:End()
				:End()

		local SetInterestZone =
			Blocks.Function(SetInterestZoneName, "Player: Player, ZoneName: string?", "()", false, true)
				:Line(`SetInterestZone("{Declaration.Name}", Player, ZoneName)`)
				:End()

		local SetInterestPosition =
			Blocks.Function(SetInterestPositionName, "Player: Player, Position: Vector3?", "()", false, true)
				:Line(`SetInterestPosition("{Declaration.Name}", Player, Position)`)
				:End()

		Events.PushLines(MarkDirty.Content)
		Events.PushLines(MarkFull.Content)
		Events.PushLines(SetPlayer.Content)
		Events.PushLines(SetAll.Content)
		Events.PushLines(SetList.Content)
		Events.PushLines(SetGroup.Content)
		Events.PushLines(SetZone.Content)
		Events.PushLines(SetDistance.Content)
		Events.PushLines(SetInterestZone.Content)
		Events.PushLines(SetInterestPosition.Content)

		local PrimarySet = if Value.Interest == "Zone"
			then SetZoneName
			elseif Value.Interest == "Distance" then SetDistanceName
			elseif Value.Scope == "Global" then SetAllName
			elseif Value.Scope == "Group" then SetGroupName
			else SetPlayerName
		Body.Push(`Set = {PrimarySet},`, 0, Indent + 1)
		Body.Push(`SetPlayer = {SetPlayerName},`, 0, Indent + 1)
		Body.Push(`SetAll = {SetAllName},`, 0, Indent + 1)
		Body.Push(`SetList = {SetListName},`, 0, Indent + 1)
		Body.Push(`SetGroup = {SetGroupName},`, 0, Indent + 1)
		Body.Push(`SetZone = {SetZoneName},`, 0, Indent + 1)
		Body.Push(`SetDistance = {SetDistanceName},`, 0, Indent + 1)
		Body.Push(`SetInterestZone = {SetInterestZoneName},`, 0, Indent + 1)
		Body.Push(`SetInterestPosition = {SetInterestPositionName},`, 0, Indent + 1)

		local PatchPlayerName = `{LocalPrefix}_PATCH_PLAYER`
		local PatchAllName = `{LocalPrefix}_PATCH_ALL`
		local PatchListName = `{LocalPrefix}_PATCH_LIST`
		local PatchGroupName = `{LocalPrefix}_PATCH_GROUP`

		local PatchPlayer =
			Blocks.Function(PatchPlayerName, "Player: Player, Patch: {[string]: any}", "()", false, true)
				:Line("if not IsPlayerActive(Player) then return end")
				:Line(`local Value = table.clone({StateName}[Player] or \{})`)
				:Iterator("Key", "PatchValue", "Patch")
				:Line("Value[Key] = if PatchValue == Tombstone then nil else PatchValue")
				:End()
				:Line(`{StateName}[Player] = Value`)
				:Line(if WriteDelta then `{MarkDirtyName}(Player, Patch)` else `{MarkFullName}(Player)`)
				:End()

		local PatchAll = Blocks.Function(PatchAllName, "Patch: {[string]: any}", "()", false, true)
			:Iterator("_", "Player", "Players:GetPlayers()")
			:Line(`{PatchPlayerName}(Player, Patch)`)
			:End()
			:End()

		local PatchList = Blocks.Function(PatchListName, "List: {Player}, Patch: {[string]: any}", "()", false, true)
			:Iterator("_", "Player", "List")
			:Line(`{PatchPlayerName}(Player, Patch)`)
			:End()
			:End()

		local PatchGroup =
			Blocks.Function(PatchGroupName, "GroupName: string, Patch: {[string]: any}", "()", false, true)
				:Iterator("_", "Player", "GetGroupPlayers(GroupName)")
				:Line(`{PatchPlayerName}(Player, Patch)`)
				:End()
				:End()

		local PatchZone = Blocks.Function(PatchZoneName, "ZoneName: string, Patch: {[string]: any}", "()", false, true)
			:Iterator("_", "Player", `GetInterestZonePlayers("{Declaration.Name}", ZoneName)`)
			:Line(`{PatchPlayerName}(Player, Patch)`)
			:End()
			:End()

		local PatchDistance = Blocks.Function(
			PatchDistanceName,
			"Origin: Vector3, Patch: {[string]: any}, Radius: number?",
			"()",
			false,
			true
		)
			:Line(`local EffectiveRadius = Radius or {NumberLiteral(DefaultInterestRadius, 0)}`)
			:Iterator("_", "Player", `GetInterestDistancePlayers("{Declaration.Name}", Origin, EffectiveRadius)`)
			:Line(`{PatchPlayerName}(Player, Patch)`)
			:End()
			:End()

		Events.PushLines(PatchPlayer.Content)
		Events.PushLines(PatchAll.Content)
		Events.PushLines(PatchList.Content)
		Events.PushLines(PatchGroup.Content)
		Events.PushLines(PatchZone.Content)
		Events.PushLines(PatchDistance.Content)

		local PrimaryPatch = if Value.Interest == "Zone"
			then PatchZoneName
			elseif Value.Interest == "Distance" then PatchDistanceName
			elseif Value.Scope == "Global" then PatchAllName
			elseif Value.Scope == "Group" then PatchGroupName
			else PatchPlayerName
		Body.Push(`Patch = {PrimaryPatch},`, 0, Indent + 1)
		Body.Push(`PatchPlayer = {PatchPlayerName},`, 0, Indent + 1)
		Body.Push(`PatchAll = {PatchAllName},`, 0, Indent + 1)
		Body.Push(`PatchList = {PatchListName},`, 0, Indent + 1)
		Body.Push(`PatchGroup = {PatchGroupName},`, 0, Indent + 1)
		Body.Push(`PatchZone = {PatchZoneName},`, 0, Indent + 1)
		Body.Push(`PatchDistance = {PatchDistanceName},`, 0, Indent + 1)

		local FlushPlayer = Blocks.Function(FlushPlayerName, "Player: Player, ForceFull: boolean?", "()", false, true)
			:Line("if not IsPlayerActive(Player) then return end")
			:Line(`local Value = {StateName}[Player]`)
			:Line("if Value == nil then return end")
			:Line(`local SendFull = ForceFull == true or {KeyframeName}[Player] == true`)
		if WriteDelta then
			local FullBranch = FlushPlayer:Compare("SendFull", "true", "Equals")
			AddSendBody("Player", FullBranch, WriteFullPath, "Value")
			FullBranch:Line(`{KeyframeName}[Player] = nil`)
			FullBranch:Line(`{DirtyName}[Player] = nil`)
			FullBranch:Line("return")
			FullBranch:End()
			FlushPlayer:Line(`local Patch = {DirtyName}[Player]`)
			FlushPlayer:Line("if Patch == nil or next(Patch) == nil then return end")
			AddSendBody("Player", FlushPlayer, WriteDeltaPath, "Patch")
			FlushPlayer:Line(`{DirtyName}[Player] = nil`)
		else
			local FullBranch = FlushPlayer:Compare("SendFull", "true", "Equals")
			AddSendBody("Player", FullBranch, WriteFullPath, "Value")
			FullBranch:Line(`{KeyframeName}[Player] = nil`)
			FullBranch:End()
		end
		FlushPlayer:End()

		local FlushAll = Blocks.Function(FlushAllName, "ForceFull: boolean?", "()", false, true)
			:Iterator("_", "Player", "Players:GetPlayers()")
			:Line(`{FlushPlayerName}(Player, ForceFull)`)
			:End()
			:End()
		local FlushList = Blocks.Function(FlushListName, "List: {Player}, ForceFull: boolean?", "()", false, true)
			:Iterator("_", "Player", "List")
			:Line(`{FlushPlayerName}(Player, ForceFull)`)
			:End()
			:End()
		local FlushGroup = Blocks.Function(FlushGroupName, "GroupName: string, ForceFull: boolean?", "()", false, true)
			:Iterator("_", "Player", "GetGroupPlayers(GroupName)")
			:Line(`{FlushPlayerName}(Player, ForceFull)`)
			:End()
			:End()
		local FlushZone = Blocks.Function(FlushZoneName, "ZoneName: string, ForceFull: boolean?", "()", false, true)
			:Iterator("_", "Player", `GetInterestZonePlayers("{Declaration.Name}", ZoneName)`)
			:Line(`{FlushPlayerName}(Player, ForceFull)`)
			:End()
			:End()
		local FlushDistance = Blocks.Function(
			FlushDistanceName,
			"Origin: Vector3, Radius: number?, ForceFull: boolean?",
			"()",
			false,
			true
		)
			:Line(`local EffectiveRadius = Radius or {NumberLiteral(DefaultInterestRadius, 0)}`)
			:Iterator("_", "Player", `GetInterestDistancePlayers("{Declaration.Name}", Origin, EffectiveRadius)`)
			:Line(`{FlushPlayerName}(Player, ForceFull)`)
			:End()
			:End()

		local AutoFlush = Blocks.Function(AutoFlushName, "", "()", false, true):Line("local Now = os.clock()")
		if TickInterval > 0 then
			AutoFlush:Compare(`Now - {LastFlushName}`, tostring(TickInterval), "Less"):Line("return"):End()
		end
		AutoFlush:Line(`{LastFlushName} = Now`)
		AutoFlush:Line("local ForceFull = false")
		if KeyframeInterval > 0 then
			AutoFlush:Compare(`Now - {LastKeyframeName}`, tostring(KeyframeInterval), "GreaterOrEquals")
				:Line("ForceFull = true")
				:Line(`{LastKeyframeName} = Now`)
				:End()
		end
		AutoFlush:Line(`{FlushAllName}(ForceFull)`)
		AutoFlush:End()

		Events.PushLines(FlushPlayer.Content)
		Events.PushLines(FlushAll.Content)
		Events.PushLines(FlushList.Content)
		Events.PushLines(FlushGroup.Content)
		Events.PushLines(FlushZone.Content)
		Events.PushLines(FlushDistance.Content)
		Events.PushLines(AutoFlush.Content)
		Events.Push(`RegisterStateFlusher({AutoFlushName})`)

		local Get = Blocks.Function(GetName, "Player: Player?", `({Type}?)`, false, true)
			:Return(`if Player then {StateName}[Player] else {StateName}.__global`)
			:End()
		local Clear = Blocks.Function(ClearName, "Player: Player?", "()", false, true)
		Clear:Compare("Player", "nil", "Not")
			:Line(`{StateName}[Player] = nil`)
			:Line(`{DirtyName}[Player] = nil`)
			:Line(`{KeyframeName}[Player] = nil`)
			:Branch("Default")
			:Line(`table.clear({StateName})`)
			:Line(`table.clear({DirtyName})`)
			:Line(`table.clear({KeyframeName})`)
			:End()
		Clear:End()
		Events.PushLines(Get.Content)
		Events.PushLines(Clear.Content)
		Body.Push(`Flush = {FlushAllName},`, 0, Indent + 1)
		Body.Push(`FlushPlayer = {FlushPlayerName},`, 0, Indent + 1)
		Body.Push(`FlushAll = {FlushAllName},`, 0, Indent + 1)
		Body.Push(`FlushList = {FlushListName},`, 0, Indent + 1)
		Body.Push(`FlushGroup = {FlushGroupName},`, 0, Indent + 1)
		Body.Push(`FlushZone = {FlushZoneName},`, 0, Indent + 1)
		Body.Push(`FlushDistance = {FlushDistanceName},`, 0, Indent + 1)
		Body.Push(`Get = {GetName},`, 0, Indent + 1)
		Body.Push(`Clear = {ClearName}`, 0, Indent + 1)

		Noop.PushLines({
			"Set = NOOP,\n",
			"SetPlayer = NOOP,\n",
			"SetAll = NOOP,\n",
			"SetList = NOOP,\n",
			"SetGroup = NOOP,\n",
			"SetZone = NOOP,\n",
			"SetDistance = NOOP,\n",
			"SetInterestZone = NOOP,\n",
			"SetInterestPosition = NOOP,\n",
			"Patch = NOOP,\n",
			"PatchPlayer = NOOP,\n",
			"PatchAll = NOOP,\n",
			"PatchList = NOOP,\n",
			"PatchGroup = NOOP,\n",
			"PatchZone = NOOP,\n",
			"PatchDistance = NOOP,\n",
			"Flush = NOOP,\n",
			"FlushPlayer = NOOP,\n",
			"FlushAll = NOOP,\n",
			"FlushList = NOOP,\n",
			"FlushGroup = NOOP,\n",
			"FlushZone = NOOP,\n",
			"FlushDistance = NOOP,\n",
			"Get = NOOP,\n",
			"Clear = NOOP\n",
		}, 0, Indent + 1)
	end

	Channel.Count += 1
	if Context == "Client" then
		Channel.Listening = true
	end

	Noop.Push(`\},`, 0, Indent)
	Body.Push(`\},`, 0, Indent)
	Return.PushLines(Body.DumpLines(), 0)
end

function Declarations.Array(Declaration: Parser.Array, Read: Blocks.Block, Write: Blocks.Block, Variable: string)
	local Value = Declaration.Value
	local Of = Value.Of
	local Range = Value.Range :: NumberRange

	Read:Comment("START ARRAY")
	Write:Comment("START ARRAY")

	local Lower = Range.Min
	local Upper = Range.Max

	if Options.WriteValidations then
		Write:Compare(`typeof({Variable})`, `"table"`, "Not")
			:Line(`error(\`Expected {Variable} to be of type table, got \{typeof({Variable})} instead.\`)`)
			:End()
		Write:Compare(`#{Variable}`, tostring(Lower), "Less")
			:Line(`error(\`Expected length of "{Variable}" to be at least {Lower}, got \{#{Variable}} instead.\`)`)
			:End()
		Write:Compare(`#{Variable}`, tostring(Upper), "Greater")
			:Line(`error(\`Expected length of "{Variable}" to be at most {Upper}, got \{#{Variable}} instead.\`)`)
			:End()
	end

	local Iterator = `Item_{Read.Indent}`
	local IsVariableSize = (Lower ~= Upper)

	--> Length
	if IsVariableSize then
		local LengthBytes = Prefabs.GetLengthBytes(Upper)
		Read:Line(`local Length = ReadLength({LengthBytes})`)
		local Assert = Prefabs.Asserts.number("Length", Lower, Upper)

		Read:Line(Assert.Lower)
		Read:Line(Assert.Upper)
		Write:Line(`WriteLength(#{Variable}, {LengthBytes})`)
	else
		Read:Line(`local Length = {Upper}`)
	end

	--> Array
	Read:Line(`{Read:Declare(Variable)} = table.create(Length)`)

	--> Body
	Read = Read:Loop("Index = 1", "Length")
	Write = Write:Loop("Index = 1", IsVariableSize and `#{Variable}` or Upper)

	Write:Line(`local {Iterator} = {Variable}[Index]`)
	Generators.UserType(Of, Read, Write, Iterator)

	Read:Line(`table.insert({Variable}, {Iterator})`)

	--> End
	Read = Read:End()
	Write = Write:End()

	Read:Comment("END ARRAY")
	Write:Comment("END ARRAY")
end

function Declarations.Optional(Declaration: Parser.Optional, Read: Blocks.Block, Write: Blocks.Block, Variable: string)
	Read:Declare(Variable, true)

	local Of = Declaration.Value.Of
	local IsInstance = if Of.Type == "Primitive" then Of.Tokens.Primitive.Value == "Instance" else false

	if IsInstance then
		Read:Line("RecieveInstanceCursor += 1")
		Read = Read:Compare("typeof(RecieveInstances[RecieveInstanceCursor])", '"Instance"', "Equals")
		Read:Line("RecieveInstanceCursor -= 1")
	else
		Write:Line(`WriteBit({Variable} ~= nil and {Variable} ~= Tombstone)`)
		Read = Read:Compare("ReadBit()", "true", "Equals")
		Write = Write:Compare(Variable, "nil", "Not"):Compare(Variable, "Tombstone", "Not")
	end

	Generators.UserType(Declaration.Value.Of, Read, Write, Variable)
	Read:End()

	if not IsInstance then
		Write:End():End()
	end
end

--> Generator functions
function Generators.UserType(Declaration: Type, Read: Blocks.Block, Write: Blocks.Block, Variable: string?)
	local Name = Declaration.Name
	local Variable = Variable or "Value"

	if not _G.RELEASE then
		Read:Comment(`{Variable}: {Name}`)
		Write:Comment(`{Variable}: {Name}`)
	end

	if Declaration.Type == "Primitive" then
		local Kind = (Declaration :: Parser.Primitive).Tokens.Primitive.Value
		if Kind == "Instance" then
			Read:Line("RecieveInstanceCursor += 1")
		end

		Declarations.Primitive(Declaration, Read, Write, Variable)
	elseif Declaration.Type == "Set" then
		Declarations.Set(Declaration, Read, Write, Variable)
	elseif Declaration.Type == "Map" then
		Declarations.Map(Declaration, Read, Write, Variable)
	elseif Declaration.Type == "Enum" then
		Declarations.Enum(Declaration, Read, Write, Variable)
	elseif Declaration.Type == "Struct" then
		Declarations.Struct(Declaration, Read, Write, Variable)
	elseif Declaration.Type == "Tuple" then
		Declarations.Tuple(Declaration, Read, Write)
	elseif Declaration.Type == "TagEnum" then
		Declarations.TagEnum(Declaration, Read, Write, Variable)
	elseif Declaration.Type == "Array" then
		Declarations.Array(Declaration, Read, Write, Variable)
	elseif Declaration.Type == "Optional" then
		Declarations.Optional(Declaration, Read, Write, Variable)
	end
end

function Generators.LuauType(
	Declaration: Type,
	UseTypeAsValue: boolean?,
	Prefix: string?
): (string, string, string, string)
	Prefix = Prefix or ""

	local Type = "nil"
	local Values = "Value: nil"
	local Export = Util.GetExportName(Declaration.Name, Scope)
	local Returns = `{Prefix}Value`

	if Declaration.Type == "Primitive" then
		local Tokens = (Declaration :: Parser.Primitive).Tokens
		local Primitive = Primitives[Tokens.Primitive.Value]
		if type(Primitive.Type) == "function" then
			Type = Primitive.Type(Declaration :: Parser.Primitive)
		else
			Type = Primitive.Type
		end
	elseif Declaration.Type == "Set" then
		local Value = (Declaration :: Parser.Set).Value
		local Entries: { string } = {}

		for _, Flag in Value.Values do
			table.insert(Entries, `{FormatKey(Flag)}: boolean,`)
		end

		Type = `\{{table.concat(Entries)}\}`
	elseif Declaration.Type == "Enum" then
		local Value = (Declaration :: Parser.Enum).Value
		Type = `({Util.GenerateEnumLiterals(Value.Values)})`
	elseif Declaration.Type == "TagEnum" then
		local Value = (Declaration :: Parser.TagEnum).Value
		local Literals = {}

		for Index, Variant in Value.Values do
			local TagField = `{FormatKey(Value.Tag)}: "{Variant.Name}"`
			local ValueType = Generators.LuauType(Variant)
			table.insert(Literals, `\{ {TagField},{string.sub(ValueType, 2)}`)
		end

		Type = table.concat(Literals, " | ")
	elseif Declaration.Type == "Map" then
		local MapValue = (Declaration :: Parser.Map).Value
		local Key = Generators.LuauType(MapValue.Values[1])
		local Value = Generators.LuauType(MapValue.Values[2])
		Type = `\{[{Key}]: {Value}\}`
	elseif Declaration.Type == "Struct" then
		local Value = Declaration.Value
		local Fields = {}

		for _, Field in Value.Values do
			local Name = Field.Name
			local FieldType = Generators.LuauType(Field)
			table.insert(Fields, `{FormatKey(Name)}: {FieldType}`)
		end

		Type = `\{ {table.concat(Fields, ", ")}\ }`
	elseif Declaration.Type == "Generic" then
		Type = `{Declaration.Value.Generic}`
	elseif Declaration.Type == "Tuple" then
		local Value = (Declaration :: Parser.Tuple).Value

		local Types = { "nil" }
		local Variables = { "Value" }
		local AnnotatedVariables = { "Value: nil" }

		for Index, TupleValue in Value.Values do
			local Variable = `{Prefix}Value{Index}`
			local ValueType = Generators.LuauType(TupleValue)

			Types[Index] = ValueType
			Variables[Index] = Variable
			AnnotatedVariables[Index] = `{Variable}: {ValueType}`
		end

		Type = table.concat(Types, ", ")
		Values = table.concat(AnnotatedVariables, ", ")
		Returns = table.concat(Variables, ", ")
	elseif Declaration.Type == "Array" then
		local Value = Declaration.Value
		Type = `\{ {Generators.LuauType(Value.Of)} }`
	elseif Declaration.Type == "Optional" then
		local Value = Declaration.Value
		Type = `{Generators.LuauType(Value.Of)}?`
	end

	local Value = Declaration.Value

	if Value.Parameters then
		local Parameters = {}

		--> Generate luau types for parameters
		for Index, Parameter in Value.Parameters do
			local ParameterType = Generators.LuauType(Parameter)
			table.insert(Parameters, ParameterType)
		end

		--> Wrap in chevrons
		Type = `{Type}<{table.concat(Parameters, ",")}>`
	end

	--> Generalized type generation, works for everything except tuples
	if Declaration.Type ~= "Tuple" then
		Values = `{Prefix}Value: {UseTypeAsValue and Type or Export}`
	end

	return Type, Values, Export, Returns
end

function Generators.Type(Declaration: Type)
	local Value = Declaration.Value
	local Type, _, Export = Generators.LuauType(Declaration)

	local Generics = ""
	if Value.Generics then
		local Types = {}
		for _, Generic in Value.Generics.List do
			table.insert(Types, Generic)
		end

		Generics = `<{table.concat(Types, ",")}>`
	end

	--> Write luau export
	LuauTypes.PushMultiline(`export type {Export}{Generics} = {Type}`, 1, 0)
end

function Generators.Export(Declaration: Type)
	local Name = Declaration.Name
	local _, Values, Export, Returns = Generators.LuauType(Declaration)

	local Read = Blocks.Function(Casing.Read, "Buffer: buffer", `({Export})`, true)
	local Write = Blocks.Function(Casing.Write, `{Values}`, `(buffer)`, true)
	Read:DisableOperationOptimisations()
	Write:DisableOperationOptimisations()

	local Body = Builder.new()
	local Indent = Util.GetScopeIndent(Scope)
	Body.Push(`{Name} = \{`, 0, Indent)

	--> Overwrite buffer
	Read:Comment("Buffer overwrite")
	Write:Comment("Buffer overwrite")

	Read:Lines({
		"local PreviousCursor = RecieveCursor\n",
		"local PreviousBuffer = RecieveBuffer\n",
		"local PreviousSize = RecieveSize\n",
		"local PreviousFrameEnd = RecieveFrameEnd\n",
		"local PreviousFrameInstanceEnd = RecieveFrameInstanceEnd\n",
		"local PreviousBitByte = RecieveBitByte\n",
		"local PreviousBitCount = RecieveBitCount\n",
		"local PreviousStrings = RecieveStrings\n",
		"local PreviousNextStringId = NextRecieveStringId\n",
		"local PreviousInstances = RecieveInstances\n",
		"local PreviousInstanceCursor = RecieveInstanceCursor\n",
		"local PreviousPredictionId = RecievePredictionId\n",
		"RecieveCursor = 0\n",
		"RecieveBuffer = Buffer\n",
		"RecieveSize = buffer.len(Buffer)\n",
		"RecieveFrameEnd = 0\n",
		"RecieveFrameInstanceEnd = 0\n",
		"RecieveBitByte = 0\n",
		"RecieveBitCount = 0\n",
		"RecieveStrings = {}\n",
		"NextRecieveStringId = 1\n",
		"RecieveInstances = {}\n",
		"RecieveInstanceCursor = 0\n",
		"RecievePredictionId = nil\n",
	}, 1)

	Write:Lines({
		"local Previous = Save()\n",
		"Load()\n",
	}, 1)

	Read:Advance(#Read.Content - 1)
	Write:Advance(#Write.Content - 1)

	--> Write to buffer
	Read:Comment("Buffer read")
	Write:Comment("Buffer write")

	Generators.UserType(Declaration, Read, Write)

	--> Restore buffer
	Read:Comment("Buffer restore")
	Write:Comment("Buffer restore")

	Read:Lines({
		"RecieveCursor = PreviousCursor\n",
		"RecieveBuffer = PreviousBuffer\n",
		"RecieveSize = PreviousSize\n",
		"RecieveFrameEnd = PreviousFrameEnd\n",
		"RecieveFrameInstanceEnd = PreviousFrameInstanceEnd\n",
		"RecieveBitByte = PreviousBitByte\n",
		"RecieveBitCount = PreviousBitCount\n",
		"RecieveStrings = PreviousStrings\n",
		"NextRecieveStringId = PreviousNextStringId\n",
		"RecieveInstances = PreviousInstances\n",
		"RecieveInstanceCursor = PreviousInstanceCursor\n",
		"RecievePredictionId = PreviousPredictionId\n",
	}, 1)

	--> Trim buffer
	Write:Line("local Result = buffer.create(SendCursor)")
	Write:Line("buffer.copy(Result, 0, SendBuffer, 0, SendCursor)")

	Write:Line(`Load(Previous)`)

	--> End export
	Read:Return(Returns)
	Write:Return("Result")

	Read:End():Wrap("", ",")
	Write:End()

	Body.PushLines(Read.Content, 0, Indent + 1)
	Body.PushLines(Write.Content, 0, Indent + 1)
	Body.Push(`\},`, 0, Indent)

	local BodyLines = Body.DumpLines()

	Noop.PushLines(table.clone(BodyLines), 0, 0)
	Return.PushLines(BodyLines, 0, 0)
end

function Generators.Event(
	Data: Type?,
	Index: number,
	Identifier: string,
	Function: ("Data" | "Return")?
): ({ string }, { string })
	local Type, Values, _, Returns = "nil", "Value: nil", nil, "nil"
	if Data then
		Type, Values, _, Returns = Generators.LuauType(Data, true)
	end

	local Arguments = `{Values}{Function and ", InvocationIdentifier: number" or ""}`
	local Read = Blocks.Function(Util.GetPath(Identifier, false, Scope), "", `({Type})`)
	local Write = Blocks.Function(Util.GetPath(Identifier, true, Scope), Arguments, "()")
	Read:DisableOperationOptimisations()
	Write:DisableOperationOptimisations()

	if not _G.RELEASE then
		Write:Comment(`{Identifier} ({Index})`)
	end

	Write:Line(`local Frame = BeginMessage({Index})`)
	if Function then
		Types.u8.Write("InvocationIdentifier", Write)
		if Function == "Return" then
			Types.u8.Write("1", Write)
			Types.u8.Read("Success", Read)
			Read:Compare("Success", "1", "Not"):Line('error("Server encountered an error.")'):End()
		end
	end

	if Data then
		Generators.UserType(Data, Read, Write)
	end

	Write:Line("EndMessage(Frame)")
	return Read:Return(Returns):End().Content, Write:End().Content
end

function Generators.Scope(Declaration: Parser.ScopeNode)
	local Name = Declaration.Name
	local Value = Declaration.Value

	local Parent = Scope
	local NewScope = Value.Scope

	local Path = Util.GetScopePrefix(NewScope, true, Scope)
	local Indent = (#string.split(Path, ".") - 1)
	Path = string.sub(Path, 1, #Path - 1)

	Scope = NewScope
	Noop.Push(`{Name} = \{`, 0, Indent)
	Return.Push(`{Name} = \{`, 0, Indent)

	Generators.AbstractSyntaxTree(Value.Values)

	Noop.Push(`},`, 0, Indent)
	Return.Push(`},`, 0, Indent)
	Scope = Parent
end

function Generators.AbstractSyntaxTree(Tree: { Parser.Declaration })
	for Index, Declaration in Tree do
		if Context == "Shared" and IGNORED_TYPES_IN_SHARED[Declaration.Type] then
			continue
		end

		if Declaration.Type == "Scope" then
			Generators.Scope(Declaration :: Parser.ScopeNode)
		elseif Declaration.Type == "Event" then
			Declarations.Event(Declaration :: Parser.Event)
		elseif Declaration.Type == "Function" then
			Declarations.Function(Declaration :: Parser.Function)
		elseif Declaration.Type == "Channel" then
			Declarations.Channel(Declaration :: Parser.Channel)
		else
			if Declaration.Value.Export then
				Generators.Export(Declaration :: Type)
			end

			Generators.Type(Declaration :: Type)
		end
	end
end

local Generator = {}

function Generator.Reset()
	--> Setup new builders
	Noop = Builder.new()
	Events = Builder.new()
	UserTypes = Builder.new()
	LuauTypes = Builder.new()
	Return = Builder.new()

	--> Reset channels
	Channels.Reliable.Count = 0
	Channels.Unreliable.Count = 0
	Channels.Reliable.Listening = false
	Channels.Unreliable.Listening = false
end

function Generator.Generate(FileContext: Context, AbstractSyntaxTree: Parser.Body): string
	local Imports = Builder.new()

	Generator.Reset()
	Context = FileContext
	Options = AbstractSyntaxTree.Value.Options
	Casing = Settings.GetCasing((Options.Casing :: Settings.Case) or "Pascal")

	--> Setup noop
	Noop.Push(`if not RunService:IsRunning() then`)
	Noop.Push(`local NOOP = function() end`, 0, 1)
	Noop.Push(`local Returns = table.freeze(\{`, 0, 1)
	PushRuntimeApi(Noop, 2)

	--> Setup remote events
	local Signal = Context == "Client" and "OnClientEvent" or "OnServerEvent"
	local Arguments = (Context == "Server" and "Player: Player, " or "") .. "Buffer: buffer, Instances: {Instance}?"
	local ReliableProcessor = "ProcessReliablePacket"
	local UnreliableProcessor = "ProcessUnreliablePacket"

	Reliables = Blocks.Function(ReliableProcessor, Arguments, nil, nil, true)
	Unreliables = Blocks.Function(UnreliableProcessor, Arguments, nil, nil, true)

	Reliables:Lines(GetEventBody("Reliable"), 1)
	Unreliables:Lines(GetEventBody("Unreliable"), 1)

	if Options.SyncValidation then
		Reliables:Lines(EVENT_SYNC_VALIDATION, 1)
		Unreliables:Lines(EVENT_SYNC_VALIDATION, 1)
	end

	Reliables = Reliables:While("RecieveCursor < Size")
	Unreliables = Unreliables:While("RecieveCursor < Size")
	Reliables:Line("local FrameSuccess, Index = pcall(BeginReadMessage, Size)")
	Reliables:Line(
		"if not FrameSuccess then DropPacket("
			.. SourceExpression()
			.. ', "Reliable", "MalformedPacket", Size) RecoverMessage() continue end'
	)
	Reliables:Line("if Index == nil then continue end")
	Reliables:Line("if Index == CAPABILITY_HANDSHAKE_INDEX then")
	Reliables:Line(
		"RuntimeSupport.ReadCapabilityHandshake(" .. SourceExpression() .. ', "Reliable", Size)',
		Reliables.Indent + 1
	)
	Reliables:Line("EndReadMessage()", Reliables.Indent + 1)
	Reliables:Line("continue", Reliables.Indent + 1)
	Reliables:Line("end")
	Reliables:Line("if Index == PREDICTION_ACK_INDEX then")
	Reliables:Line("local AckSuccess, AckError = pcall(ReadPredictionAckPayload)", Reliables.Indent + 1)
	Reliables:Line(
		`if not AckSuccess then DropPacket({SourceExpression()}, "Reliable", "MalformedPacket", Size) RunHooks("Error", \{ Name = "$predictionAck", Source = {SourceExpression()}, Channel = "Reliable", Error = AckError \}) RecoverMessage() continue end`,
		Reliables.Indent + 1
	)
	Reliables:Line("EndReadMessage()", Reliables.Indent + 1)
	Reliables:Line("continue", Reliables.Indent + 1)
	Reliables:Line("end")
	Reliables:Line("if Index == CLIENT_SHIELD_INDEX then")
	Reliables:Line("local ShieldSuccess, ShieldError = pcall(ReadClientShieldPayload)", Reliables.Indent + 1)
	Reliables:Line(
		`if not ShieldSuccess then DropPacket({SourceExpression()}, "Reliable", "MalformedPacket", Size) RunHooks("Error", \{ Name = "$clientShield", Source = {SourceExpression()}, Channel = "Reliable", Error = ShieldError \}) RecoverMessage() continue end`,
		Reliables.Indent + 1
	)
	Reliables:Line("EndReadMessage()", Reliables.Indent + 1)
	Reliables:Line("continue", Reliables.Indent + 1)
	Reliables:Line("end")
	Unreliables:Line("local FrameSuccess, Index = pcall(BeginReadMessage, Size)")
	Unreliables:Line(
		"if not FrameSuccess then DropPacket("
			.. SourceExpression()
			.. ', "Unreliable", "MalformedPacket", Size) RecoverMessage() continue end'
	)
	Unreliables:Line("if Index == nil then continue end")
	Unreliables:Line("if Index == CAPABILITY_HANDSHAKE_INDEX then")
	Unreliables:Line(
		"RuntimeSupport.ReadCapabilityHandshake(" .. SourceExpression() .. ', "Unreliable", Size)',
		Unreliables.Indent + 1
	)
	Unreliables:Line("EndReadMessage()", Unreliables.Indent + 1)
	Unreliables:Line("continue", Unreliables.Indent + 1)
	Unreliables:Line("end")
	Unreliables:Line("if Index == PREDICTION_ACK_INDEX then")
	Unreliables:Line("local AckSuccess, AckError = pcall(ReadPredictionAckPayload)", Unreliables.Indent + 1)
	Unreliables:Line(
		`if not AckSuccess then DropPacket({SourceExpression()}, "Unreliable", "MalformedPacket", Size) RunHooks("Error", \{ Name = "$predictionAck", Source = {SourceExpression()}, Channel = "Unreliable", Error = AckError \}) RecoverMessage() continue end`,
		Unreliables.Indent + 1
	)
	Unreliables:Line("EndReadMessage()", Unreliables.Indent + 1)
	Unreliables:Line("continue", Unreliables.Indent + 1)
	Unreliables:Line("end")
	Unreliables:Line("if Index == CLIENT_SHIELD_INDEX then")
	Unreliables:Line("local ShieldSuccess, ShieldError = pcall(ReadClientShieldPayload)", Unreliables.Indent + 1)
	Unreliables:Line(
		`if not ShieldSuccess then DropPacket({SourceExpression()}, "Unreliable", "MalformedPacket", Size) RunHooks("Error", \{ Name = "$clientShield", Source = {SourceExpression()}, Channel = "Unreliable", Error = ShieldError \}) RecoverMessage() continue end`,
		Unreliables.Indent + 1
	)
	Unreliables:Line("EndReadMessage()", Unreliables.Indent + 1)
	Unreliables:Line("continue", Unreliables.Indent + 1)
	Unreliables:Line("end")

	--> Import async libraries
	if Options.FutureLibrary then
		Imports.Push(`local Future = require({Options.FutureLibrary})`)
	end

	if Options.PromiseLibrary then
		Imports.Push(`local Promise = require({Options.PromiseLibrary})`)
	end

	--> Replication
	local Replication = Builder.new()
	local Connections = Builder.new()
	Return.Push(`{Casing.StepReplication} = StepReplication,`, 1, 1)

	if not Options.ManualReplication then
		Replication.Push("RunService.Heartbeat:Connect(StepReplication)")
	end

	--> Parse declarations
	Generators.AbstractSyntaxTree(AbstractSyntaxTree.Value.Declarations)

	--> Generate context source
	local Source = Sources[Context]

	if Channels.Reliable.Listening then
		Reliables = Reliables:End()
	end

	if Channels.Unreliable.Listening then
		Unreliables = Unreliables:End()
	end

	Reliables:Line("EndReadMessage()")
	Unreliables:Line("EndReadMessage()")
	Reliables:Line("ProfileEnd()")
	Unreliables:Line("ProfileEnd()")
	Reliables = Reliables:End():End()
	Unreliables = Unreliables:End():End()

	local ReplayRaw =
		Blocks.Function("ReplayRawCapture", "Entries: {{[string]: any}}, SourceOverride: any?", nil, nil, true)
	ReplayRaw:Line("return RuntimeSupport.ReplayRawCapture(Entries, function(Entry, RawBuffer, RawInstances)")
	ReplayRaw:Line(`if Entry.Channel == "Unreliable" then`, 1)
	if Context == "Server" then
		ReplayRaw:Line(
			`{UnreliableProcessor}(SourceOverride or Entry.Source or SERVER_PEER_KEY, RawBuffer, RawInstances)`,
			2
		)
		ReplayRaw:Line("else", 1)
		ReplayRaw:Line(
			`{ReliableProcessor}(SourceOverride or Entry.Source or SERVER_PEER_KEY, RawBuffer, RawInstances)`,
			2
		)
	else
		ReplayRaw:Line(`{UnreliableProcessor}(RawBuffer, RawInstances)`, 2)
		ReplayRaw:Line("else", 1)
		ReplayRaw:Line(`{ReliableProcessor}(RawBuffer, RawInstances)`, 2)
	end
	ReplayRaw:Line("end", 1)
	ReplayRaw:Line("end)")
	ReplayRaw:End()

	Connections.Push(`Reliable.{Signal}:Connect({ReliableProcessor})`)
	Connections.Push(`Unreliable.{Signal}:Connect({UnreliableProcessor})`)
	PushRuntimeApi(Return, 1, "ReplayRawCapture")

	Noop.Push(`\})`, 0, 1)
	Noop.Push(`return Returns :: {EVENTS_TYPE}`, 0, 1)
	Noop.Push(`end`, 0, 0)

	Return.PushFront(`\nlocal Returns = table.freeze(\{`)
	Return.Push(`})`)

	local ScopeValidationBody = {}
	if Context ~= "Shared" then
		local RemoteScope = Options.RemoteScope or "CHEETO"
		ScopeValidationBody = {
			"_G._CHEETO = _G._CHEETO or {}\n",
			`if _G._CHEETO["{RemoteScope}"] then\n`,
			`\terror("[Cheeto]: An instance of cheeto is already running with the remote scope \\"{RemoteScope}\\". Change the remote scope of either instance to avoid conflicts.")\n`,
			"end\n",
			`_G._CHEETO["{RemoteScope}"] = true\n`,
		}
	end

	local MergedOutput = Table.Merge(
		DIRECTIVES,
		VERSION_HEADER,
		ScopeValidationBody,
		string.split(Source[1], "\r"),
		Imports.DumpLines(),
		{ "local SerdesFunctions = {}\n" },
		{ `local BASE_EVENT_NAME = "{Options.RemoteScope and Options.RemoteScope .. "_" or ""}CHEETO"\n` },
		RuntimeConfigLines(),
		string.split(Sources.Base, "\r"),
		(if Options.SyncValidation then SYNC_VALIDATION_BODY else {}),
		Events.DumpLines(),
		LuauTypes.DumpLines(),
		UserTypes.DumpLines(),
		Noop.DumpLines(),
		string.split(Source[2], "\r"),
		Replication.DumpLines(),
		Reliables.Content,
		Unreliables.Content,
		ReplayRaw.Content,
		Connections.DumpLines(),
		Return.DumpLines(),
		{ `type {EVENTS_TYPE} = typeof(Returns)\n`, `return Returns :: {EVENTS_TYPE}` }
	)

	return table.concat(MergedOutput)
end

function Generator.GenerateShared(AbstractSyntaxTree: Parser.Body): string
	Generator.Reset()
	Context = "Shared"
	Options = AbstractSyntaxTree.Value.Options
	Casing = Settings.GetCasing((Options.Casing :: Settings.Case) or "Pascal")

	--> Parse declarations
	Generators.AbstractSyntaxTree(AbstractSyntaxTree.Value.Declarations)

	--> Generate context source
	local Source = Sources[Context]
	local MergedOutput = Table.Merge(
		DIRECTIVES,
		VERSION_HEADER,
		string.split(Source[1], "\r"),
		RuntimeConfigLines(),
		string.split(Sources.Base, "\r"),
		LuauTypes.DumpLines(),
		{ "\n" },
		UserTypes.DumpLines(),
		string.split(Source[2], "\r"),
		{ "\n" },
		{ `\nreturn \{\n` },
		Return.DumpLines(),
		{ "\n}" }
	)

	return table.concat(MergedOutput)
end

function Generator.GenerateTypescript(FileContext: Context, AbstractSyntaxTree: Parser.Body): string
	return GenerateTypescript(FileContext, AbstractSyntaxTree)
end

return Generator
