local function IsValidIdentifier(Identifier: string): boolean
	return Identifier:match("%a%w*") == Identifier
end

local function FormatKey(Key: string): string
	if not IsValidIdentifier(Key) then
		return `["{Key}"]`
	end
	return Key
end

local function FormatIndex(Index: string): string
	if not IsValidIdentifier(Index) then
		return `["{Index}"]`
	end
	return `.{Index}`
end

local function BitIndexToHex(Index: number): string
	return `0x{string.format("%x", 2 ^ Index)}`
end

local function NumberLiteral(Value: number?, Default: number): string
	return tostring(if Value ~= nil then Value else Default)
end

local function BooleanLiteral(Value: boolean?, Default: boolean): string
	return if Value ~= nil then tostring(Value) else tostring(Default)
end

local function StringLiteral(Value: string?, Default: string): string
	return `"{Value or Default}"`
end

local function OptionalString(Value: string?): string
	return if Value == nil then "nil" else `"{Value}"`
end

