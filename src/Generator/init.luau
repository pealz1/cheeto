--> Endpoint numbers are one byte and 252-255 are control frames.
local MAX_ENDPOINTS_PER_CHANNEL = 252

local function CheckEndpointCapacity(Reliability: string, Count: number)
	if Count >= MAX_ENDPOINTS_PER_CHANNEL then
		error(
			`A schema can declare at most {MAX_ENDPOINTS_PER_CHANNEL} {string.lower(Reliability)} endpoints. Split the schema, or move endpoints to the other channel.`
		)
	end
end

local function SourceExpression(): string
	return if Context == "Server" then "Player" else '"Server"'
end

local function GetEventBody(Channel: string): { string }
	local Source = SourceExpression()
	local Body = {
		`ProfileBegin("Cheeto.Decode.{Channel}")\n`,
		`local Size = ValidateIncoming({Source}, "{Channel}", Buffer, Instances)\n`,
		"if Size == nil then\n",
		"\tProfileEnd()\n",
		"\treturn\n",
		"end\n",
	}

	if Channel == "Reliable" then
		table.insert(
			Body,
			`local ReassembledBuffer, ReassembledInstances, FragmentReady = RuntimeSupport.TryReassembleReliableFragment({Source}, Buffer, Instances)\n`
		)
		table.insert(Body, "if not FragmentReady then\n")
		table.insert(Body, "\tProfileEnd()\n")
		table.insert(Body, "\treturn\n")
		table.insert(Body, "end\n")
		table.insert(Body, "Buffer = ReassembledBuffer :: buffer\n")
		table.insert(Body, "Instances = ReassembledInstances\n")
		table.insert(Body, "Size = buffer.len(Buffer)\n")
		table.insert(Body, "State.RecieveSize = Size\n")
		table.insert(Body, "State.RecieveInstances = Instances or {}\n")
	end

	table.insert(Body, "Frame.BeginMessages(Buffer)\n")

	return Body
end

local function QueueLimit(Value: { [string]: any }): string
	return NumberLiteral(Value.MaxQueuedEvents, Options.MaxQueuedEvents or 256)
end

local function AbortReadLine(): string
	return "RecoverMessage() continue"
end

--> One definition of the constraints table, shared by the pre-decode policy check
--> and the post-decode Validate hook, so the two can never disagree about what a
--> constraint is called.
local function ConstraintsTable(Value: { [string]: any }): string
	return `table.freeze(\{ Risk = {OptionalString(Value.Risk)}, Auth = {OptionalString(Value.Auth)}, CooldownSeconds = {NumberLiteral(
		Value.CooldownSeconds,
		0
	)}, MaxDistance = {NumberLiteral(Value.MaxDistance, 0)}, RequireOwnership = {BooleanLiteral(
		Value.RequireOwnership,
		false
	)}, RequireTeam = {OptionalString(Value.RequireTeam)}, RequireZone = {OptionalString(Value.RequireZone)}, RequireMatch = {OptionalString(
		Value.RequireMatch
	)}, RequireInventoryOwnership = {BooleanLiteral(Value.RequireInventoryOwnership, false)}, RequireCharacterState = {OptionalString(
		Value.RequireCharacterState
	)}, RequireObjectHandle = {BooleanLiteral(Value.RequireObjectHandle, false)}, RequireServerKnownId = {BooleanLiteral(
		Value.RequireServerKnownId,
		false
	)}, Idempotency = {BooleanLiteral(Value.Idempotency, false)} \})`
end

--> Built once per endpoint at load, not once per packet: the receive path
--> used to allocate this table for every event it decoded.
local ConstraintsEmitted: { [string]: boolean } = {}

local function ConstraintsReference(Reliability: string, Index: number, Value: { [string]: any }): string
	local Key = `{Reliability}{Index}`
	if not ConstraintsEmitted[Key] then
		ConstraintsEmitted[Key] = true
		Events.Push(`EndpointConstraints.{Reliability}[{Index}] = {ConstraintsTable(Value)}`)
	end
	return `EndpointConstraints.{Reliability}[{Index}]`
end

--> Constraints that describe the PAYLOAD rather than the sender. Only these justify
--> emitting the post-decode Validate hook: the hook allocates a context table per
--> packet, and this runs on every event, so events that declare none of them must
--> not pay for it. Risk and RequireCharacterState are deliberately absent -- Risk is
--> a tag, and character state is known before decoding.
local PAYLOAD_CONSTRAINTS = {
	"MaxDistance",
	"RequireOwnership",
	"RequireTeam",
	"RequireZone",
	"RequireMatch",
	"RequireInventoryOwnership",
	"RequireObjectHandle",
	"RequireServerKnownId",
}

local function HasPayloadConstraint(Value: { [string]: any }): boolean
	for _, Key in PAYLOAD_CONSTRAINTS do
		local Declared = Value[Key]
		if Declared ~= nil and Declared ~= false and Declared ~= 0 then
			return true
		end
	end
	return false
end

--> TrustedSource is for the leg of a function that carries the SERVER'S REPLY back
--> to the client. Auth rules and policies are registered on the server, so emitting
--> them on that leg asks the client to evaluate a rule it has never heard of --
--> CheckAuth then fails closed and silently drops every response, which looks like
--> the invoke simply never returning. It is also meaningless on its own terms:
--> authenticating and rate-limiting the server's own reply protects nothing. The
--> size and decode caps DO still apply; those bound work, not permission.
local function AddReceiveGuards(
	Block: Blocks.Block,
	Name: string,
	Reliability: string,
	Index: number,
	Value: { [string]: any },
	TrustedSource: boolean?
)
	if TrustedSource then
		local Filtered = table.clone(Value)
		Filtered.Auth = nil
		Filtered.Policy = nil
		Filtered.PolicyGroup = nil
		Filtered.RateLimitPerSecond = 0
		Filtered.RateLimitBurst = 0
		Filtered.CooldownSeconds = nil
		Value = Filtered
	end

	local Source = SourceExpression()
	Block:Line("local EventStart = Frame.At()")
	--> Measured against this event's frame. Comparing the whole packet made a
	--> small cap drop the event whenever it shared a batch with large ones.
	if Value.MaxPacketBytes then
		Block:Line(
			`if Frame.MessageSize() > {Value.MaxPacketBytes} then DropPacket({Source}, "{Reliability}", "MaxPacketBytes", Size) {AbortReadLine()} end`
		)
	end

	--> Honeypot: nothing legitimate ever sends this, because nothing legitimate
	--> knows it exists. Arriving traffic is proof the sender fabricated a packet,
	--> so it is reported at a weight that stands out from ordinary drops and then
	--> dropped before the payload is read. First guard after the size cap: a
	--> honeypot must not be rate-limited into silence, since the report is the
	--> entire point of the endpoint.
	--> DropPacket already raises the violation, so there is nothing to add here
	--> beyond the reason -- same shape as the KillSwitch and PolicyRejected guards.
	if Value.Honeypot then
		Block:Line(
			`if RuntimeConfig.EnableHoneypots then DropPacket({Source}, "{Reliability}", "Honeypot", Size) {AbortReadLine()} end`
		)
	end

	Block:Line(
		`if not CheckRateLimit({Source}, "{Name}", {NumberLiteral(
			Value.RateLimitPerSecond,
			Options.RateLimitPerSecond or 0
		)}, {NumberLiteral(Value.RateLimitBurst, Options.RateLimitBurst or Options.RateLimitPerSecond or 0)}) then {AbortReadLine()} end`
	)
	Block:Line(
		`if not RunHooks("BeforeReceive", \{ Name = "{Name}", Source = {Source}, Channel = "{Reliability}", Size = Size \}) then DropPacket({Source}, "{Reliability}", "MiddlewareRejected", Size) {AbortReadLine()} end`
	)
	if Value.Auth then
		Block:Line(
			`if not CheckAuth("{Value.Auth}", \{ Name = "{Name}", Source = {Source}, Channel = "{Reliability}", Size = Size \}) then DropPacket({Source}, "{Reliability}", "AuthRejected", Size) {AbortReadLine()} end`
		)
	end
	Block:Line(
		`if not CheckPolicy({Source}, "{Name}", "{Reliability}", {OptionalString(Value.Policy)}, {OptionalString(
			Value.PolicyGroup
		)}, {ConstraintsReference(Reliability, Index, Value)}, Size) then {AbortReadLine()} end`
	)
end

local function AddAfterReceive(
	Block: Blocks.Block,
	Name: string,
	Reliability: string,
	Index: number,
	PayloadExpression: string?,
	Value: { [string]: any }?
)
	local Source = SourceExpression()
	Block:Line(
		`if not RuntimeSupport.ValidateDecodedPayload("{Name}", {Source}, "{Reliability}", {PayloadExpression or "nil"}, Size) then {AbortReadLine()} end`
	)

	--> The Validate hook: the ONE place a constraint about the decoded payload can be
	--> enforced. Policies and BeforeReceive both run before the payload exists, which
	--> is why MaxDistance, RequireOwnership, RequireTeam, RequireZone, RequireMatch,
	--> RequireInventoryOwnership, RequireObjectHandle and RequireServerKnownId were
	--> parsed, handed to policies and enforced by nothing.
	-->
	--> Emitted only for events that actually declare one of those, so an event that
	--> does not is byte-for-byte what it was before -- this is the receive path for
	--> every packet in the game and the context table is a per-packet allocation.
	if Value ~= nil and HasPayloadConstraint(Value) then
		Block:Line(
			`if not RunHooks("Validate", \{ Name = "{Name}", Source = {Source}, Channel = "{Reliability}", Size = Size, Constraints = {ConstraintsReference(
				Reliability,
				Index,
				Value
			)}, Payload = {PayloadExpression or "nil"} \}) then DropPacket({Source}, "{Reliability}", "ConstraintRejected", Size) {AbortReadLine()} end`
		)
	end
	Block:Line(
		`TrackEventReceive("{Name}", "{Reliability}", Frame.At() - EventStart, {Source}, {PayloadExpression or "nil"})`
	)
	if Context == "Server" then
		Block:Line("if Frame.HasPredictionId() then")
		Block:Line("Load(PlayersMap[Player])", Block.Indent + 1)
		Block:Line(`WritePredictionAckPayload("{Name}", true, nil)`, Block.Indent + 1)
		Block:Line("PlayersMap[Player] = Save()", Block.Indent + 1)
		Block:Line("end")
	end
end

--> A bare Read(1) throws straight out of the packet loop when the frame is
--> short, which strands every later message in the same packet -- including a
--> function reply, whose invocation then sits until it times out, and the
--> trailing ProfileEnd() never runs, so the profiler depth leaks. Every other
--> decode in this loop drops and recovers instead; these two single-byte reads
--> were the only ones left unguarded.
local function AddGuardedByteRead(Block: Blocks.Block, Variable: string, Reliability: string)
	local Source = SourceExpression()
	local OkName = `{Variable}Ok`
	Block:Line(`local {OkName}, {Variable} = pcall(function() return buffer.readu8(State.RecieveBuffer, Read(1)) end)`)
	local Failure = Block:Compare(OkName, "true", "Not")
	Failure:Line(`DropPacket({Source}, "{Reliability}", "MalformedPacket", Size)`)
	Failure:Line(AbortReadLine())
	Failure:End()
end

local function AddDecodeFailureGuard(Block: Blocks.Block, Name: string, Reliability: string, ErrorExpression: string)
	local Source = SourceExpression()
	local Failure = Block:Compare("Success", "true", "Not")
	Failure:Line(`DropPacket({Source}, "{Reliability}", "MalformedPacket", Size)`)
	Failure:Line(
		`RunHooks("Error", \{ Name = "{Name}", Source = {Source}, Channel = "{Reliability}", Error = {ErrorExpression} \})`
	)
	if Context == "Server" then
		Failure:Line("if Frame.HasPredictionId() then")
		Failure:Line("Load(PlayersMap[Player])", Failure.Indent + 1)
		Failure:Line(`WritePredictionAckPayload("{Name}", false, "MalformedPacket")`, Failure.Indent + 1)
		Failure:Line("PlayersMap[Player] = Save()", Failure.Indent + 1)
		Failure:Line("end")
	end
	Failure:Line(AbortReadLine())
	Failure:End()
end

local function WriteEventCall(
	Name: string,
	Reliability: string,
	Target: string,
	Accounting: string,
	Priority: string,
	PredictionId: string,
	Writer: string,
	Arguments: string
): string
	return `RuntimeSupport.WriteEvent("{Name}", "{Reliability}", {Target}, {Accounting}, "{Priority}", {PredictionId}, {Writer}, {Arguments})`
end

