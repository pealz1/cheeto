--!strict

local Parser = require("../Parser")
local Settings = require("../Settings")

local Prefabs = require("./Prefabs")
local Util = require("./Util")

local Builder = require("../Modules/Builder")

type Type = Parser.TypeNode
type Scope = Parser.Scope
type Context = "Client" | "Server" | "Shared"
type AbstractSyntaxTree = Parser.Body

type State = {
	Scope: Scope,
	Indent: number,
	Casing: Settings.Cases,
	Builder: Builder.Builder,
	Context: Context,
	Options: Parser.Options,
}

--> Stand-ins for the roblox-ts globals, so a development build can be
--> type-checked on its own. Release builds rely on @rbxts/types instead.
local TESTING_HEADER = table.concat({
	"type Instance = { readonly ClassName: string }",
	"type Player = Instance",
	"type Sound = Instance",
	"type CFrame = { readonly Position: Vector3 }",
	"type Vector3 = { readonly X: number, readonly Y: number, readonly Z: number }",
	"type Color3 = { readonly R: number, readonly G: number, readonly B: number }",
	"type buffer = { readonly __buffer: never }",
	"type DateTime = { readonly UnixTimestamp: number }",
	"type BrickColor = { readonly Number: number }",
	"type LuaTuple<T extends unknown[]> = T",
	"type IterableFunction<T> = () => T",
	"",
}, "\n")

local VERSION_HEADER =
	`// File generated by Cheeto v{_G.VERSION or "0.0.0"} (https://github.com/pealz1/cheeto)\n// This file is not meant to be edited\n`

