local Generators = {}
local Primitives = Prefabs.Primitives

local function IsValidIdentifier(Identifier: string): boolean
	return Identifier:match("%a%w*") == Identifier
end

local function FormatKey(Key: string): string
	if IsValidIdentifier(Key) then
		return Key
	end
	return `["{Key}"]`
end

--> `declare` at the top level; inside a namespace the declaration is already
--> ambient. Everything is exported so a consumer can name it.
local function Declare(Indent: number): string
	return if Indent == 0 then "export declare " else "export "
end

--> With UseColon, endpoints are called with `:`, which roblox-ts models as
--> methods rather than function-valued properties.
local function Member(State: State, Name: string, Parameters: string, Returns: string): string
	if State.Options.UseColon then
		return `{Name}({Parameters}): {Returns}`
	end
	return `{Name}: ({Parameters}) => {Returns}`
end

local function GetTypescriptType(State: State, Declaration: Type): (string, string)
	local Type = ""
	local Values = ""

	if Declaration.Type == "Primitive" then
		local Tokens = (Declaration :: Parser.Primitive).Tokens
		local Primitive = Primitives[Tokens.Primitive.Value]
		if type(Primitive.Type) == "function" then
			Type = Primitive.Type(Declaration :: Parser.Primitive)
		else
			Type = Primitive.Type
		end

		if Type == "any" then
			Type = "unknown"
		end
	elseif Declaration.Type == "Set" then
		local Value = (Declaration :: Parser.Set).Value
		local Entries: { string } = {}

		for _, Flag in Value.Values do
			table.insert(Entries, `{FormatKey(Flag)}: boolean`)
		end

		Type = `\{ {table.concat(Entries, ", ")} \}`
	elseif Declaration.Type == "Enum" then
		local Value = (Declaration :: Parser.Enum).Value
		Type = Util.GenerateEnumLiterals(Value.Values)
	elseif Declaration.Type == "TagEnum" then
		local Value = (Declaration :: Parser.TagEnum).Value
		local Literals = {}

		for _, Variant in Value.Values do
			local TagField = `{FormatKey(Value.Tag)}: "{Variant.Name}"`
			local ValueType = GetTypescriptType(State, Variant)
			table.insert(Literals, `\{ {TagField},{string.sub(ValueType, 2)}`)
		end

		Type = table.concat(Literals, " | ")
	elseif Declaration.Type == "Map" then
		local MapValue = (Declaration :: Parser.Map).Value
		local Key = GetTypescriptType(State, MapValue.Values[1])
		local Value = GetTypescriptType(State, MapValue.Values[2])
		--> Through globalThis: a schema type called Map would otherwise shadow
		--> the global inside its own namespace.
		Type = `globalThis.Map<{Key}, {Value}>`
	elseif Declaration.Type == "Struct" then
		local Value = Declaration.Value
		local Fields = {}

		for _, Field in Value.Values do
			local Name = Field.Name
			local FieldType = GetTypescriptType(State, Field)
			local Optional = Field.Type == "Optional" and "?" or ""
			table.insert(Fields, `{FormatKey(Name)}{Optional}: {FieldType}`)
		end

		Type = `\{ {table.concat(Fields, ", ")} \}`
	elseif Declaration.Type == "Generic" then
		Type = `{Declaration.Value.Generic}`
	elseif Declaration.Type == "Tuple" then
		local Value = (Declaration :: Parser.Tuple).Value
		local Types = {}
		local VariableTypes = {}

		for Index, TupleValue in Value.Values do
			local ValueType = GetTypescriptType(State, TupleValue)
			table.insert(Types, ValueType)
			table.insert(VariableTypes, `Value{Index}: {ValueType}`)
		end

		Type = table.concat(Types, ", ")
		Values = table.concat(VariableTypes, ", ")
	elseif Declaration.Type == "Array" then
		local Value = Declaration.Value
		Type = `({GetTypescriptType(State, Value.Of)})[]`
	elseif Declaration.Type == "Optional" then
		local Value = Declaration.Value
		Type = `{GetTypescriptType(State, Value.Of)} | undefined`
	end

	local Value = Declaration.Value
	if Value.Parameters then
		local Parameters = {}
		for _, Parameter in Value.Parameters do
			table.insert(Parameters, (GetTypescriptType(State, Parameter)))
		end
		Type = `{Type}<{table.concat(Parameters, ", ")}>`
	end

	if Declaration.Type ~= "Tuple" then
		Values = `Value: {Type}`
	else
		Type = `LuaTuple<[{Type}]>`
	end

	return Type, Values
end

--> The payload's types as a comma list, for tuple positions.
local function PayloadTypes(State: State, Data: Type?): string
	if Data == nil then
		return ""
	elseif Data.Type == "Tuple" then
		local Types = {}
		for _, Child in (Data :: Parser.Tuple).Value.Values do
			table.insert(Types, (GetTypescriptType(State, Child)))
		end
		return table.concat(Types, ", ")
	end
	return (GetTypescriptType(State, Data))
end

--> Parameters of a payload: `Value: T`, the tuple's values, or nothing.
local function PayloadParameters(State: State, Data: Type?): (string, string)
	if Data == nil then
		return "void", ""
	end

	local Type, Values = GetTypescriptType(State, Data)
	return Type, Values
end

local function Join(...: string): string
	local Parts = {}
	for Index = 1, select("#", ...) do
		local Part = select(Index, ...)
		if Part ~= "" then
			table.insert(Parts, Part)
		end
	end
	return table.concat(Parts, ", ")
end

function Generators.Type(State: State, Type: Type)
	local Value = Type.Value
	local Generics = ""
	if Value.Generics then
		Generics = `<{table.concat(Value.Generics.List, ", ")}>`
	end

	local TypescriptType = GetTypescriptType(State, Type)
	State.Builder.Push(`export type {Type.Name}{Generics} = {TypescriptType}`, 0, State.Indent)
end

function Generators.Export(State: State, Type: Type)
	local Indent = State.Indent
	local Casing = State.Casing
	local Types, Values = GetTypescriptType(State, Type)
	State.Builder.Push(`{Declare(Indent)}const {Type.Name}: \{`, 0, Indent)
	State.Builder.Push(Member(State, Casing.Read, "Buffer: buffer", Types), 0, Indent + 1)
	State.Builder.Push(Member(State, Casing.Write, Values, "buffer"), 0, Indent + 1)
	State.Builder.Push(`\}`, 0, Indent)
end

function Generators.Function(State: State, Function: Parser.Function)
	local Value = Function.Value
	local Indent = State.Indent
	local Casing = State.Casing
	local StringBuilder = State.Builder

	local _, Values = PayloadParameters(State, Value.Data)
	local ReturnTypes = if Value.Return then (GetTypescriptType(State, Value.Return)) else "void"

	StringBuilder.Push(`{Declare(Indent)}const {Function.Name}: \{`, 0, Indent)
	if State.Context == "Server" then
		StringBuilder.Push(
			Member(
				State,
				Casing.On,
				`Listener: ({Join("Player: Player", Values)}) => {ReturnTypes}`,
				"CheetoDisconnect"
			),
			0,
			Indent + 1
		)
	else
		local Returns = if Value.Yield == "Promise"
			then `Promise<{ReturnTypes}>`
			elseif Value.Yield == "Future" then `CheetoFuture<{ReturnTypes}>`
			else ReturnTypes
		StringBuilder.Push(Member(State, Casing.Invoke, Values, Returns), 0, Indent + 1)
	end
	StringBuilder.Push(`\}`, 0, Indent)
end

function Generators.Event(State: State, Event: Parser.Event)
	local Value = Event.Value
	local Indent = State.Indent
	local Casing = State.Casing
	local StringBuilder = State.Builder

	local IsPolling = Value.Call == "Polling" or State.Options.UsePolling
	local _, Values = PayloadParameters(State, Value.Data)
	local ListenerValues = if Value.From == "Client" then Join("Player: Player", Values) else Values

	StringBuilder.Push(`{Declare(Indent)}const {Event.Name}: \{`, 0, Indent)
	if Value.From == State.Context then
		if Value.From == "Server" then
			StringBuilder.Push(Member(State, Casing.Fire, Join("Player: Player", Values), "void"), 0, Indent + 1)
			StringBuilder.Push(Member(State, Casing.FireAll, Values, "void"), 0, Indent + 1)
			StringBuilder.Push(Member(State, Casing.FireList, Join("List: Player[]", Values), "void"), 0, Indent + 1)
			StringBuilder.Push(Member(State, Casing.FireExcept, Join("Except: Player", Values), "void"), 0, Indent + 1)
			StringBuilder.Push(
				Member(State, Casing.FireGroup, Join("GroupName: string", Values), "void"),
				0,
				Indent + 1
			)
		else
			StringBuilder.Push(Member(State, Casing.Fire, Values, "void"), 0, Indent + 1)
			if State.Options.EnablePrediction ~= false or Value.Predict then
				StringBuilder.Push(Member(State, Casing.Predict, Values, "number"), 0, Indent + 1)
			end
		end
	elseif IsPolling then
		local Yielded = `LuaTuple<[{Join(
			"number",
			if Value.From == "Client" then "Player" else "",
			PayloadTypes(State, Value.Data)
		)}]>`
		StringBuilder.Push(Member(State, Casing.Iter, "", `IterableFunction<{Yielded}>`), 0, Indent + 1)
	else
		StringBuilder.Push(
			Member(State, Casing.On, `Listener: ({ListenerValues}) => void`, "CheetoDisconnect"),
			0,
			Indent + 1
		)
	end
	StringBuilder.Push(`\}`, 0, Indent)
end

function Generators.Channel(State: State, Channel: Parser.Channel)
	local Value = Channel.Value
	local Indent = State.Indent
	local StringBuilder = State.Builder
	local Type = GetTypescriptType(State, Value.Data)
	local Patch = `Partial<{Type}>`

	StringBuilder.Push(`{Declare(Indent)}const {Channel.Name}: \{`, 0, Indent)
	local Members: { { string } }
	if State.Context == "Client" then
		Members = {
			{ "On", `Listener: (Value: {Type}, Version: number, Patch?: {Patch}) => void`, "CheetoDisconnect" },
			{ "Get", "", `{Type} | undefined` },
			{ "Version", "", "number" },
		}
	else
		Members = {
			{ "Set", "Target: any, Value: " .. Type, "void" },
			{ "SetPlayer", `Player: Player, Value: {Type}`, "void" },
			{ "SetAll", `Value: {Type}`, "void" },
			{ "SetList", `List: Player[], Value: {Type}`, "void" },
			{ "SetGroup", `Group: string, Value: {Type}`, "void" },
			{ "SetZone", `Zone: string, Value: {Type}`, "void" },
			{ "SetDistance", `Origin: Vector3, Value: {Type}, Radius?: number`, "void" },
			{ "SetScope", `Kind: string, Key: unknown, Value: {Type}`, "void" },
			{ "SetInterestZone", "Player: Player, Zone?: string", "void" },
			{ "SetInterestPosition", "Player: Player, Position?: Vector3", "void" },
			{ "Patch", `Target: any, Patch: {Patch}`, "void" },
			{ "PatchPlayer", `Player: Player, Patch: {Patch}`, "void" },
			{ "PatchAll", `Patch: {Patch}`, "void" },
			{ "PatchList", `List: Player[], Patch: {Patch}`, "void" },
			{ "PatchGroup", `Group: string, Patch: {Patch}`, "void" },
			{ "PatchZone", `Zone: string, Patch: {Patch}`, "void" },
			{ "PatchDistance", `Origin: Vector3, Patch: {Patch}, Radius?: number`, "void" },
			{ "PatchScope", `Kind: string, Key: unknown, Patch: {Patch}`, "void" },
			{ "Flush", "ForceFull?: boolean", "void" },
			{ "FlushPlayer", "Player: Player, ForceFull?: boolean", "void" },
			{ "FlushAll", "ForceFull?: boolean", "void" },
			{ "FlushList", "List: Player[], ForceFull?: boolean", "void" },
			{ "FlushGroup", "Group: string, ForceFull?: boolean", "void" },
			{ "FlushZone", "Zone: string, ForceFull?: boolean", "void" },
			{ "FlushDistance", "Origin: Vector3, Radius?: number, ForceFull?: boolean", "void" },
			{ "FlushScope", "Kind: string, Key: unknown, ForceFull?: boolean", "void" },
			{ "Get", "Player?: Player", `{Type} | undefined` },
			{ "Clear", "Player?: Player", "void" },
		}
	end

	for _, Entry in Members do
		StringBuilder.Push(Member(State, Entry[1], Entry[2], Entry[3]), 0, Indent + 1)
	end
	StringBuilder.Push(`\}`, 0, Indent)
end

function Generators.Scope(State: State, Scope: Parser.ScopeNode)
	local Value = Scope.Value
	local Parent = State.Scope
	local Indent = State.Indent

	State.Indent += 1
	State.Scope = Value.Scope

	State.Builder.Push(`{Declare(Indent)}namespace {Scope.Name} \{`, 0, Indent)
	Generators.Tree(State, Value.Values)
	State.Builder.Push(`}`, 0, Indent)

	State.Indent -= 1
	State.Scope = Parent
end

function Generators.Tree(State: State, Tree: { Parser.Declaration })
	for _, Declaration in Tree do
		if Declaration.Type == "Scope" then
			Generators.Scope(State, Declaration :: Parser.ScopeNode)
		elseif Declaration.Type == "Event" then
			Generators.Event(State, Declaration :: Parser.Event)
		elseif Declaration.Type == "Function" then
			Generators.Function(State, Declaration :: Parser.Function)
		elseif Declaration.Type == "Channel" then
			Generators.Channel(State, Declaration :: Parser.Channel)
		else
			if Declaration.Value.Export then
				Generators.Export(State, Declaration :: Type)
			end

			Generators.Type(State, Declaration :: Type)
		end
	end
end

local function Security(Context: Context): string
	local Lines = table.clone(SECURITY_COMMON)
	for _, Line in if Context == "Server" then SECURITY_SERVER else SECURITY_CLIENT do
		table.insert(Lines, Line)
	end
	return `export declare const Security: \{\n\t{table.concat(Lines, "\n\t")}\n\}\n`
end

return function(FileContext: Context, AbstractSyntaxTree: AbstractSyntaxTree): string
	local Options = AbstractSyntaxTree.Value.Options
	local Casing = Settings.GetCasing(Options.Casing or "Pascal" :: any)
	local StringBuilder = Builder.new()

	StringBuilder.Push(VERSION_HEADER)
	if _G.VERSION == nil then
		StringBuilder.Push(TESTING_HEADER)
	end

	StringBuilder.Push(`export declare const {Casing.StepReplication}: () => void`)
	StringBuilder.Push("export interface CheetoFuture<T> { Await(): LuaTuple<[boolean, T]> }")
	StringBuilder.Push(RUNTIME_API)
	StringBuilder.Push(Security(FileContext))

	local State: State = {
		Scope = nil :: any,
		Indent = 0,
		Casing = Casing,
		Context = FileContext,
		Options = Options,
		Builder = StringBuilder,
	}

	Generators.Tree(State, AbstractSyntaxTree.Value.Declarations)

	return table.concat(StringBuilder.DumpLines())
end
